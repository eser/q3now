// password.wui -- q3now Server Password dialog (Phase 5c canonical)
//
// Phase 5 final menu (§7.5 close-out). Specifyserver §7.2 pattern
// reuse — centered popup overlay with header + subheader (the browser's
// canonical selected endpoint, published only for the active preflight) +
// single masked password editfield + Cancel/Connect footer.
//
// Engine wiring: the browser binds this popup to the current typed feeder
// selection. Submit revalidates that selection and queues the same canonical
// JoinServer path; no reconnect state or raw remote command text is trusted.

#include "ui/widgets/qw_button.wui"

menuDef {
	name "password"
	layer "popup"
	fullScreen 1
	visible 1
	style 1

	itemDef {
		name "popup_overlay"
		type container
		direction column
		alignX center
		alignY center
		background "layered" effects "vignette"

		itemDef {
			name "password_root"
			type container
			direction column
			padding $popup_padding
			gap $spacing_md
			background $panel
			border 1px $line_strong
			radius $radius_md
			width PERCENT 0.4
			height FIT

			itemDef { name "header"    type 0 height FIT text "Password Required" textalign 0 font $font_sans_bold 22 forecolor $accent decoration visible 1 grow 0 }
			itemDef { name "subheader" type 0 height FIT textalign 0 font $font_mono 11 forecolor $boneDim cvar "ui_password_server_name" decoration visible 1 grow 0 }
			itemDef { name "auth_error" type 0 height FIT textalign 0 font $font_sans 11 forecolor 0.9 0.3 0.25 1 cvar "ui_joinPasswordError" decoration visible 1 grow 0 }

			itemDef {
				name "form_content"
				type container
				width FIXED 1 height FIXED 0.1
				direction column
				gap $spacing_sm
				height FIT
				padding 0.005 0.01

				itemDef { name "cat_label" type 0 height FIT text "CREDENTIALS" textalign 0 font $font_mono 10 forecolor $boneDim decoration visible 1 grow 0 }
				itemDef { name "row_password" type 4 height FIXED 36px width PERCENT 0.95 text "Password" textalign 0 font $font_sans 13 forecolor $bone forecolor.active $accent cvar "@secure_join_password" maxChars 32 password 1 visible 1 grow 0 }
			}

			itemDef {
				name "popup_footer"
				type container
				width FIXED 1 height FIXED 0.05
				direction row
				gap $spacing_md
				alignX end
				height FIT

				QW_BUTTON("btn_cancel", "Cancel", $boneDim, { cancelserverpassword }, 0.14)
				QW_BUTTON("btn_connect", "Connect", $accent, { joinserverpassword }, 0.18)
			}
		}
	}

	onESC { cancelserverpassword }
}

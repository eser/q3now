// password.wui -- q3now Server Password dialog (Phase 5c canonical)
//
// Phase 5 final menu (§7.5 close-out). Specifyserver §7.2 pattern
// reuse — centered popup overlay with header + subheader (server
// host shown via ui_password_server_name cvar published by the
// engine when a connect attempt receives a "needpass" challenge) +
// single password editfield + Cancel/Connect footer.
//
// Engine wiring: when the server demands a password, cl_main.c
// publishes the server hostname into ui_password_server_name and
// pushes this menu; the Connect button shells out to `reconnect`
// which re-issues the join with the now-populated `password` cvar.

menuDef {
	name "password"
	layer "popup"
	rect 0 0 1 1
	fullScreen 1
	visible 1
	style 1

	itemDef {
		name "popup_overlay"
		position absolute
		rect 0 0 1 1
		type container
		direction column
		alignX center
		alignY center
		background "layered" effects "vignette"

		itemDef {
			name "password_root"
			type container
			rect 0.3 0.35 0.4 0.3
			direction column
			padding $popup_padding
			gap $spacing_md
			background $panel
			border 1px $line_strong
			radius $radius_md
			width PERCENT 0.4
			height FIT

			itemDef { name "header"    type 0 rect 0 0 1 0.06 height FIT text "Password Required" textalign 0 font $font_sans_bold 22 forecolor $accent decoration visible 1 grow 0 }
			itemDef { name "subheader" type 0 rect 0 0 1 0.03 height FIT textalign 0 font $font_mono 11 forecolor $boneDim cvar "ui_password_server_name" decoration visible 1 grow 0 }

			itemDef {
				name "form_content"
				type container
				rect 0 0 1 0.1
				direction column
				gap $spacing_sm
				height FIT
				padding 0.005 0.01

				itemDef { name "cat_label" type 0 rect 0 0 1 0.025 height FIT text "CREDENTIALS" textalign 0 font $font_mono 10 forecolor $boneDim decoration visible 1 grow 0 }
				itemDef { name "row_password" type 4 rect 0.005 0 0.95 0.035 height FIXED 36px width PERCENT 0.95 text "Password" textalign 0 font $font_sans 13 forecolor $bone forecolor.active $accent cvar "password" maxChars 32 visible 1 grow 0 }
			}

			itemDef {
				name "popup_footer"
				type container
				rect 0 0 1 0.05
				direction row
				gap $spacing_md
				alignX end
				height FIT

				itemDef { name "btn_cancel"  type 1 rect 0 0 0.14 0.04 height FIT text "Cancel"  textalign 1 font $font_sans 13       forecolor $boneDim forecolor.active $accent visible 1 grow 0 action { close } }
				itemDef { name "btn_connect" type 1 rect 0 0 0.18 0.04 height FIT text "Connect" textalign 1 font $font_sans_bold 13 forecolor $accent forecolor.active $accent visible 1 grow 0 action { exec "reconnect" ; close } }
			}
		}
	}

	onESC { close }
}

// end_scoreboard_tdm.wui -- q3now End-of-match TDM scoreboard (Phase 6c canonical)
//
// HUD-layer intermission overlay for team deathmatch (also routes
// GT_OBELISK / GT_HARVESTER per the suffix table). Same split-pane
// shape as the Phase 6b ingame variant (§8.2 reuse), with the only
// behavioural difference being engine-side: the widget renderer
// detects `wiredHud->intermission` and overlays match-summary
// info on each team panel.
//
// Wrapper differences from `ingame_scoreboard_tdm`:
//   - alignY center (gameplay paused; not top-anchored)
//   - Optional Disconnect/Continue footer (only interactive surface
//     during intermission)
//   - All other structure identical (split-pane red+blue +
//     scorelist_widget group "red"/"blue" + team labels)

menuDef {
	name "end_scoreboard_tdm"
	layer "hud"
	fullScreen 1
	visible 0
	style 0

	itemDef {
		name "scoreboard_overlay"
		position absolute
		type container
		direction column
		alignX center
		alignY center

		itemDef {
			name "scoreboard_root"
			type container
			rect 0.05 0.05 0.9 0.9
			direction column
			gap $spacing_md
			padding $spacing_md $spacing_md
			width PERCENT 0.9
			height PERCENT 0.9

			itemDef {
				name "team_header"
				type container
				direction row
				gap $spacing_md
				height FIT
				width PERCENT 1.0

				itemDef { name "red_label"  type 0 height FIT width PERCENT 0.5 text "RED TEAM"  textalign 1 font $font_sans_bold 18 forecolor $primary_red  decoration visible 1 grow 1 }
				itemDef { name "blue_label" type 0 height FIT width PERCENT 0.5 text "BLUE TEAM" textalign 1 font $font_sans_bold 18 forecolor $accent decoration visible 1 grow 1 }
			}

			itemDef {
				name "split_pane"
				type container
				rect 0 0 1 0.82
				direction row
				gap $spacing_md
				grow 1
				height GROW
				width PERCENT 1.0

				itemDef {
					name "red_panel"
					type container
					rect 0 0 0.5 1.0
					direction column
					grow 1
					height PERCENT 1.0

					itemDef {
						name "red_scorelist"
						type scorelist_widget
						group "red"
						width PERCENT 1.0
						height PERCENT 1.0
						feeder "players_red_team"
						forecolor $team_red_text
						visible 1
						decoration
					}
				}

				itemDef {
					name "blue_panel"
					type container
					rect 0 0 0.5 1.0
					direction column
					grow 1
					height PERCENT 1.0

					itemDef {
						name "blue_scorelist"
						type scorelist_widget
						group "blue"
						width PERCENT 1.0
						height PERCENT 1.0
						feeder "players_blue_team"
						forecolor $team_blue_text
						visible 1
						decoration
					}
				}
			}

			itemDef {
				name "popup_footer"
				type container
				direction row
				gap $spacing_md
				alignX end
				height FIT
				width PERCENT 1.0

				itemDef { name "btn_disconnect" type 1 rect 0 0 0.18 0.04 height FIT text "Disconnect" textalign 1 font $font_sans 13       forecolor $boneDim forecolor.active $accent visible 1 grow 0 action { exec "disconnect" } }
				itemDef { name "btn_continue"   type 1 rect 0 0 0.18 0.04 height FIT text "Continue"   textalign 1 font $font_sans_bold 13 forecolor $accent  forecolor.active $accent visible 1 grow 0 action { exec "vstr nextmap" } }
			}
		}
	}
}

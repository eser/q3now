// addbots.wui -- q3now Add Bot dialog (Phase 5b canonical)
//
// In-game cluster: reached from the ingame escape menu hierarchy.
// Phase 5b §7.4 pattern — centered popup overlay (not the §6.1
// settings hub, since this menu is invoked from an in-game state
// not the main menu). Shape mirrors specifyserver.wui /
// serverinfo.wui (centered card with header + content + footer).
//
// Deterministic quick-add buttons plus a validated local-server custom form.
// The submit action reads Store/cvar state and revalidates every field; no
// authored value is interpolated through generic exec.

#include "ui/widgets/qw_button.wui"

menuDef {
	name "addbots"
	layer "popup"
	fullScreen 1
	visible 1
	style 1

	itemDef {
		name "popup_overlay"
		type container
		direction column
		alignX center
		alignY center
		background "layered" effects "vignette"

		itemDef {
			name "addbots_root"
			type container
			width FIXED 0.4 height FIXED 0.7
			direction column
			padding $popup_padding
			gap $spacing_md
			background $panel
			border 1px $line_strong
			radius $radius_md
			width PERCENT 0.4
			height PERCENT 0.75

			itemDef { name "header" type 0 height FIT text "Add Bot" textalign 0 font $font_sans_bold 22 forecolor $accent decoration visible 1 grow 0 }
			itemDef { name "subheader" type 0 height FIT text "Spawn a CPU opponent on the active server." textalign 0 font $font_mono 11 forecolor $boneDim decoration visible 1 grow 0 }

			itemDef {
				name "form_content"
				type container
				width FIXED 1 height FIXED 0.6
				direction column
				gap $spacing_sm
				grow 1
				height GROW
				padding 0.005 0.01

				itemDef { name "cat_quick_label" type 0 height FIT text "QUICK ADD" textalign 0 font $font_mono 10 forecolor $boneDim decoration visible 1 grow 0 }

				itemDef {
					name "quick_row_1"
					type container
					width FIXED 1 height FIXED 0.05
					direction row
					gap $spacing_sm
					height FIT
					padding 0.005 0
					QW_BUTTON("btn_quick_visor", "Add Visor", $accent, { addquickbot visor ; close }, 0.3)
					QW_BUTTON("btn_quick_grunt", "Add Grunt", $accent, { addquickbot grunt ; close }, 0.3)
				}

				itemDef { name "cat_custom_label" type 0 height FIT text "CUSTOM ADD" textalign 0 font $font_mono 10 forecolor $boneDim decoration visible 1 grow 0 }
				itemDef { name "row_profile" type 12 height FIXED 38px width PERCENT 1 text "Profile" textalign 0 font $font_sans 13 forecolor $bone cvar "ui_botProfile" populateCallback "bot_profiles" visible 1 grow 0 action { botprofileselected } }
				itemDef { name "row_name" type 4 height FIXED 38px width PERCENT 1 text "Name" textalign 0 font $font_sans 13 forecolor $bone cvar "ui_botName" maxChars 31 visible 1 grow 0 }
				itemDef { name "row_skill" type 12 height FIXED 38px width PERCENT 1 text "Skill" textalign 0 font $font_sans 13 forecolor $bone cvar "g_skill" cvarFloatList { "Beginner" 1 "Casual" 2 "Competitive" 3 "Pro" 4 "Nightmare" 5 } visible 1 grow 0 }
				itemDef { name "row_team" type 12 height FIXED 38px width PERCENT 1 text "Team" textalign 0 font $font_sans 13 forecolor $bone cvar "ui_botTeam" cvarStrList { Free free Red red Blue blue } visible 1 grow 0 }
				QW_BUTTON("btn_add_custom", "Add Custom Bot", $accent, { addcustombot }, 0.35)
			}

			itemDef {
				name "popup_footer"
				type container
				width FIXED 1 height FIXED 0.05
				direction row
				gap $spacing_md
				alignX end
				height FIT

				QW_BUTTON("btn_close", "Close", $boneDim, { close }, 0.12)
			}
		}
	}

	onESC { close }
	onOpen { botprofileinit visor }
}

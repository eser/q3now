// addbots.wui -- q3now Add Bot dialog (Phase 5b canonical)
//
// In-game cluster: reached from the ingame escape menu hierarchy.
// Phase 5b §7.4 pattern — centered popup overlay (not the §6.1
// settings hub, since this menu is invoked from an in-game state
// not the main menu). Shape mirrors specifyserver.wui /
// serverinfo.wui (centered card with header + content + footer).
//
// Deterministic quick-add buttons plus a validated local-server custom form.
// The submit action reads Store/cvar state and revalidates every field; no
// authored value is interpolated through generic exec.

menuDef {
	name "addbots"
	layer "popup"
	rect 0 0 1 1
	fullScreen 1
	visible 1
	style 1

	itemDef {
		name "popup_overlay"
		position absolute
		rect 0 0 1 1
		type container
		direction column
		alignX center
		alignY center
		background "layered" effects "vignette"

		itemDef {
			name "addbots_root"
			type container
			rect 0 0 0.4 0.7
			direction column
			padding $popup_padding
			gap $spacing_md
			background $panel
			border 1px $line_strong
			radius $radius_md
			width PERCENT 0.4
			height PERCENT 0.75

			itemDef { name "header" type 0 rect 0 0 1 0.06 height FIT text "Add Bot" textalign 0 font $font_sans_bold 22 forecolor $accent decoration visible 1 grow 0 }
			itemDef { name "subheader" type 0 rect 0 0 1 0.03 height FIT text "Spawn a CPU opponent on the active server." textalign 0 font $font_mono 11 forecolor $boneDim decoration visible 1 grow 0 }

			itemDef {
				name "form_content"
				type container
				rect 0 0 1 0.6
				direction column
				gap $spacing_sm
				grow 1
				height GROW
				padding 0.005 0.01

				itemDef { name "cat_quick_label" type 0 rect 0 0 1 0.025 height FIT text "QUICK ADD" textalign 0 font $font_mono 10 forecolor $boneDim decoration visible 1 grow 0 }

				itemDef {
					name "quick_row_1"
					type container
					rect 0 0 1 0.05
					direction row
					gap $spacing_sm
					height FIT
					padding 0.005 0
					itemDef { name "btn_quick_visor" type 1 rect 0 0 0.3 0.04 height FIT text "Add Visor" textalign 1 font $font_sans 13 forecolor $accent forecolor.active $accent visible 1 grow 0 action { addquickbot visor ; close } }
					itemDef { name "btn_quick_grunt" type 1 rect 0 0 0.3 0.04 height FIT text "Add Grunt" textalign 1 font $font_sans 13 forecolor $accent forecolor.active $accent visible 1 grow 0 action { addquickbot grunt ; close } }
				}

				itemDef { name "cat_custom_label" type 0 rect 0 0 1 0.025 height FIT text "CUSTOM ADD" textalign 0 font $font_mono 10 forecolor $boneDim decoration visible 1 grow 0 }
				itemDef { name "row_profile" type 12 height FIXED 38px width PERCENT 1 text "Profile" textalign 0 font $font_sans 13 forecolor $bone cvar "ui_botProfile" populateCallback "bot_profiles" visible 1 grow 0 action { botprofileselected } }
				itemDef { name "row_name" type 4 height FIXED 38px width PERCENT 1 text "Name" textalign 0 font $font_sans 13 forecolor $bone cvar "ui_botName" maxChars 31 visible 1 grow 0 }
				itemDef { name "row_skill" type 12 height FIXED 38px width PERCENT 1 text "Skill" textalign 0 font $font_sans 13 forecolor $bone cvar "ui_botSkill" cvarFloatList { "Beginner" 1 "Casual" 2 "Competitive" 3 "Pro" 4 "Nightmare" 5 } visible 1 grow 0 }
				itemDef { name "row_team" type 12 height FIXED 38px width PERCENT 1 text "Team" textalign 0 font $font_sans 13 forecolor $bone cvar "ui_botTeam" cvarStrList { Free free Red red Blue blue } visible 1 grow 0 }
				itemDef { name "btn_add_custom" type 1 rect 0 0 0.35 0.04 height FIT text "Add Custom Bot" textalign 1 font $font_sans 13 forecolor $accent forecolor.active $accent visible 1 grow 0 action { addcustombot } }
			}

			itemDef {
				name "popup_footer"
				type container
				rect 0 0 1 0.05
				direction row
				gap $spacing_md
				alignX end
				height FIT

				itemDef { name "btn_close" type 1 rect 0 0 0.12 0.04 height FIT text "Close" textalign 1 font $font_sans 13 forecolor $boneDim forecolor.active $accent visible 1 grow 0 action { close } }
			}
		}
	}

	onESC { close }
	onOpen { botprofileinit visor }
}

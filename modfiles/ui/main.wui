// main.wui — skinny composition file.
//
// Layout: left hero rail (title bar + QUAKE/WIRED hero + 6-menu +
// footer) at PERCENT 0.55 with the 4-card right rail at PERCENT 0.30
// stacked column-wise; bottom hint strip spans the foot.
//
// All UI fragments live under widgets/ and compose via the botlib
// preprocessor's #include directive (file body inlined at parse time).
// Tokens consumed: $accent, $accentSoft, $bone, $boneDim, $ink, $line,
// $spacing_*, $font_*.

#include "ui/widgets/qw_menu_item.wui"

menuDef {
	name "main"
	// Quake 1's main menu drew straight over whatever the attract demo was
	// doing; this restores that, with a scrim so the menu text stays legible
	// over a moving reel. The backdrop layers stay off so the reel shows
	// through — deep menus turn them on instead.
	backdrop dim
	layer "menu"
	fullScreen 1
	visible 1
	style 1

	itemDef {
		name "main_root"
		type container
		direction column
		background "layered" effects "demo"

		#include "ui/widgets/qw_title_bar.wui"

		// Main content is one horizontal flex row. Its padding encodes the
		// authored viewport gutters; the growing middle spacer keeps the hero
		// and card rail on opposite sides without floating either subtree.
		itemDef {
			name "main_content"
			type container
			direction row
			width PERCENT 1
			align stretch
			grow 1
			padding 3.5vh 3.9vw 2.6vh 5vw

			// -- LEFT region -----------------------------------
			itemDef {
			name "left_region"
			type container
			width 41.7vw
			direction column
			gap $spacing_none
			padding 2.67vh 0 0 0
			grow 0

			itemDef {
				name "hero_quake"
				type 0
				width FIXED 1 height FIXED 14vh
				height FIT
				width PERCENT 1
				text "QUAKE"
				textalign 0
				font $font_sans 132
				forecolor $bone
				decoration
				visible 1
				grow 0
			}
			itemDef {
				name "hero_wired"
				type 0
				width FIXED 1 height FIXED 14vh
				height FIT
				width PERCENT 1
				text "WIRED"
				textalign 0
				font $font_sans 132
				forecolor $accent
				decoration
				visible 1
				grow 0
			}

			itemDef {
				name "action_menu_spacer"
				type container
				width FIXED 1 height FIXED 5.33vh
				height FIT
				grow 0
				decoration
				visible 1
			}

			itemDef {
				name "action_menu"
				type container
				width FIXED 1 height FIXED 48vh
				height FIT
				direction column
				gap $spacing_xxs
				grow 0

				// Subtitle is deliberately not "continue the descent": there is
				// nothing to continue (no campaign-progress struct — see the
				// honesty note at the top of campaign.wui).
				QW_MENU_ITEM("menu_campaign", "campaign", "CAMPAIGN",     "not in this alpha",    { open "campaign" scene })
				QW_MENU_ITEM("menu_join",     "join",     "JOIN BATTLE",  "2,148 live",           { open "servers" scene })
				QW_MENU_ITEM("menu_host",     "host",     "HOST A MATCH", "configure · invite",   { open "startserver" scene })
				QW_MENU_ITEM("menu_demos",    "demos",    "DEMOS",        "watch · replay",        { open "demos" scene })
				QW_MENU_ITEM("menu_options",  "options",  "OPTIONS",      "configure",            { open "sound" scene })
				QW_MENU_ITEM("menu_quit",     "quit",     "QUIT",         "exit to shell",        { exec "quit" })
			}

			itemDef { name "left_spacer" type container grow 1 decoration visible 1 }

			itemDef {
				name "left_footer_row"
				type container
				width FIXED 1 height FIXED 2vh
				height FIT
				width PERCENT 1
				direction row
				padding 0 $spacing_md
				alignY center

				itemDef {
					name "left_footer"
					type 0
					width FIXED 1 height FIXED 2vh
					height FIT
					width PERCENT 1
					text "v0.1.0 · build mmxxvi"
					textalign 0
					font $font_mono 9
					forecolor $boneDim
					decoration
					visible 1
					grow 1
				}
			}
			}

			itemDef { name "main_rail_spacer" type container grow 1 decoration visible 1 }

			// -- RIGHT region: 4-card rail ---------------------
			itemDef {
			name "right_region"
			type container
			width 25vw
			direction column
			gap $spacing_card_gap
			grow 0

			#include "ui/widgets/qw_profile_card.wui"
			#include "ui/widgets/qw_last_match_card.wui"
			#include "ui/widgets/qw_global_feed_card.wui"
			#include "ui/widgets/qw_arena_of_day_card.wui"
			}
		}

		#include "ui/widgets/qw_bottom_hint_bar.wui"

		// Bottom spacer keeps the hint bar off the screen edge.
		itemDef { name "bottom_spacer" type container grow 0 height FIXED 20px decoration visible 1 }
	}

	// Default highlight on menu open — focus the first item (campaign).
	// Selection is now expressed by FOCUS (single source of truth for both
	// keyboard nav and mouse hover), so seed it directly via setfocus instead
	// of the retired ui_currentMenuItem cvar. setfocus resolves the itemDef by
	// name in this menu and calls wui_set_focused → the gold focus-highlight
	// lands on CAMPAIGN, exactly as the old default did.
	onOpen {
		setfocus menu_campaign
	}
}

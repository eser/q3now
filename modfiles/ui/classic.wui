// classic — the in-game HUD.

#include "ui/wmenumacros.h"
//
// Loaded by the `hud` cvar (`hud classic`). This was briefly one of two
// variants; the retired one ("modern") chased the V2 artboard and lost to it in play
// — it put the ammo readout under the weapon-select bar and dropped the ammo
// gauge and icon because the artboard draws neither. Eser compared them live:
// "hud modern sanki hud classic'in yanlis surumu gibi. direkt modern'i
// silebiliriz. classic default'umuz olsun." So it did. Classic remains the
// default; the newer `perspective` theme is an explicit alternative rather
// than a replacement.
menuDef {
	name "classic"
	// The HUD composer is a real full-presentation flex canvas.  The former
	// 1x1 carrier only worked while every leaf escaped to an authored absolute
	// rect; native corner rows need the viewport-sized parent to distribute the
	// top/bottom and left/right regions correctly.
	width PERCENT 1 height PERCENT 1
	fullScreen 0
	visible 1
	layer "hud"
	// Draw the HUD in display/sRGB space (after the gamma pass) so panel
	// translucency reads light-independently — legible over both bright and
	// dark scenes, while still feeling part of the player's heads-up view.
	composite overlay


	// ── 4-corner HUD grid ─────────────────────────────────────────────
	// HUD elements do not flow past one another: health sits bottom-left,
	// the kill feed top-right. Expressing that as nested rows/columns with
	// a growing spacer between them gives the same placement without each
	// widget pinning itself to the viewport. Only CORNER widgets live here —
	// the full-screen scoreboard overlay, the full-width hint bar and the
	// coordinate-free elements (crosshair, objectives, subtitle) keep their
	// own paths, because they are not corner-anchored.
	itemDef {
		name "hud_corner_grid"
		type container
		direction column
		width PERCENT 1
		height PERCENT 1
		grow 0
		padding 2vh 1.67vw 4vh 1.94vw

		itemDef { name "hud_row_top" type container direction row width PERCENT 1 height 32vh grow 0
			itemDef { name "hud_top_left" type container direction column height PERCENT 1 grow 1
				#include "ui/widgets/qw_hud_overlay_messages.wui"
				#include "ui/widgets/qw_hud_objectives.wui"
			}
			itemDef { name "hud_top_center" type container direction column width 33.33vw height PERCENT 1 alignX center grow 0
				#include "ui/widgets/qw_hud_scoreboard_bar.wui"
				itemDef { name "hud_top_center_gap" type container height 6vh grow 0 }
				#include "ui/widgets/qw_hud_msgqueue.wui"
				#include "ui/widgets/qw_hud_rewards.wui"
				#include "ui/widgets/qw_hud_warmup.wui"
			}
			itemDef { name "hud_top_right" type container direction column height PERCENT 1 gap $spacing_sm grow 1 alignX end
				#include "ui/widgets/qw_hud_telemetry.wui"
				#include "ui/widgets/qw_hud_kill_feed.wui"
			}
		}

		itemDef { name "hud_mid_spacer" type container direction row width PERCENT 1 grow 1 alignY center
			itemDef { name "hud_mid_left" type container grow 1 }
			#include "ui/widgets/qw_hud_crosshair.wui"
			itemDef { name "hud_mid_right" type container direction column height PERCENT 1 padding 2vh 0 0 0 gap 1.2vh grow 1 alignX end
				#include "ui/widgets/qw_hud_powerups.wui"
				#include "ui/widgets/qw_hud_holdables_strip.wui"
			}
		}

		itemDef { name "hud_row_bottom" type container direction row width PERCENT 1 height 25vh grow 0
			itemDef { name "hud_bottom_left" type container direction row height PERCENT 1 gap 1.25vw grow 0 alignY end
				#include "ui/widgets/qw_hud_health_panel.wui"
				#include "ui/widgets/qw_hud_armor_panel.wui"
			}
			// The carousel is a flex-sized leaf. Keep it inside a real centre
			// column so its resolved rect survives the absolute-to-flex HUD
			// migration while remaining independent of the status-card layout.
			itemDef { name "hud_bottom_center" type container direction column height PERCENT 1 padding 7vh 0 0 0 grow 1 alignX center
				#include "ui/widgets/qw_hud_weapon_carousel.wui"
			}
			itemDef { name "hud_bottom_right" type container direction column height PERCENT 1 gap $spacing_sm grow 0 alignX end justify end
				#include "ui/widgets/qw_hud_ammo_readout.wui"
			}
		}
	}

	// HUD redesign (Eser, minimalist): the weapon-viewmodel PLACEHOLDER box is
	// removed. The real 3D viewmodel already renders in that region; the empty
	// dark panel only added clutter and ate field-of-view. Bottom-right is now
	// free for the ammo readout (moved there — weapon-hand side).
	// Scoreboard occlusion fix (chain 6.x S1): qw_hud_scoreboard_overlay was
	// always-on (an itemDef nested in this always-visible hud_active menu), so
	// its scorelist_widget covered screen-centre during normal play. The
	// showScores gate is an ENGINE-side menu-level flip keyed by menu NAME
	// (cl_wired_ui_hud_state.c:561-610 toggles menu->visible on the standalone
	// ingame_scoreboard_{ffa,duel,tdm,ctf} / end_scoreboard_* menus). A nested
	// itemDef cannot receive that flip. The standalone ingame_scoreboard_*
	// menus (loaded in scripts/menus.lua:80-87) ALREADY render the same
	// scorelist_widget + feeder "scoreboard" and are already shown ONLY on
	// +scores / TAB-hold. So this always-on duplicate is removed — the
	// engine-gated ingame_scoreboard_* is now the sole scoreboard, shown only
	// when wiredHud->showScores (the canonical gate, mirrored by deferring to
	// the widget that already has it).
	// #include "ui/widgets/qw_hud_scoreboard_overlay.wui"
	// HUD redesign (Eser) Phase C — feedback + status layers:
	// HUD redesign (Eser) Phase D — status: medals + relocated holdables:
	// HUD redesign (Eser) Phase E — overlay (CTF-less scope): vote/follow/spec + warmup countdown
	#include "ui/widgets/qw_hud_markers.wui"
	#include "ui/widgets/qw_hud_subtitle.wui"    // localized cinematic subtitle (survives HUD-suppress)
}

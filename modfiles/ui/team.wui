// team.wui -- q3now Team Selection dialog (Phase 5d canonical)
//
// In-game popup (§7.4 cluster shape). Centered overlay mirroring
// addbots / callvote — header + button stack + Cancel footer.
// Reached from the in-game ESC menu's team-change action OR
// callvote → team mid-match.

menuDef {
	name "team"
	layer "popup"
	rect 0 0 1 1
	fullScreen 1
	visible 1
	style 1

	itemDef {
		name "popup_overlay"
		position absolute
		rect 0 0 1 1
		type container
		direction column
		alignX center
		alignY center
		background "layered" effects "vignette"

		itemDef {
			name "team_root"
			type container
			rect 0 0 0.3 0.5
			direction column
			padding $popup_padding
			gap $spacing_md
			background $panel
			border 1px $line_strong
			radius $radius_md
			width PERCENT 0.3
			height PERCENT 0.5

			itemDef { name "header"    type 0 rect 0 0 1 0.06 height FIT text "Join Team" textalign 0 font $font_sans_bold 22 forecolor $accent decoration visible 1 grow 0 }
			itemDef { name "subheader" type 0 rect 0 0 1 0.03 height FIT text "Pick a side or auto-balance into the match." textalign 0 font $font_mono 11 forecolor $boneDim decoration visible 1 grow 0 }

			itemDef {
				name "form_content"
				type container
				rect 0 0 1 0.3
				direction column
				gap $spacing_sm
				grow 1
				height GROW
				padding 0.005 0.01

				itemDef { name "btn_red"       type 1 rect 0.005 0 0.95 0.04 height FIXED 36px width PERCENT 0.95 text "Red Team"  textalign 0 font $font_sans 13 forecolor $primary_red    forecolor.active $accent visible 1 grow 0 action { exec "cmd team red" ; close } }
				itemDef { name "btn_blue"      type 1 rect 0.005 0 0.95 0.04 height FIXED 36px width PERCENT 0.95 text "Blue Team" textalign 0 font $font_sans 13 forecolor $accent         forecolor.active $accent visible 1 grow 0 action { exec "cmd team blue" ; close } }
				itemDef { name "btn_auto"      type 1 rect 0.005 0 0.95 0.04 height FIXED 36px width PERCENT 0.95 text "Auto Join" textalign 0 font $font_sans 13 forecolor $bone           forecolor.active $accent visible 1 grow 0 action { exec "cmd team auto" ; close } }
				itemDef { name "btn_spectator" type 1 rect 0.005 0 0.95 0.04 height FIXED 36px width PERCENT 0.95 text "Spectator" textalign 0 font $font_sans 13 forecolor $boneDim        forecolor.active $accent visible 1 grow 0 action { exec "cmd team spectator" ; close } }
				itemDef { name "btn_cancel"    type 1 rect 0.005 0 0.95 0.04 height FIXED 36px width PERCENT 0.95 text "Cancel"    textalign 0 font $font_sans 13 forecolor $boneDim        forecolor.active $accent visible 1 grow 0 action { close } }
			}
		}
	}

	onESC { close }
}

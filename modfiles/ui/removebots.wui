// removebots.wui -- q3now Remove Bot dialog (Phase 5b canonical)
//
// In-game cluster popup (§7.4). Centered overlay mirroring
// serverinfo.wui (§7.3) shape: header + subheader + ListBox body
// over the bot-only feeder
// + footer with Kick / Close.
//
// Engine note: kick action shells out to the `clientkick` console
// command — uiScript Kick on legacy CNQ3 reads listSelectedRow
// from the PLAYER_LIST feeder and dispatches clientkick <id>.

#include "ui/widgets/qw_button.wui"

menuDef {
	name "removebots"
	layer "popup"
	fullScreen 1
	visible 1
	style 1

	itemDef {
		name "popup_overlay"
		type container
		direction column
		alignX center
		alignY center
		background "layered" effects "vignette"

		itemDef {
			name "removebots_root"
			type container
			width FIXED 0.4 height FIXED 0.6
			direction column
			padding $popup_padding
			gap $spacing_md
			background $panel
			border 1px $line_strong
			radius $radius_md
			width PERCENT 0.4
			height PERCENT 0.6

			itemDef { name "header" type 0 height FIT text "Remove Bot" textalign 0 font $font_sans_bold 22 forecolor $accent decoration visible 1 grow 0 }
			itemDef { name "subheader" type 0 height FIT text "Select a connected bot and remove it from the server." textalign 0 font $font_mono 11 forecolor $boneDim decoration visible 1 grow 0 }

			// ── ListBox view of the bot-only feeder.
			// Single-column row of connected-bot names; double-
			// click kicks via uiScript Kick.
			itemDef {
				name "botlist"
				type 6
				width FIXED 1 height FIXED 0.6
				width PERCENT 1.0
				height GROW
				font $font_sans 12
				forecolor $bone
				backcolor $panelDeep
				style 1
				feeder "bots"
				elementheight 22
				columns 1 0 460 32
				visible 1
				doubleclick { uiScript Kick }
			}

			itemDef {
				name "popup_footer"
				type container
				width FIXED 1 height FIXED 0.05
				direction row
				gap $spacing_md
				alignX end
				height FIT

				QW_BUTTON("btn_kick_bot", "Remove Selected", $accent, { uiScript Kick }, 0.18)
				QW_BUTTON("btn_close", "Close", $boneDim, { close }, 0.12)
			}
		}
	}

	onOpen { clearbotselection }
	onESC { close }
}

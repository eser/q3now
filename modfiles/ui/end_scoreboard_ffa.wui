// end_scoreboard_ffa.wui -- q3now End-of-match FFA scoreboard (Phase 6c canonical)
//
// HUD-layer overlay shown at intermission (post-match) for free-for-
// all gametypes. The engine HUD state machine
// (cl_wired_ui_hud_state.c) routes `end_scoreboard_<suffix>` when
// `wiredHud->intermission == true` (vs `ingame_scoreboard_<suffix>`
// during the active match).
//
// Layout (§8.3 canonical): centered-overlay flexbox shell (alignY
// center, not top-anchored) holding a single scorelist_widget that
// fills the body. The widget itself
// (cl_wired_ui_hud_scoreboard.c::WiredHud_DrawScorelistWidget)
// checks `wiredHud->intermission` and adds an animated winner
// banner + match duration above the player list. The wrapper adds
// a declarative footer with Disconnect + Continue actions — the
// only interactive surface at intermission.

menuDef {
	name "end_scoreboard_ffa"
	layer "hud"
	fullScreen 1
	visible 0
	style 0

	itemDef {
		name "scoreboard_overlay"
		position absolute
		type container
		direction column
		alignX center
		alignY center

		itemDef {
			name "scoreboard_root"
			type container
			rect 0.1 0.05 0.8 0.9
			direction column
			gap $spacing_md
			padding $spacing_md $spacing_md
			width PERCENT 0.8
			height PERCENT 0.9

			itemDef {
				name "scorelist"
				type scorelist_widget
				rect 0 0 1 0.92
				width PERCENT 1.0
				height GROW
				feeder "scoreboard"
				forecolor $bone
				visible 1
				decoration
				grow 1
			}

			itemDef {
				name "popup_footer"
				type container
				direction row
				gap $spacing_md
				alignX end
				height FIT
				width PERCENT 1.0

				itemDef { name "btn_disconnect" type 1 rect 0 0 0.18 0.04 height FIT text "Disconnect" textalign 1 font $font_sans 13       forecolor $boneDim forecolor.active $accent visible 1 grow 0 action { exec "disconnect" } }
				itemDef { name "btn_continue"   type 1 rect 0 0 0.18 0.04 height FIT text "Continue"   textalign 1 font $font_sans_bold 13 forecolor $accent  forecolor.active $accent visible 1 grow 0 action { exec "vstr nextmap" } }
			}
		}
	}
}

// confirm.wui -- q3now Generic Confirmation dialog (Phase 5d canonical)
//
// Centered popup (§7.2 pattern). Callers populate ui_confirmText
// (message body) and ui_confirmAction (script to run on Yes), then
// open this menu via { open "confirm_popup" }. Yes triggers
// execConfirm (reads ui_confirmAction state key). ESC = No.

#include "ui/widgets/qw_button.wui"

menuDef {
	name "confirm_popup"
	layer "popup"
	fullScreen 1
	visible 1
	style 1
	modal

	itemDef {
		name "popup_overlay"
		type container
		direction column
		alignX center
		alignY center
		background "layered" effects "vignette"

		itemDef {
			name "confirm_root"
			type container
			rect 0 0 0.3 0.2
			direction column
			padding $popup_padding
			gap $spacing_md
			background $panel
			border 1px $line_strong
			radius $radius_md
			width PERCENT 0.3
			height FIT

			itemDef { name "header"  type 0 height FIT text "Confirm"             textalign 0 font $font_sans_bold 20 forecolor $accent decoration visible 1 grow 0 }
			itemDef { name "message" type 0 height FIT textalign 0 font $font_sans 14 forecolor $bone cvar "ui_confirmText" decoration visible 1 grow 0 }

			itemDef {
				name "popup_footer"
				type container
				rect 0 0 1 0.05
				direction row
				gap $spacing_md
				alignX end
				height FIT

				QW_BUTTON("btn_no", "No", $boneDim, { close }, 0.12)
				QW_BUTTON("btn_yes", "Yes", $accent, { execConfirm ; close }, 0.12)
			}
		}
	}

	onESC { close }
}

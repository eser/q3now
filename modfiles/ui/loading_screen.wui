// loading_screen.wui — compositor-owned, rect-free loading presentation.
//
// Geometry is one flex tree: top bar, two-column body and footer. Dynamic
// regions remain stateless custom draws, but every helper receives its actual
// Clay box rather than a duplicate viewport-coordinate table.

menuDef {
	name "loading_screen"
	width PERCENT 1
	height PERCENT 1
	fullScreen 1
	visible 1
	style 1
	backcolor 0.04 0.06 0.10 0
	layer "loading"

	itemDef {
		name "loading_root"
		type container
		direction column
		width PERCENT 1
		height PERCENT 1
		decoration
		visible 1
		custom "loading_backdrop"

		itemDef {
			name "loading_topbar"
			width PERCENT 1
			height 5.8vh
			grow 0
			decoration
			visible 1
			custom "loading_topbar"
		}

		itemDef {
			name "loading_body"
			type container
			direction row
			width PERCENT 1
			grow 1
			decoration
			visible 1

			itemDef {
				name "loading_left_panel"
				type container
				direction column
				width 51.9vw
				height PERCENT 1
				grow 0
				padding 1.7vh 0 1vh 0
				decoration
				visible 1

				itemDef {
					name "loading_wireframe"
					width PERCENT 1
					grow 1
					decoration
					visible 1
					custom "loading_wireframe"
				}
			}

			itemDef {
				name "loading_divider"
				type container
				direction column
				width 0.3vw
				height PERCENT 1
				grow 0
				padding 1.7vh 0 6vh 0
				alignX center
				decoration
				visible 1
				itemDef { name "loading_divider_top" width 1px height 35vh grow 0 backcolor $loading_divider decoration visible 1 }
				itemDef { name "loading_divider_accent" width PERCENT 1 height 15vh grow 0 backcolor $loading_divider_hi decoration visible 1 }
				itemDef { name "loading_divider_bottom" width 1px grow 1 backcolor $loading_divider decoration visible 1 }
			}

			itemDef {
				name "loading_right_panel"
				type container
				direction column
				height PERCENT 1
				grow 1
				padding 4.2vh 2.2vw 0 2vw
				decoration
				visible 1

				itemDef { name "loading_maptitle_block" width PERCENT 1 height 19.58vh grow 0 decoration visible 1 custom "loading_maptitle_block" }
				itemDef { name "loading_mapinfo_stats" width PERCENT 1 height 10vh grow 0 decoration visible 1 custom "loading_mapinfo_stats" }
				itemDef { name "loading_right_gap" type container width PERCENT 1 height 5.42vh grow 0 decoration }
				itemDef { name "loading_streaming_rows" width PERCENT 1 height 18vh grow 0 decoration visible 1 custom "loading_streaming_rows" }
				itemDef { name "loading_server_info_strip" width PERCENT 1 height 11vh grow 0 decoration visible 1 custom "loading_server_info_strip" }
				itemDef {
					name "loading_phase_text"
					width PERCENT 1
					height 2.5vh
					grow 0
					font $font_sans 14
					forecolor $boneDim
					text ""
					bind "loading.phase"
					decoration
					visible 1
				}
				itemDef {
					name "loading_overall_bar"
					type container
					direction row
					width PERCENT 1
					height 0.4vh
					grow 0
					backcolor $loading_bar_track
					decoration
					visible 1
					itemDef { name "loading_overall_bar_fill" width PERCENT 1 height PERCENT 1 grow 0 backcolor $loading_bar_fill bindwidth "loading.overall" decoration visible 1 }
				}
				itemDef { name "loading_vulkan_badge" width PERCENT 1 height 2vh grow 0 decoration visible 1 custom "loading_vulkan_badge" }
			}
		}

		itemDef {
			name "loading_bottom_strip"
			type container
			direction column
			width PERCENT 1
			height 4vh
			grow 0
			justify center
			decoration
			visible 1
			itemDef {
				name "loading_server_strip_label"
				width PERCENT 1
				height 2vh
				textalign 1
				font $font_sans 10
				forecolor $boneDim
				text "loading..."
				decoration
				visible 1
			}
		}
	}
}

// connect.wmenu - Wired UI connection progress
// Flex column layout -- vertical positioning handled by the layout engine.

#include "ui/wmenumacros.h"

menuDef {
	name "connect"
	fullScreen 1
	width FIXED 1 height FIXED 1
	style 1
	// Transparent menu fill: connect is a progress OVERLAY on the "loading"
	// layer, composited on top of loading_screen.wui's fullScreen backdrop
	// (grid + glow + divider). An opaque backcolor here would fully occlude
	// that backdrop (both menus are fullScreen on the same layer and connect
	// registers later → emits on top). Alpha 0 → the compositor's
	// color[3]<=0 gate drops the panel fill, so only connect's text/button
	// items draw, over the visible backdrop. The flex-column layout
	// (fullScreen + width FIXED 1 height FIXED 1) is retained so the progress text stays
	// centered; only the opaque fill is removed.
	backcolor 0 0 0 0
	layer "loading"
	layout column
	alignX center
	padding 0.05
	gap 0.01

	// spacer to push content toward center
	itemDef {
		type 0
		width FIXED 1.0 height FIXED 0
		decoration
		visible 1
		grow 1
	}

	// "Connecting..." — hidden when com_errorMessage is set (CD1 fix:
	// prevents two contradictory status lines when the error_popup.wmenu
	// modal floats on top of this screen).
	itemDef {
		type 0
		text "Connecting..."
		width FIXED 1.0 height FIXED 0.050
		textalign 1
		font $font_sans 24
		forecolor $bone
		decoration
		visible 1
		grow 0
		cvarTest "com_errorMessage"
		showCvar { "" }
	}

	// dimmed "Please wait" label — also hidden when error is set
	itemDef {
		type 0
		text "Please wait"
		width FIXED 1.0 height FIXED 0.033
		textalign 1
		font $font_sans 17
		forecolor $boneDim
		decoration
		visible 1
		grow 0
		cvarTest "com_errorMessage"
		showCvar { "" }
	}

	itemDef {
		type 1
		text "Cancel"
		width FIXED 1.0 height FIXED 0.050
		textalign 1
		font $font_sans_bold 19
		forecolor $accent
		forecolor.active $accent
		visible 1
		grow 0
		action { exec "disconnect" }
	}

	// Dynamic connection detail is a regular lower-centre flex stack. The
	// writer publishes these keys per frame; no viewport coordinate exception
	// is needed for text that naturally belongs below the primary status.
	itemDef {
		name "connect_details"
		type container
		direction column
		width PERCENT 0.5
		height FIT
		gap 0
		grow 0

		itemDef { name "connect_info"   type 0 width PERCENT 1 height FIXED 0.0333 font $font_sans 8 forecolor $bone                text "" bind "connect.servername" decoration visible 1 grow 0 }
		itemDef { name "connect_status" type 0 width PERCENT 1 height FIXED 0.0333 font $font_sans 8 forecolor $boneDim             text "" bind "connect.state"      decoration visible 1 grow 0 }
		itemDef { name "connect_error"  type 0 width PERCENT 1 height FIXED 0.0333 font $font_sans 8 forecolor 1 0.45 0.35 1       text "" bind "connect.error"      decoration visible 1 grow 0 }
		itemDef { name "connect_motd"   type 0 width PERCENT 1 height FIXED 0.0333 font $font_sans 8 forecolor $boneDim             text "" bind "connect.motd"       decoration visible 1 grow 0 }
	}

	// spacer balances the leading grow item and keeps the status stack centred
	itemDef { type 0 width PERCENT 1 height FIT decoration visible 1 grow 1 }
}

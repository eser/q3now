// qw_hud_rewards — V2_HUD_Active reward / medal feed (Excellent / Impressive / etc.)
// HUD redesign (Eser) Phase D — status layer: frag-time medals. The engine
// (cl_wired_hud_elem_reward.c) pops one reward off cg.rewardStack at a time and
// fades it; rewardicons draws cg.rewardShader[0], rewardnumbers draws the count
// ("×N") via the config text format. No bind needed — both read cg.reward* live.
// Placement TOP_CENTER y0.22, just below the msgqueue (y0.158) — the classic Q3
// medal lane, eye-centre so a frag's medal lands where attention already is.
// hudElement rects are FULL-VIEWPORT. The count sits just under the icon.
itemDef {
	name "hud_active_rewards_root"
	type container
	direction column
	width PERCENT 1
	height 10vh
	alignX center
	decoration
	visible 1

	// medal icon — centred, ~5% tall square
	itemDef { name "hud_reward_icon" hudElement "rewardicons"
		width 4.5vw
		height 6vh
		forecolor 1 1 1 1
		decoration
		visible 1
	}
	// "×N" count under the icon — amber, small sans. config.text format string
	// is the va() template the engine fills with cg.rewardCount[0].
	itemDef { name "hud_reward_count" hudElement "rewardnumbers"
		width PERCENT 1
		height 2.5vh
		font $font_sans
		fontsize 14 18
		textalign 1
		text "x%i"
		forecolor $accent
		decoration
		visible 1
	}
}

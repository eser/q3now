// qw_arena_of_day_card — right-rail featured arena card widget
// Interface (consumer): #include into the right_rail container body.
// Tokens: $accent, $accentDim, $bone, $boneDim, $panelDeep, $line,
//         $font_icon, $font_mono, $font_sans,
//         $spacing_sm, $spacing_xs, $spacing_xxs
// Store binds (placeholder until cgame stages): arena_of_day.title,
//   arena_of_day.desc, arena_of_day.mode, arena_of_day.thumb.
// Composition: header row (◆ ARENA OF THE DAY + mode label) +
//   thumbnail tile (levelshots/q3dm0 fallback) + arena title + desc.
itemDef {
	name "card_arena"
	type container
	width FIXED 1 height FIXED 22vh
	height FIT
	direction column
	padding $spacing_card_padding_v $spacing_card_padding_h
	gap $spacing_xs
	background $panelDeep
	border 1px $line

	// Header row
	itemDef {
		name "card_arena_header"
		type container
		width FIXED 1 height FIXED 2vh
		height FIT
		direction row
		alignY center
		gap 0.006

		itemDef { type 0 width FIXED 1.2vw height FIXED 2vh height FIT width PERCENT 1.2vw iconText "diamond" textalign 1 font $font_icon 10 forecolor $accent decoration visible 1 grow 0 }
		itemDef { type 0 width FIXED 18vw height FIXED 2vh height FIT width PERCENT 18vw text "ARENA OF THE DAY" textalign 0 font $font_mono 10 forecolor $accent  decoration visible 1 grow 0 }
		itemDef { type container grow 1 decoration visible 1 }
		itemDef { type 0 width FIXED 6vw height FIXED 2vh height FIT width PERCENT 6vw text "DM · 2-8" textalign 2 font $font_mono 9 forecolor $boneDim decoration visible 1 grow 0 }
	}

	// Thumbnail tile — uses background shader if a levelshot is present
	// in the store/asset chain, otherwise the bordered backcolor + label
	// give the slot visible chrome instead of an empty gap.
	itemDef {
		name "card_arena_thumb"
		type container
		width FIXED 1 height FIXED 10vh
		height FIXED 88px
		width PERCENT 1
		background "levelshots/q3dm0"
		backcolor $panel
		bordercolor $accentDim
		bordersize 2
		decoration
		visible 1

		itemDef { type 0 height FIT width PERCENT 1 text "▌ ▌ ▌▌  ▌  ▌▌▌" textalign 1 font $font_mono 14 forecolor $accentDim decoration visible 1 grow 0 }
	}

	// Title + description
	itemDef { type 0 height FIT width PERCENT 1 text "CAMPGROUNDS" textalign 0 font $font_sans 16 forecolor $bone decoration visible 1 grow 0 }
	itemDef { type 0 height FIT width PERCENT 1 text "vertical geometry · central atrium · brutal sightlines" textalign 0 font $font_mono 9 forecolor $boneDim decoration visible 1 grow 0 }
}

// qw_hud_crosshair — V2_HUD_Active center crosshair
// Interface: #include once into the HUD composer menuDef body.
// Source: docs/wui-claude-design-canonical-v2/project/qw-screens.jsx:1097-1106
//   (viewport-center crosshair: circle dot + 4 ticks).
// ABI: the existing `crosshair` hudElement dispatches the engine's
//   cl_crosshair* render at the leaf's screen-center rect (mirrors
//   default.wui hud_crosshair_root). Engine 0 LoC.
//
// The procedural routine owns viewport-centre placement. Keep only its 1px
// custom-draw carrier here: the compositor floats custom carriers, so it emits
// without consuming the middle row. A former full-width wrapper consumed 100%
// of that row between two growing columns and pushed the right HUD column past
// the presentation edge after HiDPI/backend restart.
itemDef {
	name "hud_active_crosshair"
	hudElement "crosshair"
	width FIXED 1px
	height FIXED 1px
	grow 0
	decoration
	visible 1
}

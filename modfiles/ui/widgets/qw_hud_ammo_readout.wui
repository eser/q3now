// qw_hud_ammo_readout — bottom-right ammo block: label, value, gauge, icon.
//
// Interface: #include once into the classic composer menuDef body.
//
// Mirrors the health/armor pair on the left: right-aligned (textalign 2), the
// gauge filling right-to-left (direction L), panel chrome and accent edge to
// match. Sits clear of the weapon-select bar at bottom-centre.
//
// A 2026-08-16 revision moved this to bottom-CENTRE and dropped the gauge and
// icon, on the grounds that the V2 artboard draws neither there. Playing it
// showed both to be regressions: the readout collided with the weapon bar, and
// the gauge is how remaining ammo reads without parsing digits. Reverted; that
// variant is gone.
itemDef {
	name "hud_ammo_readout"
	type container
	width 11.5vw
	height 11.56vh
	direction column
	padding 0.7vh 1.1vw
	alignX end
	background $hud_panel_bg60
	borderRight 3px $accent

	// D3 fix (2026-06-30): caption now binds the SHORT uppercase weapon tag
	// (player.weapon.shortname, e.g. "RL") — the full .name ("Rocket Launcher")
	// overran this compact panel. Uses explicit width PERCENT (NOT width FIT) to
	// match the proven bound-text pattern in qw_hud_scoreboard_bar / qw_hud_kill_feed
	// (a FIT-width bound text node mis-measured → garbled glyphs).
	itemDef { type 0 rect 0 0 6vw 2.2vh height FIT width PERCENT 6vw bind "player.weapon.shortname" text "WPN" textalign 2 font $font_mono 11 forecolor $boneDim decoration visible 1 grow 0 }

	// HUD redesign (Eser, 2026-06-30): VALUE on the LEFT (right-aligned) with the BAR
	// stacked UNDER it, ICON on the RIGHT — (value / bar) [icon]. The icon draws in its
	// NATURAL color (no forecolor tint — this is why the red RL icon no longer greys
	// out). value/bar keep the amber forecolor. digit right-edge 0.934, icon 0.944–0.962
	// (≈10px gap, no collision even for '999'); bar 0.882–0.934 under the digit (clear of
	// the icon). The bar binds player.ammo.percent (= ammo/200, ∞-weapons → full).
	itemDef { hudElement "statusbar_value" bind "ammo" anchor BOTTOM_RIGHT rect 0.934 0.885 0 0 font $font_sans fontsize 40 46 textalign 2 forecolor $accent decoration visible 1 }
	itemDef { hudElement "statusbar_bar"   bind "ammo" anchor BOTTOM_RIGHT rect 0.882 0.925 0.052 0.004 direction L forecolor $accent decoration visible 1 }
	itemDef { hudElement "statusbar_icon"  bind "ammo" anchor BOTTOM_RIGHT rect 0.944 0.892 0.018 0.030 decoration visible 1 }
}

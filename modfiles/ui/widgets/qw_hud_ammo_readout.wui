// qw_hud_ammo_readout — bottom-right ammo card.
// Placement and dimensions remain authored by the classic HUD.  Chrome comes
// from WHUD_CARD_CHROME; every child is local to this card's flex box.
itemDef {
	name "hud_ammo_readout"
	type container
	width 11.5vw
	height 11.56vh
	direction column
	padding 0.7vh 1.1vw
	gap 0.3vh
	alignX end
	WHUD_CARD_CHROME

	itemDef {
		name "hud_ammo_caption"
		type 0 width PERCENT 1 height FIT
		bind "player.weapon.shortname" text "WPN"
		textalign 2 font $font_mono 11 forecolor $boneDim
		decoration visible 1 grow 0
	}

	itemDef {
		name "hud_ammo_content"
		type container direction row
		width PERCENT 1 height 5.1vh
		alignX end alignY center gap 0.6vw grow 1

		itemDef {
			name "hud_ammo_value_slot"
			type container direction column
			width 6.2vw height 5.1vh
			padding 0 0 20px 0 grow 0

			itemDef {
				name "hud_ammo_value"
				hudElement "statusbar_value" bind "ammo"
				width PERCENT 1 grow 1
				font $font_sans fontsize 38 44
				textalign 2 forecolor $accent
				decoration visible 1
			}
		}
		itemDef {
			name "hud_ammo_icon_slot"
			type container direction column
			width 2.6vh height PERCENT 1
			padding 1.4vh 0 0 0 justify center grow 0

			itemDef {
				name "hud_ammo_icon"
				hudElement "statusbar_icon" bind "ammo"
				width 2.6vh height 2.6vh
				decoration visible 1 grow 0
			}
		}
	}

	itemDef {
		name "hud_ammo_bar_slot"
		type container direction column
		width PERCENT 1 height 1.9vh
		padding 0 0 20px 0 grow 0

		itemDef {
			name "hud_ammo_bar"
			hudElement "statusbar_bar" bind "ammo"
			width PERCENT 1 height 0.5vh
			direction L forecolor $accent
			decoration visible 1 grow 0
		}
	}
}

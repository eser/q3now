// qw_hud_msgqueue — V2_HUD_Active centerprint / pickup / frag / "FIGHT!" feed
// HUD redesign (Eser): the unified message queue — pickup ("You got the X"),
// centerprint, frag notices, warmup "FIGHT!". The engine (cl_wired_hud_elem_
// msgqueue.c) shows one entry at a time with fade in/out, priority
// frags > centerprints > warmup. Placed TOP-CENTER (just above the crosshair),
// the classic centerprint position — out of the gun's line, where the eye
// already is mid-fight. $bone text, sans 28pt.
// Ported from default.wui:446-461. The container is an addressable wrapper;
// the hudElement rect is FULL-VIEWPORT.
itemDef {
	name "hud_active_msgqueue_root"
	type container
	direction column
	decoration
	visible 1

	itemDef { hudElement "msgqueue"
		anchor TOP_CENTER
		rect 0.500 0.158 0 0
		font $font_sans
		fontsize 22 28
		textalign 1
		forecolor $bone
	}
}

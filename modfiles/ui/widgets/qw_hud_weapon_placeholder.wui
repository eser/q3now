// qw_hud_weapon_placeholder — V2_HUD_Active bottom-right weapon-model panel
// Interface: #include once into the modern composer menuDef body.
// Source: docs/wui-claude-design-canonical-v2/project/qw-screens.jsx:1086-1095
//   (right:120 bottom:60, 340x240; dark gradient panel + scanlines + label).
//
// Static styled panel (0 engine LoC; no dynamic binding). In the mockup this
// box stands in for the weapon viewmodel; in-engine the real 3D viewmodel
// already renders here, so this panel + the live model coexist — the proper
// long-term form is a `type viewport` itemDef rendering the model into this
// box (deferred). rotate(-4deg) from the mockup is not a parser primitive
// (dispatch 5.20 watchpoint) → rendered axis-aligned.
// Tokens: $hud_panel_bg $line $boneDim $font_mono.
itemDef {
	name "hud_active_weapon_placeholder"
	type container
	position absolute
	right 8.33vw
	bottom 6.67vh
	width 23.61vw
	height 26.67vh
	direction column
	alignY end
	background $hud_panel_bg
	border 1px $line

	itemDef { type 0 rect 0 0 1 1.4vh height FIT width PERCENT 1 text "v_weapon · rocketlauncher.md3" textalign 0 font $font_mono 8 forecolor $boneDim decoration visible 1 grow 0 }
}

// qw_hud_armor_panel — V2_HUD_Active bottom-left ARMOR panel (right of HEALTH)
// Interface: #include once into the qw_hud_active composer menuDef body.
//
// HUD redesign (Eser, 2026-06-30): mirrors the health panel. Caption RESTORED
// ("ARMOR") as a flex-flow text node at the panel top; value/icon/bar are
// FULL-VIEWPORT leaves pulled UP to y0.88 so they sit right under the caption
// (gap reduced, caption visible — the original ask was "shrink the gap + make it
// visible", NOT remove it).
// D2 fix (2026-06-30): the armor CONTAINER overlapped health (was left 10.56vw,
// right 0.220, vs health right 0.134). Shifted right to left 11.6vw width 9.5vw
// (x 0.116–0.211) so the chrome starts just past health's narrowed right edge
// (0.114). Leaves RE-SYNCED to the moved container: value x0.120, icon x0.180,
// bar x0.120 (all > health's bar end 0.106 → no leaf overlap either).
// Tokens: $hud_panel_bg $accent $boneDim $font_mono $font_sans.
itemDef {
	name "hud_active_armor_panel"
	type container
	position absolute
	left 11.6vw
	bottom 4vh
	width 9.5vw
	height 11.56vh
	direction column
	padding 0.7vh 1.1vw
	background $hud_panel_bg60
	borderLeft 3px $accent

	itemDef { type 0 rect 0 0 0 0 width FIT height FIT text "ARMOR" textalign 0 font $font_mono 9 forecolor $boneDim decoration visible 1 grow 0 }

	// HUD redesign (Eser, 2026-06-30): mirrors health — ICON on the LEFT, VALUE over BAR
	// to its right. Icon natural color (no tint). All leaves inside the chrome
	// (x 0.116–0.211): icon 0.124–0.142, value/bar left x0.148, bar right end 0.200.
	itemDef { hudElement "statusbar_icon"  bind "armor" anchor BOTTOM_LEFT rect 0.124 0.892 0.018 0.030 decoration visible 1 }
	itemDef { hudElement "statusbar_value" bind "armor" anchor BOTTOM_LEFT rect 0.148 0.885 0 0         font $font_sans fontsize 40 46 textalign 0 forecolor $accent decoration visible 1 }
	itemDef { hudElement "statusbar_bar"   bind "armor" anchor BOTTOM_LEFT rect 0.148 0.925 0.052 0.004 direction R forecolor $accent decoration visible 1 }
}

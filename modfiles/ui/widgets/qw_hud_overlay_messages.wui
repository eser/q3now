// qw_hud_overlay_messages — V2_HUD_Active overlay text feed (vote / follow / spectator)
// HUD redesign (Eser) Phase E — overlay layer (CTF-less scope, Eser-ratified).
// Four transient text states, all TOP-LEFT (the only empty corner now that the
// kill-feed moved to TR). hudElement rects are FULL-VIEWPORT; the four stack
// downward (votes on top, follow/spec below) — only one or two are ever active at
// once so they don't collide in practice.
//   votemessageworld : "VOTE(N): <text>  yes(F1):N  no(F2):N" + 30s countdown.
//                       Engine reads cgs.vote* via compat (cl_wired_hud_elem_vmw.c);
//                       visible during a call-vote in any gametype.
//   teamvotemessageworld : "TEAMVOTE(N): <text>  yes(F5):N  no(F6):N" — same shape,
//                       fed by cgs.teamVote* (cl_wired_hud_elem_tvmw.c). The cgame
//                       bridge resolves the local player's red/blue slot, so this is
//                       only ever the vote the viewer can actually answer.
//   followmessage    : "Following ^7<name>" — when spectating/following a player.
//   specmessage      : "^1SPECTATOR" — when the local client is a spectator.
// All four self-gate in the engine (vote active / team vote active /
// CG_IsFollowing / IsSpectator), so they render nothing during normal play.
// No bind needed — compat-fed.
// Tokens: $bone $boneDim $primary_red $font_sans.
itemDef {
	name "hud_active_overlay_messages_root"
	type container
	direction column
	width PERCENT 1
	height 29vh
	decoration
	visible 1
	itemDef { name "hud_overlay_top_gap" type container height 12vh grow 0 }

	// call-vote line — top-left, just below the top edge
	itemDef { name "hud_vote_message" hudElement "votemessageworld"
		width PERCENT 1 height 3.5vh grow 0
		font $font_sans
		fontsize 16 20
		textalign 0
		forecolor $bone
		decoration
		visible 1
	}
	// team-vote line — directly under the call-vote line
	itemDef { name "hud_team_vote_message" hudElement "teamvotemessageworld"
		width PERCENT 1 height 3.5vh grow 0
		font $font_sans
		fontsize 16 20
		textalign 0
		forecolor $bone
		decoration
		visible 1
	}
	// "Following <name>" — under the vote lines
	itemDef { name "hud_follow_message" hudElement "followmessage"
		width PERCENT 1 height 4.5vh grow 0
		font $font_sans
		fontsize 16 20
		textalign 0
		forecolor $boneDim
		decoration
		visible 1
	}
	// "SPECTATOR" — under the follow line, red accent (engine text already has ^1)
	itemDef { name "hud_spec_message" hudElement "specmessage"
		width PERCENT 1 height 4.5vh grow 0
		font $font_sans
		fontsize 18 22
		textalign 0
		forecolor $primary_red
		decoration
		visible 1
	}
}

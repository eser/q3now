// qw_hud_health_panel — bottom-left HEALTH card.
// Placement and dimensions remain authored by the classic HUD.  Chrome comes
// from WHUD_CARD_CHROME; every child is local to this card's flex box.
itemDef {
	name "hud_active_health_panel"
	type container
	width 9.5vw
	height 11.56vh
	direction column
	padding 0.7vh 1.1vw
	gap 0.3vh
	WHUD_CARD_CHROME

	itemDef {
		name "hud_health_caption"
		type 0 width PERCENT 1 height FIT
		text "HEALTH" textalign 0
		font $font_mono 9 forecolor $boneDim
		decoration visible 1 grow 0
	}

	itemDef {
		name "hud_health_content"
		type container direction row
		width PERCENT 1 height 5.1vh
		alignX start alignY center gap 0.6vw grow 1

		itemDef {
			name "hud_health_icon_slot"
			type container direction column
			width 2.6vh height PERCENT 1
			padding 1.4vh 0 0 0 justify center grow 0

			itemDef {
				name "hud_health_icon"
				hudElement "statusbar_icon" bind "health"
				width 2.6vh height 2.6vh
				decoration visible 1 grow 0
			}
		}
		itemDef {
			name "hud_health_value_slot"
			type container direction column
			width 5.1vw height 5.1vh
			padding 0 0 20px 0 grow 0

			itemDef {
				name "hud_health_value"
				hudElement "statusbar_value" bind "health"
				width PERCENT 1 grow 1
				font $font_sans fontsize 38 44
				textalign 2 forecolor $primary_red
				decoration visible 1
			}
		}
	}

	itemDef {
		name "hud_health_bar_slot"
		type container direction column
		width PERCENT 1 height 1.9vh
		padding 0 0 20px 0 grow 0

		itemDef {
			name "hud_health_bar"
			hudElement "statusbar_bar" bind "health"
			width PERCENT 1 height 0.5vh
			direction R forecolor $primary_red
			decoration visible 1 grow 0
		}
	}
}

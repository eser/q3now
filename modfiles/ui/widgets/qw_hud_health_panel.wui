// qw_hud_health_panel — V2_HUD_Active bottom-left HEALTH panel
// Interface: #include once into the HUD composer menuDef body.
//
// HUD redesign (Eser, 2026-06-30): caption RESTORED above the value. The caption
// ("HEALTH") is a Clay column-flow text node — that IS the coordinate space where
// it renders correctly (it was visible all along; my earlier `position absolute`
// move is what collapsed it to a 0×0 box). The value/icon/bar are hudElement
// leaves that resolve FULL-VIEWPORT, so they CANNOT flow under the caption — they
// are placed by hand. The fix for the "too much gap" Eser saw earlier is to put
// the caption near the panel TOP (flex flow) AND pull the value UP to y0.88 (was
// y0.925 at the panel floor), so caption and value sit close together in the
// panel's upper-middle band, not a panel-height apart.
//   caption  : flex-flow, panel top, mono 9, dim
//   value    : full-viewport y0.88 (just under the caption), big red
//   icon     : full-viewport, right of value, on its baseline
//   bar      : full-viewport, thin underline under the value
// Panel box: left 1.94vw, bottom 4vh, 9.5vw × 11.56vh → screen x ≈ 0.019–0.114.
// D2 fix (2026-06-30): the health and armor CONTAINERS overlapped (health right
// 0.134 > armor left 0.105), and the health bar leaf (→0.116) overlapped the armor
// value leaf (0.112). Health chrome is narrowed to 9.5vw (right 0.114) and its bar
// to width 0.080 (→0.106); armor is shifted right to left 11.6vw with its leaves
// re-synced (see qw_hud_armor_panel.wui), so neither chrome nor leaves overlap.
// Tokens: $hud_panel_bg $primary_red $boneDim $font_mono $font_sans.
itemDef {
	name "hud_active_health_panel"
	type container
	position absolute
	left 1.94vw
	bottom 4vh
	width 9.5vw
	height 11.56vh
	direction column
	padding 0.7vh 1.1vw
	background $hud_panel_bg60
	borderLeft 3px $primary_red

	// caption — flex-flow at the panel top (this renders; full-viewport leaves below
	// are placed by hand to sit right under it).
	itemDef { type 0 width FIT height FIT text "HEALTH" textalign 0 font $font_mono 9 forecolor $boneDim decoration visible 1 grow 0 }

	// HUD redesign (Eser, 2026-06-30): ICON on the LEFT, then the VALUE stacked OVER
	// the BAR to its right ([icon] value / bar). The icon draws in its NATURAL color
	// (no forecolor tint — see cl_wired_hud_elem_statusbar_icon.c). value/bar keep the
	// red forecolor. All leaves stay inside the chrome (right 0.114): icon 0.030–0.048,
	// value/bar left x0.054, bar right end 0.106.
	itemDef { hudElement "statusbar_icon"  bind "health" anchor BOTTOM_LEFT rect 0.030 0.892 0.018 0.030 decoration visible 1 }
	itemDef { hudElement "statusbar_value" bind "health" anchor BOTTOM_LEFT rect 0.054 0.885 0 0         font $font_sans fontsize 40 46 textalign 0 forecolor $primary_red decoration visible 1 }
	itemDef { hudElement "statusbar_bar"   bind "health" anchor BOTTOM_LEFT rect 0.054 0.925 0.052 0.004 direction R forecolor $primary_red decoration visible 1 }
}

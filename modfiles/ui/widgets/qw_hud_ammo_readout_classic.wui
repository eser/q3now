// qw_hud_ammo_readout_classic — bottom-right ammo readout WITH gauge + icon.
//
// This is the layout as it stood on 2026-08-10, kept verbatim as a separate
// variant. The mockup-aligned revision dropped two leaves — the statusbar_bar
// gauge (direction L, filling right-to-left) and the statusbar_icon — because
// the artboard draws neither. Playing it showed the loss: Eser asked for "sag
// altta ammo ile ilgili bolum... oradaki gauge'lar ve degerler tam tersine saga
// yasli". The gauge was already here; chasing artboard parity threw it away.
//
// Selected via `hud classic`. See modern for the mockup-aligned
// variant and modfiles/docs/hud-variants.md for the split.
// qw_hud_ammo_readout — V2_HUD_Active bottom-right AMMO readout
// Interface: #include once into the modern composer menuDef body.
//
// HUD redesign (Eser, 2026-06-30): caption RESTORED, mirroring the vitals panels.
// The caption is the live weapon name (store-bound to player.weapon.name) as a
// flex-flow text node at the panel top — that IS where flow text renders; the
// ammo digit is a FULL-VIEWPORT statusbar_value leaf pulled UP to y0.88 so it sits
// right under the name (gap reduced, name visible). Right-aligned to match the
// right-anchored panel. Dark fill + amber right stripe keep the amber digit
// readable over the bottom-right viewmodel HDR glow. ∞ for infinite weapons.
// Panel box: right 1.94vw, bottom 4vh, 11.5vw × 11.56vh. digit x0.962 textalign 2.
// Tokens: $hud_panel_bg $accent $boneDim $font_mono $font_sans.
itemDef {
	name "hud_classic_ammo_readout"
	type container
	position absolute
	right 1.94vw
	bottom 4vh
	width 11.5vw
	height 11.56vh
	direction column
	padding 0.7vh 1.1vw
	alignX end
	background $hud_panel_bg60
	borderRight 3px $accent

	// D3 fix (2026-06-30): caption now binds the SHORT uppercase weapon tag
	// (player.weapon.shortname, e.g. "RL") — the full .name ("Rocket Launcher")
	// overran this compact panel. Uses explicit width PERCENT (NOT width FIT) to
	// match the proven bound-text pattern in qw_hud_scoreboard_bar / qw_hud_kill_feed
	// (a FIT-width bound text node mis-measured → garbled glyphs).
	itemDef { type 0 rect 0 0 6vw 2.2vh height FIT width PERCENT 6vw bind "player.weapon.shortname" text "WPN" textalign 2 font $font_mono 11 forecolor $boneDim decoration visible 1 grow 0 }

	// HUD redesign (Eser, 2026-06-30): VALUE on the LEFT (right-aligned) with the BAR
	// stacked UNDER it, ICON on the RIGHT — (value / bar) [icon]. The icon draws in its
	// NATURAL color (no forecolor tint — this is why the red RL icon no longer greys
	// out). value/bar keep the amber forecolor. digit right-edge 0.934, icon 0.944–0.962
	// (≈10px gap, no collision even for '999'); bar 0.882–0.934 under the digit (clear of
	// the icon). The bar binds player.ammo.percent (= ammo/200, ∞-weapons → full).
	itemDef { hudElement "statusbar_value" bind "ammo" anchor BOTTOM_RIGHT rect 0.934 0.885 0 0 font $font_sans fontsize 40 46 textalign 2 forecolor $accent decoration visible 1 }
	itemDef { hudElement "statusbar_bar"   bind "ammo" anchor BOTTOM_RIGHT rect 0.882 0.925 0.052 0.004 direction L forecolor $accent decoration visible 1 }
	itemDef { hudElement "statusbar_icon"  bind "ammo" anchor BOTTOM_RIGHT rect 0.944 0.892 0.018 0.030 decoration visible 1 }
}

// attract_brand.wui — attract-mode brand splash (Brutalist Poster direction)
//
// Static identity frame shown while the game is idle. Swiss/brutalist poster:
// a full-height red spine on the left edge (the shared signature across all
// three attract screens), an oversized offset QUAKE / WIRED wordmark in bone,
// a red index caption, and a bottom rule with drop-in tags + INSERT COIN.
//
// Authoring discipline (avoids the (0,0) collapse that killed the old attract
// screens): every element is position-absolute with explicit vw/vh sizing, and
// every text leaf carries `height FIT` + a real width (PERCENT/FIT) exactly like
// the shipped main.wui hero (main.wui:50-63). NEVER a bare `rect 0 0 1.0 X`
// inside a flex parent.
//
// Red spine/index use $poster_red (#e6332b) so the poster reads aggressive-red
// independent of the active accent palette. Font is $font_sans_bold (the heaviest
// real display atlas). Tokens: $ink $bone $boneDim $line $font_mono $poster_red.

menuDef {
	name "attract_brand"
	layer "bg_attract"
	rect 0 0 1.0 1.0
	fullScreen 1
	visible 0
	backcolor $ink   // $ink #0a0908

	// ── red spine (shared signature; left edge, full height) ─────────
	itemDef {
		name "brand_spine"
		type 0
		position absolute
		left 0
		top 0
		width 0.9vw
		height 100vh
		style 1
		backcolor $poster_red     // $poster_red #e6332b (accent-independent)
		decoration
		visible 1
	}

	// ── top-right stamp ──────────────────────────────────────────────
	itemDef {
		name "brand_stamp"
		type container
		// Hidden while a menu is up, for the same reason brand_title is: the
		// right-hand rail's PROFILE card occupies this exact corner, and both
		// are small mono caps, so they read as one garbled block. `backdrop dim`
		// leaves the reel visible on purpose — the scrim separates a moving
		// backdrop from menu text, it cannot separate two foreground labels.
		stateTest "ui_menuUp"
		hideState { 1 }
		position absolute
		top 8vh
		right 5vw
		width 20vw
		height 8vh
		direction column
		grow 0

		itemDef { type 0vh height FIT width PERCENT 1 text "ARENA/OS" textalign 2 font $font_mono 15 forecolor $attract_ink_hi decoration visible 1 grow 0 }
		itemDef { type 0vh height FIT width PERCENT 1 text "MMXXVI"   textalign 2 font $font_mono 15 forecolor $attract_ink_lo decoration visible 1 grow 0 }
	}

	// ── wordmark (oversized, offset-stacked QUAKE / WIRED) ───────────
	//
	// Hidden while a menu is up. main.wui draws its OWN hero wordmark in the
	// same corner, and `backdrop dim` deliberately leaves the reel visible
	// underneath, so both were painting "QUAKE WIRED" over each other — two
	// typographic hierarchies competing in one screen. The scrim cannot
	// separate them: both are foreground text. Standing the reel's wordmark
	// down leaves the menu one clear identity, and the reel keeps its role as
	// the moving backdrop plus its right-hand cards and bottom strip.
	itemDef {
		name "brand_body"
		type container
		direction column
		grow 1
		padding 20vh 5vw 8vh 7vw

		itemDef {
			name "brand_title"
			type container
			stateTest "ui_menuUp"
			hideState { 1 }
			top 20vh
			left 7vw
			width 80vw
			height 40vh
			direction column
			gap 0.5vh
			grow 0

			itemDef {
				name "brand_quake"
				type 0
				rect 0 0 1 16vh
				height FIT
				width PERCENT 1
				text "QUAKE"
				textalign 0
				font $font_sans_bold 150
				forecolor $bone
				decoration
				visible 1
				grow 0
			}
			itemDef {
				name "brand_wired"
				type 0
				rect 0 0 1 16vh
				height FIT
				width PERCENT 1
				padding 0 3vw          // offset so WIRED sits indented from QUAKE
				text "WIRED"
				textalign 0
				font $font_sans_bold 150
				forecolor $bone
				decoration
				visible 1
				grow 0
			}
		}

		itemDef { name "gap_brand_rule" type container height FIXED 42.0vh grow 0 }

		itemDef {
			name "brand_rule"
			type 0
			width 86vw
			height 0.3vh
			style 1
			backcolor 0.16 0.14 0.13 1   // $lineBright-ish warm rule
			decoration
			visible 1
		}

		itemDef { name "gap_brand_index" type container height FIXED 4.0vh grow 0 }

		itemDef {
			// The poster copy below lands on the menu's own action rows
			// (CAMPAIGN / HOST A MATCH / DEMOS / OPTIONS), so it is stood down
			// while a menu is up — same call as brand_title above. The reel
			// keeps its spine, rule and cards, which is what shows through.
			name "brand_index"
			stateTest "ui_menuUp"
			hideState { 1 }
			type 0
			width 80vw
			height 4vh
			text "01 // STANDALONE VULKAN ARENA COMBAT"
			textalign 0
			font $font_mono 17
			forecolor $attract_ink_hi
			decoration
			visible 1
		}

		itemDef { name "gap_brand_tags" type container height FIXED 7.0vh grow 0 }
			itemDef { name "gap_before_coin" type container height FIXED 10vh grow 0 }

		itemDef {
			name "brand_tags"
			stateTest "ui_menuUp"
			hideState { 1 }
			type 0
			width 80vw
			height 4vh
			text "NO SERVER   ·   NO WAITING   ·   DROP IN"
			textalign 0
			font $font_mono 15
			forecolor $attract_ink_lo
			decoration
			visible 1
		}

		itemDef {
			name "brand_coin"
			stateTest "ui_menuUp"
			hideState { 1 }
			type 0
			width 40vw
			height 4vh
			text "INSERT COIN"
			textalign 0
			font $font_mono 17
			forecolor $poster_red     // poster red
			decoration
			visible 1
		}

		itemDef {
			name "brand_spec"
			stateTest "ui_menuUp"
			hideState { 1 }
			type 0
			width 40vw
			height 4vh
			text "v0.9  ·  60 TICK  ·  DM"
			textalign 2
			font $font_mono 15
			forecolor $attract_ink_lo
			decoration
			visible 1
		}

	}
}

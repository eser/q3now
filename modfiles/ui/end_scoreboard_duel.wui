// end_scoreboard_duel.wui -- q3now End-of-match Duel scoreboard (Phase 6c canonical)
//
// HUD-layer intermission overlay for tournament / 1v1. Same engine
// state machine as the ingame variants (cl_wired_ui_hud_state.c)
// — `end_scoreboard_duel` is selected when wiredHud->intermission
// AND wiredHud->gametype == GT_DUEL.
//
// Layout (§8.3, duel variant): full-viewport centered shell hosting
// a single scorelist_widget with group "duel". The DUELBOARD
// renderer (cl_wired_ui_hud_scoreboard.c::WiredHud_DrawDuelBoard)
// detects `wiredHud->intermission` and overlays an animated winner
// banner with the victor's name + match duration on top of the
// two-panel fighter cards. The .wui wrapper provides positioning
// and the optional Disconnect/Continue footer.

#include "ui/widgets/qw_button.wui"

menuDef {
	name "end_scoreboard_duel"
	layer "hud"
	fullScreen 1
	visible 0
	style 0

	itemDef {
		name "duel_overlay"
		type container
		direction column
		alignX center
		alignY center

		itemDef {
			name "duel_root"
			type container
			direction column
			gap $spacing_md
			padding $spacing_md $spacing_md
			width PERCENT 1.0
			height PERCENT 1.0

			itemDef {
				name "duelboard"
				type scorelist_widget
				group "duel"
				rect 0 0 1 0.92
				width PERCENT 1.0
				height GROW
				forecolor $bone
				visible 1
				decoration
				grow 1
			}

			itemDef {
				name "popup_footer"
				type container
				direction row
				gap $spacing_md
				alignX end
				height FIT
				width PERCENT 1.0
				padding 0 $spacing_md

				QW_BUTTON("btn_disconnect", "Disconnect", $boneDim, { exec "disconnect" }, 0.18)
				QW_BUTTON("btn_continue", "Continue", $accent, { exec "vstr nextmap" }, 0.18)
			}
		}
	}
}

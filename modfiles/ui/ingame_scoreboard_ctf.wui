// ingame_scoreboard_ctf.wui -- q3now In-game CTF scoreboard (Phase 6b canonical)
//
// HUD-layer overlay for Capture the Flag (and 1-flag CTF variant).
// Same engine state machine and split-pane shape as TDM (§8.2) —
// the engine flips visible=1 when wiredHud->showScores AND
// wiredHud->gametype == GT_CTF/GT_1FCTF.
//
// CTF flag state surfacing: the flag carrier indicator + base /
// dropped / carried state lives in the HUD's flagstatus element
// (cl_wired_hud_elem_flagstatus.c), NOT in the scoreboard. That
// element renders OWN/NME flag icons during gameplay; the
// scoreboard itself is purely a per-team player list — same shape
// as TDM. Phase 6b audit confirmed no engine extension required.

menuDef {
	name "ingame_scoreboard_ctf"
	layer "hud"
	fullScreen 1
	visible 0
	style 0

	itemDef {
		name "scoreboard_overlay"
		type container
		direction column
		alignX center
		alignY start

		itemDef {
			name "scoreboard_root"
			type container
			rect 0.05 0.04 0.9 0.92
			direction column
			gap $spacing_md
			padding $spacing_md $spacing_md
			width PERCENT 0.9
			height PERCENT 0.92
			// V2 chrome restore (chain 6.x S1): frames the whole RED|BLUE
			// split-pane + team headers. Engine gates visibility by name on
			// wiredHud->showScores (cl_wired_ui_hud_state.c:579-610).
			background $hud_panel_bg
			border 1px $accent

			itemDef {
				name "team_header"
				type container
				direction row
				gap $spacing_md
				height FIT
				width PERCENT 1.0

				itemDef { name "red_label"  type 0 height FIT width PERCENT 0.5 text "RED TEAM"  textalign 1 font $font_sans_bold 18 forecolor $primary_red  decoration visible 1 grow 1 }
				itemDef { name "blue_label" type 0 height FIT width PERCENT 0.5 text "BLUE TEAM" textalign 1 font $font_sans_bold 18 forecolor $accent decoration visible 1 grow 1 }
			}

			itemDef {
				name "split_pane"
				type container
				rect 0 0 1 0.86
				direction row
				gap $spacing_md
				grow 1
				height GROW
				width PERCENT 1.0

				itemDef {
					name "red_panel"
					type container
					rect 0 0 0.5 1.0
					direction column
					grow 1
					height PERCENT 1.0

					itemDef {
						name "red_scorelist"
						type scorelist_widget
						group "red"
						width PERCENT 1.0
						height PERCENT 1.0
						feeder "players_red_team"
						forecolor $team_red_text
						visible 1
						decoration
					}
				}

				itemDef {
					name "blue_panel"
					type container
					rect 0 0 0.5 1.0
					direction column
					grow 1
					height PERCENT 1.0

					itemDef {
						name "blue_scorelist"
						type scorelist_widget
						group "blue"
						width PERCENT 1.0
						height PERCENT 1.0
						feeder "players_blue_team"
						forecolor $team_blue_text
						visible 1
						decoration
					}
				}
			}
		}
	}
}

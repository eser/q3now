// display.wui -- q3now Display settings submenu (Phase 4c canonical)
// Phase 4c settings panel pattern reuse (§6.1).
// Brightness/gamma + screen size + FOV + zoom FOV + zoom toggle.
// FU-14 audit: no stateful custom-draw items here (all sliders/toggles
// flow through the Phase 4a label-and-value branch); no per-routine
// fix needed.

#include "ui/widgets/qw_settings_nav.wui"
#include "ui/widgets/qw_settings_chrome.wui"

menuDef {
	name "display"
	layer "menu"
	rect 0 0 1 1
	fullScreen 1
	visible 1
	style 1

	itemDef {
		name "settings_root"
		position absolute
		rect 0 0 1 1
		type container
		direction column
		background "layered" effects "base+glow+noise+vignette"

		QW_SETTINGS_TOPBAR("q3now / Settings / Display")

		itemDef {
			name "settings_content"
			type container
			rect 0 0 1 0.83
			direction row
			padding $content_padding_y $content_padding_x
			gap $spacing_lg
			grow 1
			height GROW

			itemDef {
				name "settings_nav"
				type container
				rect 0 0 0.30 1
				direction column
				gap $spacing_sm

				itemDef { name "nav_label" type 0 rect 0 0 1 0.025 height FIT text "CATEGORIES" textalign 0 font $font_mono 10 forecolor $boneDim decoration visible 1 grow 0 }
				QW_SETTINGS_NAV("nav_sound",       "sound",       "Sound",       "sound")
				QW_SETTINGS_NAV("nav_video",       "video",       "Video",       "video")
				QW_SETTINGS_NAV("nav_display",     "display",     "Display",     "display")
				QW_SETTINGS_NAV("nav_controls",    "controls",    "Controls",    "controls")
				QW_SETTINGS_NAV("nav_network",     "network",     "Network",     "network")
				QW_SETTINGS_NAV("nav_player",      "player",      "Player",      "playersettings")
				QW_SETTINGS_NAV("nav_preferences", "preferences", "Preferences", "preferences")
				itemDef { name "nav_spacer" type container rect 0 0 1 0 grow 1 }
			}

			itemDef {
				name "settings_panel"
				type container
				rect 0 0 0.70 1
				direction column
				padding $card_padding
				gap $card_gap_internal
				grow 1
				width GROW

				itemDef { name "panel_header" type 0 rect 0 0 1 0.05 height FIT text "Display" textalign 0 font $font_sans_bold 22 forecolor $accent decoration visible 1 grow 0 }
				itemDef { name "panel_subheader" type 0 rect 0 0 1 0.025 height FIT text "Brightness / FOV / zoom" textalign 0 font $font_mono 11 forecolor $boneDim decoration visible 1 grow 0 }

				itemDef {
					name "panel_content"
					type container
					rect 0 0 1 0.7
					direction column
					gap $spacing_md
					grow 1
					height GROW
					scroll
					alignY start
					padding 0 0

					// two-column grid row
					itemDef {
						name "grid_row_1"
						type container
						height FIT
						width PERCENT 1
						grow 0
						direction row
						gap $spacing_md
						alignY start
						padding 0 0

					// ── SCREEN group box ───────────────────────
					itemDef {
						name "group_screen"
						type container
						rect 0 0 0.5 0
						height FIT
						width PERCENT 0.5
						grow 0
						direction column
						padding $spacing_card_padding_v $spacing_card_padding_h
						gap $spacing_sm
						background $panelDeep
						border 1px $line
						radius $radius_md
						alignY start

						itemDef { name "group_screen_hdr" type container rect 0 0 1 2.2vh height FIT direction row alignY center gap 0.006
							itemDef { type 0 rect 0 0 1.2vw 2vh height FIT width PERCENT 1.2vw iconText "diamond" textalign 1 font $font_icon 10 forecolor $accent decoration visible 1 grow 0 }
							itemDef { type 0 rect 0 0 20vw 2vh height FIT width PERCENT 20vw text "SCREEN" textalign 0 font $font_mono 10 forecolor $accent decoration visible 1 grow 0 } }
						itemDef { name "row_brightness" type 10 rect 0 0 1 0.045 height FIXED 38px width PERCENT 1 text "Brightness (gamma)" textalign 0 font $font_sans 13 forecolor $bone cvarFloat "r_gamma" 1.0 0.5 2.0 visible 1 grow 0 }
						itemDef { name "row_viewsize" type 10 rect 0 0 1 0.045 height FIXED 38px width PERCENT 1 text "Screen Size" textalign 0 font $font_sans 13 forecolor $bone cvarFloat "cg_viewsize" 100 30 100 visible 1 grow 0 }
						itemDef { name "row_ingame_video" type checkbox rect 0 0 1 0.045 height FIXED 38px width PERCENT 1 text "In-game Video" textalign 0 font $font_sans 13 forecolor $bone cvar "r_inGameVideo" visible 1 grow 0 }
					}

					// ── VIEW group box ─────────────────────────
					itemDef {
						name "group_view"
						type container
						rect 0 0 0.5 0
						height FIT
						width PERCENT 0.5
						grow 0
						direction column
						padding $spacing_card_padding_v $spacing_card_padding_h
						gap $spacing_sm
						background $panelDeep
						border 1px $line
						radius $radius_md
						alignY start

						itemDef { name "group_view_hdr" type container rect 0 0 1 2.2vh height FIT direction row alignY center gap 0.006
							itemDef { type 0 rect 0 0 1.2vw 2vh height FIT width PERCENT 1.2vw iconText "diamond" textalign 1 font $font_icon 10 forecolor $accent decoration visible 1 grow 0 }
							itemDef { type 0 rect 0 0 20vw 2vh height FIT width PERCENT 20vw text "VIEW" textalign 0 font $font_mono 10 forecolor $accent decoration visible 1 grow 0 } }
						itemDef { name "row_fov" type 10 rect 0 0 1 0.045 height FIXED 38px width PERCENT 1 text "FOV" textalign 0 font $font_sans 13 forecolor $bone cvarFloat "cg_fov" 100 75 130 visible 1 grow 0 }
						itemDef { name "row_zoom_fov" type 10 rect 0 0 1 0.045 height FIXED 38px width PERCENT 1 text "Zoom FOV" textalign 0 font $font_sans 13 forecolor $bone cvarFloat "cg_zoomfov" 22.5 10 130 visible 1 grow 0 }
						itemDef { name "row_zoom_sens" type 10 rect 0 0 1 0.045 height FIXED 38px width PERCENT 1 text "Zoom Sensitivity" textalign 0 font $font_sans 13 forecolor $bone cvarFloat "cg_zoomSensitivity" 1 0.01 1 visible 1 grow 0 }
						itemDef { name "row_zoom_toggle" type checkbox rect 0 0 1 0.045 height FIXED 38px width PERCENT 1 text "Zoom Toggle" textalign 0 font $font_sans 13 forecolor $bone cvar "cg_zoomToggle" visible 1 grow 0 }
					}
					}
				}

				itemDef {
					name "panel_footer"
					type container
					rect 0 0 1 0.05
					direction row
					gap $spacing_md
					alignY center
					height FIT

					QW_SETTINGS_BACK_BTN
					QW_SETTINGS_FOOTER_SPACER
					QW_SETTINGS_FOOTER_BTN("btn_apply",  "Apply",  $accent,  { exec "vid_restart" })
				}
			}
		}

		QW_SETTINGS_BOTTOMBAR("left/right to adjust")
	}

	onOpen { setstate ui_settingsSection display }
	onESC  { close }
}

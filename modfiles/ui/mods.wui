// mods.wui -- q3now Mod Browser (Phase 5d canonical)
//
// ListBox panel (§7.1 pattern). Centered overlay with header +
// subheader + 2-column ListBox over the FEEDER_MODS feeder +
// Load Mod / Back footer. Reached from main menu → Mods.

menuDef {
	name "mods"
	layer "menu"
	rect 0 0 1 1
	fullScreen 1
	visible 1
	style 1

	itemDef {
		name "browser_root"
		position absolute
		rect 0 0 1 1
		type container
		direction column
		background "layered" effects "base+glow+noise+vignette"

		itemDef {
			name "top_bar"
			type container
			rect 0 0 1 $top_bar_height
			direction row
			padding 0.005 0.02
			alignY center
			background $panel
			borderY 1px $line

			itemDef { name "brand" type 0 rect 0 0 0.22 0.04 height FIT text "q3now / Mods" textalign 0 font $font_sans_bold 14 forecolor $accent decoration visible 1 grow 0 }
			itemDef { name "top_bar_spacer" type container rect 0 0 0 0 grow 1 }
			itemDef { name "hint" type 0 rect 0 0 0.2 0.04 height FIT text "double-click to load" textalign 2 font $font_mono 10 forecolor $boneDim decoration visible 1 grow 0 }
		}

		itemDef {
			name "browser_content"
			type container
			rect 0 0 1 0.83
			direction column
			padding $content_padding_y $content_padding_x
			gap $spacing_md
			grow 1
			height GROW

			itemDef { name "header"    type 0 rect 0 0 1 0.06 height FIT text "Installed Mods" textalign 0 font $font_sans_bold 22 forecolor $accent decoration visible 1 grow 0 }
			itemDef { name "subheader" type 0 rect 0 0 1 0.03 height FIT text "Select an alternate game module to load." textalign 0 font $font_mono 11 forecolor $boneDim decoration visible 1 grow 0 }

			itemDef {
				name "list_header"
				type container
				rect 0 0 1 0.04
				direction row
				gap $spacing_xs
				height FIT
				background $panel
				borderY 0 1px $line
				padding 0.005 0.01

				itemDef { name "h_dir"  type 0 rect 0 0 0.25 0.03 height FIT width PERCENT 0.25 text "DIR"         textalign 0 font $font_mono 11 forecolor $boneDim decoration visible 1 grow 0 }
				itemDef { name "h_name" type 0 rect 0 0 0.70 0.03 height FIT width PERCENT 0.70 text "DESCRIPTION" textalign 0 font $font_mono 11 forecolor $boneDim decoration visible 1 grow 0 }
			}

			itemDef {
				name "modlist"
				type 6
				rect 0 0 1 0.6
				width PERCENT 1.0
				height GROW
				font $font_sans 12
				forecolor $bone
				backcolor $panelDeep
				style 1
				feeder "mods"
				elementheight 24
				columns 2 0 320 32 320 700 32
				visible 1
				doubleclick { runmod }
			}

			itemDef {
				name "browser_footer"
				type container
				rect 0 0 1 0.05
				direction row
				gap $spacing_md
				alignX end
				alignY center
				height FIT
				padding 0.005 0

				itemDef { type 1 rect 0 0 0.14 0.04 height FIT text "Back"     textalign 1 font $font_sans 13       forecolor $boneDim forecolor.active $accent visible 1 grow 0 action { close } }
				itemDef { type 1 rect 0 0 0.14 0.04 height FIT text "Load Mod" textalign 1 font $font_sans_bold 13 forecolor $accent forecolor.active $accent visible 1 grow 0 action { runmod } }
			}
		}

		itemDef {
			name "bottom_bar"
			type container
			rect 0 0 1 $bottom_bar_height
			direction row
			padding 0 0.02
			alignY center
			alignX end
			gap $spacing_md

			itemDef { name "hint_back" type 0 rect 0 0 0.1 0.025 height FIT text "ESC back" textalign 2 font $font_mono 10 forecolor $boneDim decoration visible 1 grow 0 }
		}
	}

	onESC { close }
}

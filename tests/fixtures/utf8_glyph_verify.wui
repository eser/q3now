// utf8_glyph_verify.wui — UTF-8 glyph delivery PoC.
// Every text leaf below is UTF-8 encoded; if the engine's MSDF text
// path decodes correctly + the atlas covers the codepoints + the
// fallback chain works, all glyphs render as the real characters.

menuDef {
	name "utf8_glyph_verify"
	layer "menu"
	fullScreen 1
	rect 0 0 1 1
	visible 1
	style 1
	backcolor $ink

	itemDef {
		name "utf8_header"
		rect 0.10 0.18 0.80 0.05
		text "UTF-8 glyph delivery: end-to-end"
		font $font_mono 18
		forecolor $bone
		visible 1
		decoration
	}

	itemDef {
		name "utf8_middot_jbmono"
		rect 0.10 0.30 0.80 0.05
		text "JBMono · middle dot · U+00B7 · 12 occurrences · here"
		font $font_mono 22
		forecolor $accent
		visible 1
		decoration
	}

	itemDef {
		name "utf8_diamond_jbmono"
		rect 0.10 0.40 0.80 0.05
		text "JBMono ◆ diamond ◆ U+25C6 ◆ inline ◆ here"
		font $font_mono 22
		forecolor $accent
		visible 1
		decoration
	}

	itemDef {
		name "utf8_mixed_oxanium"
		rect 0.10 0.50 0.80 0.06
		text "Oxanium · with · diamond ◆ and · mid-dots ●"
		font $font_sans 28
		forecolor $bone
		visible 1
		decoration
	}

	itemDef {
		name "utf8_dashes"
		rect 0.10 0.60 0.80 0.05
		text "dashes: en–dash em—dash quotes: \"smart\" 'single'"
		font $font_mono 18
		forecolor $boneDim
		visible 1
		decoration
	}

	itemDef {
		name "utf8_caption"
		rect 0.10 0.72 0.80 0.04
		text "All glyphs above are inline UTF-8 (not iconText); resolved via JBMono atlas + font fallback chain."
		font $font_mono 11
		forecolor $boneDim
		visible 1
		decoration
	}
}

+        // No IPC or shared memory: nothing of ours will be written, so the
+        // previously installed filter is the only thing that can still produce
+        // evidence (no logging - exception filter context).
+        return chain_previous_filter(exception_info);
     }
 
     sentry_crash_context_t *ctx = ipc->shmem;
@@ -851,8 +924,10 @@ crash_exception_filter(EXCEPTION_POINTERS *exception_info)

+/**
+ * Chain to the handler that was installed before us (signal-safe).
+ *
+ * Without this, installing sentry SILENTLY DISABLES any pre-existing crash
+ * handler: we save it in g_previous_handlers below and then terminate via
+ * raise(), so it is recorded and never invoked. An embedder whose own handler
+ * writes a crash report or flushes a breadcrumb trail loses those artefacts the
+ * moment sentry is enabled, with nothing to indicate why.
+ *
+ * Called immediately BEFORE raise(), because raise() with SIG_DFL installed
+ * terminates the process — nothing after it runs.
+ */
+static void
+chain_previous_handler(int signum, siginfo_t *info, void *context)
+{
+    for (size_t i = 0; i < g_crash_signal_count; i++) {
+        if (g_crash_signals[i] != signum) {
+            continue;
+        }
+
+        const struct sigaction *prev = &g_previous_handlers[i];
+
+        // SIG_DFL / SIG_IGN carry no handler to call. sa_handler and
+        // sa_sigaction may share storage in a union, so the flag decides which
+        // member is the live one.
+        if (prev->sa_flags & SA_SIGINFO) {
+            if (prev->sa_sigaction != NULL) {
+                prev->sa_sigaction(signum, info, context);
+            }
+        } else if (prev->sa_handler != SIG_DFL && prev->sa_handler != SIG_IGN
+            && prev->sa_handler != NULL) {
+            prev->sa_handler(signum);
+        }
+        return;
+    }
+}
+
 /**
  * Signal handler (signal-safe)
  */
@@ -258,7 +295,9 @@ crash_signal_handler(int signum, siginfo_t *info, void *context)
 
     sentry_crash_ipc_t *ipc = g_crash_ipc;
     if (!ipc || !ipc->shmem) {
-        // No IPC available, just re-raise
+        // No IPC available: nothing of ours will be written, so the previously
+        // installed handler is the only thing that can still produce evidence.
+        chain_previous_handler(signum, info, context);
         raise(signum);
         return;
     }
@@ -684,6 +723,11 @@ daemon_handling:
         }
     }
 
+    // Our dump is on disk; give the previously installed handler its turn
+    // before the process dies, so an embedder's own crash artefacts are still
+    // produced alongside the minidump rather than instead of it.
+    chain_previous_handler(signum, info, context);
+
     raise(signum);
 }
 
@@ -771,6 +815,33 @@ sentry__crash_handler_shutdown(void)
 static sentry_crash_ipc_t *g_crash_ipc = NULL;
 static LPTOP_LEVEL_EXCEPTION_FILTER g_previous_filter = NULL;
 
+/**
+ * Chain to the filter that was installed before us.
+ *
+ * The Windows twin of chain_previous_handler above, and it exists for the same
+ * reason: g_previous_filter is saved at install time and otherwise only touched
+ * at shutdown, so an embedder's own filter is recorded and never invoked.
+ *
+ * Returning EXCEPTION_CONTINUE_SEARCH is NOT equivalent to calling it.
+ * SetUnhandledExceptionFilter holds a SINGLE slot rather than a chain: whoever
+ * installs last replaces the previous filter outright, and CONTINUE_SEARCH
+ * proceeds to the system default, not to the filter that was displaced. So the
+ * only way the earlier filter runs is to call it explicitly.
+ *
+ * The previous filter's verdict is returned to the caller, because that verdict
+ * is a decision about the process: a filter answering EXCEPTION_EXECUTE_HANDLER
+ * intends to handle the fault and shut down in its own way, and discarding that
+ * in favour of CONTINUE_SEARCH would override it.
+ */
+static LONG
+chain_previous_filter(EXCEPTION_POINTERS *exception_info)
+{
+    if (g_previous_filter == NULL) {
+        return EXCEPTION_CONTINUE_SEARCH;
+    }
+    return g_previous_filter(exception_info);
+}
+
 /**
  * Windows exception filter (crash handler)
  */

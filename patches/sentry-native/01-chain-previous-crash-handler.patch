     raise(signum);
 }
 
@@ -771,6 +815,33 @@ sentry__crash_handler_shutdown(void)
 static sentry_crash_ipc_t *g_crash_ipc = NULL;
 static LPTOP_LEVEL_EXCEPTION_FILTER g_previous_filter = NULL;
 
+/**
+ * Chain to the filter that was installed before us.
+ *
+ * The Windows twin of chain_previous_handler above, and it exists for the same
+ * reason: g_previous_filter is saved at install time and otherwise only touched
+ * at shutdown, so an embedder's own filter is recorded and never invoked.
+ *
+ * Returning EXCEPTION_CONTINUE_SEARCH is NOT equivalent to calling it.
+ * SetUnhandledExceptionFilter holds a SINGLE slot rather than a chain: whoever
+ * installs last replaces the previous filter outright, and CONTINUE_SEARCH
+ * proceeds to the system default, not to the filter that was displaced. So the
+ * only way the earlier filter runs is to call it explicitly.
+ *
+ * The previous filter's verdict is returned to the caller, because that verdict
+ * is a decision about the process: a filter answering EXCEPTION_EXECUTE_HANDLER
+ * intends to handle the fault and shut down in its own way, and discarding that
+ * in favour of CONTINUE_SEARCH would override it.
+ */
+static LONG
+chain_previous_filter(EXCEPTION_POINTERS *exception_info)
+{
+    if (g_previous_filter == NULL) {
+        return EXCEPTION_CONTINUE_SEARCH;
+    }
+    return g_previous_filter(exception_info);
+}

+    // Windows path used to collapse "the process is gone" and "I could not
+    // ask" into a single `return false`, so any failure to open the handle
+    // ended the daemon.
+    //
+    // That asymmetry is not cosmetic, because the two mistakes do not cost the
+    // same. Wrongly reporting dead makes the daemon break out of its wait loop
+    // and finalize the session, so a crash arriving afterwards finds the run
+    // slot already closed and NO MINIDUMP IS EVER WRITTEN — the evidence is
+    // destroyed. Wrongly reporting alive only keeps a small daemon running a
+    // little longer, and the parent-exit path is not the only way it ends.
+    // When in doubt, therefore, report alive.
     HANDLE hProcess = OpenProcess(SYNCHRONIZE, FALSE, parent_pid);
     if (!hProcess) {
-        return false; // Process doesn't exist or can't be accessed
-    }
-    // Check if process has exited
+        // ERROR_INVALID_PARAMETER is the true counterpart of ESRCH: no process
+        // carries that id. Anything else — ERROR_ACCESS_DENIED above all, the
+        // counterpart of EPERM — means the process exists but is not open to
+        // us, which is precisely the case POSIX keeps alive.
+        return GetLastError() != ERROR_INVALID_PARAMETER;
+    }
+    // A failed GetExitCodeProcess does not mean the process exited; it means
+    // the exit status could not be read. Same rule: only a definite answer of

    temporal.previousMvp = (*spvDescriptorSet3.temporalPayloads).temporalPayload[int(gl_InstanceIndex)].previousMvp;
    temporal.outcomeReserved = (*spvDescriptorSet3.temporalPayloads).temporalPayload[int(gl_InstanceIndex)].outcomeReserved;
    float4 temporalLocalPosition = float4(in.in_position, 1.0);

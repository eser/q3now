vertex main0_out main0(main0_in in [[stage_in]], const device spvDescriptorSetBuffer0& spvDescriptorSet0 [[buffer(0)]], const device spvDescriptorSetBuffer3& spvDescriptorSet3 [[buffer(3)]], uint gl_InstanceIndex [[instance_id]])
{
    main0_out out = {};
    float4x4 _16;
    if (_15)

#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct main0_out
{
    float4 frag_color [[user(locn0)]];
    float2 frag_tex_coord0 [[user(locn1)]];
    float4 gl_Position [[position]];
};

struct main0_in
{
    float2 in_ndc [[attribute(0)]];
    float4 in_color [[attribute(1)]];
    float2 in_tex_coord0 [[attribute(2)]];
};

vertex main0_out main0(main0_in in [[stage_in]])
{
    main0_out out = {};
    out.gl_Position = float4(in.in_ndc, 0.0, 1.0);
    out.frag_color = in.in_color;
    out.frag_tex_coord0 = in.in_tex_coord0;
    return out;
}


static inline __attribute__((always_inline))
float4 sampleCurrent(thread const int2& pixel, constant TemporalResolvePush& pc, texture2d<float> currentColor, sampler nearestSampler)
{
    int2 bounded = clamp(pixel, int2(0), int2(pc.extent) - int2(1));
    return currentColor.read(uint2(bounded), 0);
}


static inline __attribute__((always_inline))
float linearizeDepth(thread const float& z, constant TemporalResolvePush& pc)
{
    float range = spvFSub(pc.zFar, pc.zNear);
    float scaled = spvFMul(z, range);
    float denominator = spvFAdd(pc.zNear, scaled);
    float numerator = spvFMul(pc.zNear, pc.zFar);
    float result = numerator / denominator;
    return result;
}

static inline __attribute__((always_inline))
float mixPrecise(thread const float& x, thread const float& y, thread const float& a)
{
    float oneMinus = spvFSub(1.0, a);
    float left = spvFMul(x, oneMinus);
    float right = spvFMul(y, a);
    float result = spvFAdd(left, right);
    return result;
}


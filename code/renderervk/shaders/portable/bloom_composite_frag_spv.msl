#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

constant float intensity_tmp [[function_constant(0)]];
constant float intensity = is_function_constant_defined(intensity_tmp) ? intensity_tmp : 0.5;

struct spvDescriptorSetBuffer0
{
    texture2d<float> texture0 [[id(0)]];
    sampler texture0Smplr [[id(1)]];
};

struct main0_out
{
    float4 out_color [[color(0)]];
};

struct main0_in
{
    float2 frag_tex_coord [[user(locn0)]];
};

fragment main0_out main0(main0_in in [[stage_in]], const device spvDescriptorSetBuffer0& spvDescriptorSet0 [[buffer(0)]])
{
    main0_out out = {};
    float3 bloom = spvDescriptorSet0.texture0.sample(spvDescriptorSet0.texture0Smplr, in.frag_tex_coord).xyz;
    out.out_color = float4(bloom * intensity, 0.0);
    return out;
}


        float3 _286 = sRGBToLinear(param_1);
        _277 = _286;
    }
    float3 waterColor = _277;
    float3 nV = fast::normalize(in.V.xyz);
    float fresnel = 1.0 - abs(dot(fast::normalize(in.N), nV));
    fresnel *= fresnel;
    float3 tinted = mix(refraction, waterColor, float3(tint_strength));
    float3 finalColor = mix(tinted, waterColor * 1.2999999523162841796875, float3(fresnel * 0.60000002384185791015625));
    float3 nL = fast::normalize(in.L.xyz);
    float3 halfVec = fast::normalize(nL + nV);

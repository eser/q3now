    float2 refractionUV = fast::clamp(screenUV + (ripple * distortion_scale), float2(0.001000000047497451305389404296875), float2(0.999000012874603271484375));
    uint _241 = (*spvDescriptorSet0.m_180).packed_indices[1].z & 4095u;
    uint _248 = ((*spvDescriptorSet0.m_180).packed_indices[1].z >> uint(12)) & 255u;
    float3 refraction = wired_bindless_images[_241].sample(wired_bindless_samplers[_248], refractionUV).xyz;
    uint _260 = (*spvDescriptorSet0.m_180).packed_indices[0].x & 4095u;
    uint _267 = ((*spvDescriptorSet0.m_180).packed_indices[0].x >> uint(12)) & 255u;
    float4 waterTex = wired_bindless_images[_260].sample(wired_bindless_samplers[_267], in.frag_tex_coord);
    float3 _277;
    if (_276)
    {
        _277 = waterTex.xyz;
    }
    else

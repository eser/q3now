    uint _203 = ((*spvDescriptorSet0.m_180).packed_indices[1].z >> uint(12)) & 255u;
    int2 screenSize = int2(wired_bindless_images[_189].get_width(), wired_bindless_images[_189].get_height());
    float2 screenUV = gl_FragCoord.xy / float2(screenSize);

    float2 param_1 = in.frag_tex_coord0;
    int param_2 = 0;
    float4 color0 = wired_bl_sample_domain(param, param_1, param_2, wired_bindless_images, (*spvDescriptorSet0.m_83), wired_bindless_samplers) * (*spvDescriptorSet0.m_83).ent_color0;
    float4 base = color0;

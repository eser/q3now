#pragma clang diagnostic ignored "-Wmissing-prototypes"
#pragma clang diagnostic ignored "-Wmissing-braces"

#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

template<typename T, size_t Num>
struct spvUnsafeArray
{
    T elements[Num ? Num : 1];
    
    thread T& operator [] (size_t pos) thread
    {
        return elements[pos];
    }
    constexpr const thread T& operator [] (size_t pos) const thread
    {
        return elements[pos];
    }
    
    device T& operator [] (size_t pos) device
    {
        return elements[pos];
    }
    constexpr const device T& operator [] (size_t pos) const device
    {
        return elements[pos];
    }
    
    constexpr const constant T& operator [] (size_t pos) const constant
    {
        return elements[pos];
    }
    
    threadgroup T& operator [] (size_t pos) threadgroup
    {
        return elements[pos];
    }
    constexpr const threadgroup T& operator [] (size_t pos) const threadgroup
    {
        return elements[pos];
    }
};

struct Push
{
    float4x4 invViewProj;
    float4 params0;
    float4 params1;
};

struct TileDepth
{
    float tileDepth[1];
};

struct Light
{
    float4 posRadius;
    float4 color;
    float4 posRadius2;
};

struct Lights
{
    Light lights[1];
};

struct TileLights
{
    uint tileLights[1];
};

constant uint3 gl_WorkGroupSize [[maybe_unused]] = uint3(8u, 8u, 1u);

struct spvDescriptorSetBuffer0
{
    device TileDepth* m_198 [[id(0)]];
    device Lights* m_419 [[id(1)]];
    device TileLights* m_497 [[id(2)]];
};

static inline __attribute__((always_inline))
float3 unproject(thread const float3& ndc, constant Push& _30)
{
    float4 w = _30.invViewProj * float4(ndc, 1.0);
    return w.xyz / float3(w.w);
}

static inline __attribute__((always_inline))
float4 planeFromPoints(thread const float3& a, thread const float3& b, thread const float3& c)
{
    float3 n = fast::normalize(cross(b - a, c - a));
    return float4(n, -dot(n, a));
}

static inline __attribute__((always_inline))
float planeDist(thread const float4& pl, thread const float3& p)
{
    return dot(pl.xyz, p) + pl.w;
}

kernel void main0(device spvDescriptorSetBuffer0& spvDescriptorSet0 [[buffer(0)]], constant Push& _30 [[buffer(1)]], uint3 gl_GlobalInvocationID [[thread_position_in_grid]])
{
    uint tx = gl_GlobalInvocationID.x;
    uint ty = gl_GlobalInvocationID.y;
    uint tilesX = uint(_30.params0.z);
    uint tilesY = uint(_30.params0.w);
    if ((tx >= tilesX) || (ty >= tilesY))
    {
        return;
    }
    uint tileIndex = (ty * tilesX) + tx;
    uint outBase = tileIndex * 33u;
    float screenW = _30.params0.x;
    float screenH = _30.params0.y;
    uint numLights = uint(_30.params1.x);
    bool depthValid = _30.params1.y != 0.0;
    float x0 = float(tx * 16u);
    float y0 = float(ty * 16u);
    float x1 = fast::min(x0 + 16.0, screenW);
    float y1 = fast::min(y0 + 16.0, screenH);
    float ndcX0 = ((x0 / screenW) * 2.0) - 1.0;
    float ndcX1 = ((x1 / screenW) * 2.0) - 1.0;
    float ndcY0 = ((y0 / screenH) * 2.0) - 1.0;
    float ndcY1 = ((y1 / screenH) * 2.0) - 1.0;
    float dMin = 0.0;
    float dMax = 1.0;
    if (depthValid)
    {
        dMin = (*spvDescriptorSet0.m_198).tileDepth[(2u * tileIndex) + 0u];
        dMax = (*spvDescriptorSet0.m_198).tileDepth[(2u * tileIndex) + 1u];
        if (dMax < dMin)
        {
            dMin = 0.0;
            dMax = 1.0;
        }
    }
    float3 param = float3(ndcX0, ndcY0, dMax);
    spvUnsafeArray<float3, 8> c;
    c[0] = unproject(param, _30);
    float3 param_1 = float3(ndcX1, ndcY0, dMax);
    c[1] = unproject(param_1, _30);
    float3 param_2 = float3(ndcX1, ndcY1, dMax);
    c[2] = unproject(param_2, _30);
    float3 param_3 = float3(ndcX0, ndcY1, dMax);
    c[3] = unproject(param_3, _30);
    float3 param_4 = float3(ndcX0, ndcY0, dMin);
    c[4] = unproject(param_4, _30);
    float3 param_5 = float3(ndcX1, ndcY0, dMin);
    c[5] = unproject(param_5, _30);
    float3 param_6 = float3(ndcX1, ndcY1, dMin);
    c[6] = unproject(param_6, _30);
    float3 param_7 = float3(ndcX0, ndcY1, dMin);
    c[7] = unproject(param_7, _30);
    float3 tileCentroid = float3(0.0);
    for (int i = 0; i < 8; i++)
    {
        tileCentroid += c[i];
    }
    tileCentroid *= 0.125;
    float3 param_8 = c[0];
    float3 param_9 = c[3];
    float3 param_10 = c[4];
    spvUnsafeArray<float4, 6> planes;
    planes[0] = planeFromPoints(param_8, param_9, param_10);
    float3 param_11 = c[1];
    float3 param_12 = c[5];
    float3 param_13 = c[2];
    planes[1] = planeFromPoints(param_11, param_12, param_13);
    float3 param_14 = c[0];
    float3 param_15 = c[4];
    float3 param_16 = c[1];
    planes[2] = planeFromPoints(param_14, param_15, param_16);
    float3 param_17 = c[3];
    float3 param_18 = c[2];
    float3 param_19 = c[7];
    planes[3] = planeFromPoints(param_17, param_18, param_19);
    float3 param_20 = c[0];
    float3 param_21 = c[1];
    float3 param_22 = c[3];
    planes[4] = planeFromPoints(param_20, param_21, param_22);
    float3 param_23 = c[4];
    float3 param_24 = c[7];
    float3 param_25 = c[5];
    planes[5] = planeFromPoints(param_23, param_24, param_25);
    for (int i_1 = 0; i_1 < 6; i_1++)
    {
        float4 param_26 = planes[i_1];
        float3 param_27 = tileCentroid;
        if (planeDist(param_26, param_27) < 0.0)
        {
            planes[i_1] = -planes[i_1];
        }
    }
    uint count = 0u;
    uint cap = 32u;
    for (uint li = 0u; (li < numLights) && (li < 256u); li++)
    {
        float3 lp = (*spvDescriptorSet0.m_419).lights[li].posRadius.xyz;
        float lr = ((device float*)&(*spvDescriptorSet0.m_419).lights[li].posRadius)[3u];
        if (lr <= 0.0)
        {
            continue;
        }
        float3 center = lp;
        float radius = lr;
        if (((device float*)&(*spvDescriptorSet0.m_419).lights[li].posRadius2)[3u] != 0.0)
        {
            float3 lp2 = (*spvDescriptorSet0.m_419).lights[li].posRadius2.xyz;
            center = (lp + lp2) * 0.5;
            radius = lr + (0.5 * length(lp2 - lp));
        }
        bool inside = true;
        for (int p = 0; p < 6; p++)
        {
            float4 param_28 = planes[p];
            float3 param_29 = center;
            if (planeDist(param_28, param_29) < (-radius))
            {
                inside = false;
                break;
            }
        }
        if (inside && (count < cap))
        {
            (*spvDescriptorSet0.m_497).tileLights[(outBase + 1u) + count] = li;
            count++;
        }
    }
    (*spvDescriptorSet0.m_497).tileLights[outBase] = count;
}


#version 450

#ifdef USE_TX2
#define USE_TX1
#endif

#ifdef USE_CL2
#define USE_CL1
#endif

// MVP now lives in the set-0 UBO (host vkUniform_t.mvp @ offset 480) — migrating
// off the push-constant block (at the 128 B Vulkan ceiling). Read as ubo.mvp.
// The UBO is now declared in EVERY gen variant (previously only USE_FOG/USE_ENV)
// so the vertex stage can read mvp; the base pass writes a per-draw UBO ring item
// on every gen draw (vk_update_mvp dual-writes the value). The host struct (under
// FEAT_SHADOW_MAPPING) places mvp at 480, so the vertex stage pads its std140
// prefix to 480 regardless of which earlier fields it actually reads.
layout(set = 0, binding = 0) uniform UBO {
	// light/env parameters:
	vec4 eyePos;				// vertex
#ifdef USE_ENT_COLOR
	vec4 entColor0;				// fragment: ent.color[0]
	vec4 entColor1;				// fragment: ent.color[1]
	vec4 entColor2;				// fragment: ent.color[2]
#else
	vec4 lightPos;				// vertex: light origin
	vec4 lightColor;			// fragment: rgb + 1/(r*r)
	vec4 lightVector;			// fragment: linear dynamic light
#endif
#ifdef USE_FOG
	// fog parameters:
	vec4 fogDistanceVector;		// vertex
	vec4 fogDepthVector;		// vertex
	vec4 fogEyeT;				// vertex
	vec4 fogColor;				// fragment
#endif
	// Pad the std140 prefix to mvp @ host offset 480 (eyePos + the light/ent
	// union always span 0..64; fog spans 64..128 when present; the host's q1 +
	// cascade + modelMatrix tail covers 128..480 which the vertex stage skips).
#ifdef USE_FOG
	vec4 _pad_to_mvp[22];       //  128 -> 480 (352 bytes, after fogColor)
#else
	vec4 _pad_to_mvp[26];       //   64 -> 480 (416 bytes, after the light/ent union)
#endif
	mat4 mvp;                   // offset 480; the VS transform
} ubo;

// Per-entity transform delivery (constant id 16): when set, the transform comes
// from a frame-wide storage buffer indexed by gl_InstanceIndex (== firstInstance),
// bound once per frame, instead of ubo.mvp — the portable-binding surface (storage
// buffer + instance index; no raw pointer; clone of the shadow depth pass). Flat
// std430 mat4 array, stride 64. Under shadows 2 mat4s/entity (mvp@2*i,
// modelMatrix@2*i+1); gen reads only mvp. 0 (default) = ubo.mvp → byte-identical.
layout(constant_id = 16) const int ENTITY_SSBO = 0;
// Per-slot mat4 stride. This MUST match the host's ENTITY_MATRIX_SLOT_BYTES, which
// is governed by the build-wide shadow-mapping feature (always carries { mvp,
// modelMatrix } = 2 mat4s/slot = 128 B), NOT by this pipeline variant's
// USE_SHADOWMAP. The host writes every entity's slot at index gl_InstanceIndex*2
// regardless of which gen variant reads it, so a non-shadow variant must still
// stride by 2 to land on its own slot — it simply ignores the second (modelMatrix)
// mat4. Gating this on USE_SHADOWMAP made non-shadow variants stride by 1, reading
// a foreign matrix for every slot > 0 (slot 0 aliases either way) → those world
// surfaces collapsed to a degenerate transform and rendered black.
#define ENTITY_MATS_PER_SLOT 2
layout(std430, set = 3, binding = 0) readonly buffer EntityMatrices {
	mat4 entMat[];
};

layout(location = 0) in vec3 in_position;

#ifndef USE_ENV
layout(location = 2) in vec2 in_tex_coord0;
#endif

#ifdef USE_TX1
layout(location = 3) in vec2 in_tex_coord1;
#endif
#ifdef USE_TX2
layout(location = 4) in vec2 in_tex_coord2;
#endif

#if defined(USE_ENV) || defined(USE_IBL)
layout(location = 5) in vec3 in_normal;
#endif

#if defined (USE_CLX_IDENT) || defined (USE_FIXED_COLOR)
// use either 1.0 or fixed (rgb+a) color from spec.constants
#else
layout(location = 1) in vec4 in_color0;
#ifdef USE_CL1
layout(location = 6) in vec4 in_color1;
#endif
#ifdef USE_CL2
layout(location = 7) in vec4 in_color2;
#endif

layout(location = 0) out vec4 frag_color0;
#ifdef USE_CL1
layout(location = 5) out vec4 frag_color1;
#endif
#ifdef USE_CL2
layout(location = 6) out vec4 frag_color2;
#endif
#endif

layout(location = 1) out vec2 frag_tex_coord0;
#ifdef USE_TX1
layout(location = 2) out vec2 frag_tex_coord1;
#endif
#ifdef USE_TX2
layout(location = 3) out vec2 frag_tex_coord2;
#endif

#ifdef USE_FOG
layout(location = 4) out vec2 fog_tex_coord;
#endif
#ifdef USE_SHADOWMAP
layout(location = 7) out vec4 shadowData;   // xyz = world position, w = view-space depth
#endif
#ifdef USE_IBL
// World-space normal + fragment->eye view vector for the base-pass IBL ambient
// term. Worldspawn-only (identity model transform → in_normal is already world
// space, in_position is world space), so no modelMatrix is needed — same
// reasoning as the USE_SHADOWMAP worldspawn receiver above.
layout(location = 8) out vec3 ibl_N;
layout(location = 9) out vec3 ibl_V;
#endif

out gl_PerVertex {
	vec4 gl_Position;
};

void main() {
	mat4 mvp = ( ENTITY_SSBO != 0 ) ? entMat[gl_InstanceIndex * ENTITY_MATS_PER_SLOT] : ubo.mvp;
	gl_Position = mvp * vec4(in_position, 1.0);

#ifdef USE_SHADOWMAP
	// 7.4.10.4 R3 — sun-shadow receiver data. The USE_SHADOWMAP gen variant is
	// only selected for worldspawn lightmapped surfaces, whose in_position is
	// already world-space (identity model transform) — so no modelMatrix is
	// needed (light_vert.tmpl carries one only because it also lights entity
	// surfaces). View-space depth == gl_Position.w for a perspective
	// projection, same derivation light_vert.tmpl uses.
	shadowData = vec4( in_position, gl_Position.w );
#endif

#ifdef USE_IBL
	// Base-pass IBL inputs. in_normal is world-space (identity model transform on
	// worldspawn surfaces); the view vector uses the same math as USE_ENV above.
	ibl_N = in_normal;
	ibl_V = normalize( ubo.eyePos.xyz - in_position );
#endif

#if defined (USE_CLX_IDENT) || defined (USE_FIXED_COLOR)
	// use either 1.0 or fixed (rgb+a) color from spec.constants
#else
	frag_color0 = in_color0;
#ifdef USE_CL1
	frag_color1 = in_color1;
#endif
#ifdef USE_CL2
	frag_color2 = in_color2;
#endif
#endif

#ifdef USE_ENV
	vec3 viewer = normalize(ubo.eyePos.xyz - in_position);
	float d = dot(in_normal, viewer); 
	vec2 reflected = in_normal.yz * 2 * d - viewer.yz;

	frag_tex_coord0.s = 0.5 + reflected.x * 0.5;
	frag_tex_coord0.t = 0.5 - reflected.y * 0.5;
#else
	frag_tex_coord0 = in_tex_coord0;
#endif

#ifdef USE_TX1
	frag_tex_coord1 = in_tex_coord1;
#endif
#ifdef USE_TX2
	frag_tex_coord2 = in_tex_coord2;
#endif

#ifdef USE_FOG
	float s = dot(in_position, ubo.fogDistanceVector.xyz) + ubo.fogDistanceVector.w;
	float t = dot(in_position, ubo.fogDepthVector.xyz) + ubo.fogDepthVector.w;

	if ( ubo.fogEyeT.y == 1.0 ) {
		if ( t < 0.0 ) {
			t = 1.0 / 32.0;
		} else {
			t = 31.0 / 32.0;
		}
	} else {
		if ( t < 1.0 ) {
			t = 1.0 / 32.0;
		} else {
			t = 1.0 / 32.0 + (30.0 / 32.0 * t) / ( t - ubo.fogEyeT.x );
		}
	}

	fog_tex_coord = vec2(s, t);
#endif // USE_FOG
}

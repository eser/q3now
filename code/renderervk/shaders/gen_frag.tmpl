// The set-0 UBO is unconditional: even with no light/fog/shadow consumer it
// still carries packed_indices (the per-draw bindless table) at offset 544.
// The light/env + fog prefix is a fixed 128 B (eyePos + 3-vec4 union + 4 fog),
// declared in every permutation so the cascade / pad offsets are stable. The
// fog vec4s are always present (they back the vertex-stage fog factor).
layout(set = 0, binding = 0) uniform UBO {
	// light/env parameters:
	vec4 eyePos;				// vertex
#ifdef USE_ENT_COLOR
	vec4 ent_color0;			// fragment: ent.color[0]
	vec4 ent_color1;			// fragment: ent.color[1]
	vec4 ent_color2;			// fragment: ent.color[2]
#else
	vec4 lightPos;				// vertex: light origin
	vec4 lightColor;			// fragment: rgb + 1/(r*r)
	vec4 lightVector;			// fragment: linear dynamic light
#endif
	// fog parameters:
	vec4 fogDistanceVector;		// vertex
	vec4 fogDepthVector;		// vertex
	vec4 fogEyeT;				// vertex
	vec4 fogColor;				// fragment
#ifdef USE_SHADOWMAP
	// CSM cascade matrices / split distances at std140 offsets 144 / 400
	// (matches vkUniform_t, code/renderervk/vk.h). The prefix above is a fixed
	// 128 B, so one vec4 pad reaches 144. Fragment-stage only; consumed by
	// sampleShadow below.
	vec4 _pad_to_cascadeMVP[1];   // 128 -> 144
	mat4 cascadeMVP[4];           // offset 144, 256 bytes
	vec4 cascadeSplits;           // offset 400,  16 bytes
	// Pad over modelMatrix (416) + mvp (480) — neither declared here — to the
	// bindless table at 544.
	vec4 _pad_to_packed_indices[8];   // 416 -> 544
#else
	// No shadow cascades: pad from fogColor (128) over the host's cascade /
	// modelMatrix / mvp span to the bindless table at 544.
	vec4 _pad_to_packed_indices[26];  // 128 -> 544
#endif
	// Per-draw bindless index table (std140 uvec4[3] = 48 B). Roles 0..7 are
	// filled by the host packing loop; 8..11 are reserved capacity. See
	// vkUniform_t::packed_indices and WIRED_BINDLESS_PACK in vk.h.
	uvec4 packed_indices[3];      // offset 544, 48 bytes
	// World-lighting globals (vkUniform_t::worldLightParams). .x = r_lightmapBoost,
	// the linear-domain lightmap overbright the modulate branches apply below. Live —
	// the host stamps it into every ring item each frame, so a cvar change shows next
	// frame with no pipeline rebuild. Appended at the end so all offsets above hold.
	vec4 worldLightParams;        // offset 592, 16 bytes
};

// gen_frag is bindless-only. 2D texture slots route through set 1 (image array
// @ binding 0, sampler array @ binding 1, populated host-side as images
// register and samplers are created). The per-draw packed index table lives in
// the set-0 UBO (packed_indices above): one uint32 per role, packed
// (tex:12 | sampler:8) — see WIRED_BINDLESS_PACK in vk.h. Role indices:
// role 0 = T0, 1 = T1, 2 = T2, 3 = fog, 4 = depth_fade, 5 = normalmap
// (unused in this template).
#extension GL_EXT_nonuniform_qualifier : require

layout(set = 1, binding = 0) uniform texture2D wired_bindless_images[];
layout(set = 1, binding = 1) uniform sampler   wired_bindless_samplers[];

// Per-role packed index is uint32 (sampler-slot field 8 bits, covers
// MAX_VK_SAMPLERS). The std140 UBO stores them as uvec4[3]; role N reads
// component N%4 of vec4 N/4. role is always a literal, so the index folds.
#define WIRED_BINDLESS_PACKED(role) packed_indices[ (role) / 4u ][ (role) % 4u ]

// Macros (not a function) — GLSL disallows sampler/image as a function return
// type when targeting SPIR-V. Each `textureN` call site inline-expands to the
// sampler2D ctor; glslang's CSE folds the duplicate packed_indices load. The
// `role` argument is always a literal (texture0=0u, texture1=1u …), so the
// preprocessor flattens the shift constants.
#define WIRED_BINDLESS_TEX(role) sampler2D( \
	wired_bindless_images  [ nonuniformEXT(   WIRED_BINDLESS_PACKED( role )         & 0xFFFu ) ], \
	wired_bindless_samplers[ nonuniformEXT( ( WIRED_BINDLESS_PACKED( role ) >> 12 ) & 0xFFu  ) ] )

// Identifiers `textureN` / `fog_texture` / `depth_texture` expand to a uint
// role index instead of a sampler2D global. All consumers go through the
// dispatch macros below.
#define texture0      0u
#define texture1      1u
#define texture2      2u
#define fog_texture   3u
#define depth_texture 4u

// Dispatch macros. GLSL disallows passing a sampler2D() ctor to a user
// function, so `sampleColorTex(s, uv, slot)` is rerouted through the inline
// wired_bl_sample_domain helper that does the texture()+sRGB decode at point
// of use.
#define sampleColorTex(role, uv, slot)  wired_bl_sample_domain( role, uv, slot )
#define wired_tex_raw(role, uv)         texture( WIRED_BINDLESS_TEX( role ), uv )
#define wired_tex_size(role, lod)       textureSize( WIRED_BINDLESS_TEX( role ), lod )

#ifdef USE_SHADOWMAP
// 7.4.10.4 R3 — sun-shadow receiver state. shadowMap (CSM depth 2D-array) is
// the same descriptor (set 2 / binding 0) that PMLIGHT's light_frag.tmpl uses.
// The sun-mask atlas rides the bindless 2D table at role 7.
layout(set = 2, binding = 0) uniform sampler2DArray shadowMap;
#define WIRED_BINDLESS_SUNMASK_ROLE 7u
layout (constant_id = 28) const int   shadow_pcf  = 5;       // 1 / 5 / 9 PCF taps
layout (constant_id = 29) const float shadow_bias = 0.005;
#endif

#ifdef USE_IBL
// Base-pass image-based-lighting ambient. The probe cubes + split-sum LUT live
// on the engine-resources descriptor set (set 2) alongside the CSM shadowMap at
// binding 0 — the set is born with 5 bindings, so declaring 1/2/3/4 is layout-
// clean. The pbrMap (ORM) rides the bindless 2D table at role 8.
layout(set = 2, binding = 1) uniform sampler2D   brdfLut;        // split-sum env-BRDF LUT (RG)
layout(set = 2, binding = 2) uniform samplerCube irradianceCube; // cosine-convolved diffuse env
layout(set = 2, binding = 3) uniform samplerCube radianceCube;   // prefiltered specular env (mips)
// The denoised screen-space GTAO visibility buffer (R8, 1 = open .. 0 = occluded),
// sampled by screen-space UV to occlude the additive indirect IBL-specular term.
// binding 4 of the engine-resources set; written with GTAO's own sampler. When GTAO
// is off the AO image is cleared to 1.0 (no effect).
layout(set = 2, binding = 4) uniform sampler2D   gtaoMap;        // screen-space GTAO visibility (R8)
#define WIRED_BINDLESS_PBRMAP_ROLE 8u
// World-space normal + view vector from gen_vert.
layout(location = 8) in vec3 ibl_N;
layout(location = 9) in vec3 ibl_V;
// Runtime gate: the IBL pipeline variant may be selected for a surface that has
// no pbrMap (or with r_pbr toggled off mid-frame); the host writes 1 only when
// the term should contribute, else 0 zeroes it without a separate pipeline.
layout (constant_id = 14) const int ibl_enabled = 0;
#endif



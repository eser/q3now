#endif // !USE_CL1
#endif // !USE_TX1

#if !defined(USE_TX1)
	base = color0;
#endif

#ifdef USE_ATEST
#if 0
	if (alpha_to_coverage != 0) {
		if (alpha_test_func == 1) {
			base.a =  base.a > 0.0 ? 1.0 : 0.0;
		} else if (alpha_test_func == 2) {
			base.a = CorrectAlpha(alpha_test_value, 1.0 - base.a, frag_tex_coord0);
		} else if (alpha_test_func == 3) {
			base.a = CorrectAlpha(alpha_test_value, base.a, frag_tex_coord0);
		}
	} else
#endif
	// specialization: alpha-test function
	if (alpha_test_func == 1) {
		if (color0.a == alpha_test_value) discard;
	} else if (alpha_test_func == 2) {
		if (color0.a >= alpha_test_value) discard;
	} else if (alpha_test_func == 3) {
		if (color0.a < alpha_test_value) discard;
	}
#endif

#if !defined(USE_TX1) && !defined(USE_TX2)
	base = color0;
#endif

#ifdef USE_SHADOWMAP
	// Operand-keyed sun-shadow apply (single site — all combine branches converge
	// here). Modulates the assembled lit colour by the CSM sun shadow, addressed by
	// the LIGHTMAP operand UV (lightmap_slot) — so it lands on the bundle[1] MUL2/MUL3
	// collapse AND the lone single-texture lightmap pass of a separate-lightmap-pass
	// surface. lightmap_slot == 0 (no lightmap operand) -> no-op. Applied before IBL
	// so the shadow sees the lit-lightmap base, identical ordering to the prior
	// in-branch calls. Shares #215's lightmap_slot: whiten+boost+sun-shadow now one
	// operand-keyed path.
	base.rgb = wired_apply_sun_shadow_operand( base.rgb );
#endif

#ifdef USE_IBL
	// Always-on image-based-lighting ambient for a pbrMap worldspawn surface.
	// Light-INDEPENDENT (no dynamic light needed) — the analytic-sky probe cubes
	// + split-sum LUT supply soft directional environment lighting. Added in the
	// linear-HDR domain (tonemap is a downstream post-process), BEFORE fog so the
	// fog blend sees the lit colour. Tightly gated: the USE_IBL pipeline variant
	// is only selected for worldspawn lightmap surfaces carrying a pbrMap under
	// r_pbr, and the ibl_enabled spec-constant zeroes the term otherwise — so the
	// hot base pass pays nothing on non-pbrMap / r_pbr-0 surfaces.
	if ( ibl_enabled != 0 ) {
		// pbrMap (ORM) at bindless role 8 — glTF 2.0 packing, same channel
		// mapping as light_frag: R = ambient occlusion, G = roughness,
		// B = metalness (linear; fetched raw).
		vec3  orm       = wired_tex_raw( WIRED_BINDLESS_PBRMAP_ROLE, frag_tex_coord0 ).rgb;
		float ao        = orm.r;
		float roughness = clamp( orm.g, 0.04, 1.0 );
		float metalness = orm.b;
		// IBL specular reflection only. The lightmap (base.rgb above) already
		// carries baked diffuse ambient + direct + radiosity fused as a
		// multiplicative modulate, so the diffuse-IBL half (kD * diffuseIBL)
		// would re-add ambient the lightmap already provides — a visible
		// double-brightening. The lightmap stays the diffuse-ambient authority;
		// IBL supplies only the view-dependent specular environment reflection,
		// which is NOT baked into the lightmap and is therefore a genuine
		// physical supplement. (Mirrors how the per-dlight pass ceded its
		// ambient term to this base pass — see light_frag.) The irradianceCube
		// sample is intentionally dropped; this uses only the already-bound
		// radianceCube + brdfLut. maxRadianceLod = VK_PROBE_RADIANCE_MIPS - 1
		// (compile-time constant 5.0).
		vec3  ibl_n       = normalize( ibl_N );
		vec3  ibl_v       = normalize( ibl_V );
		vec3  F0          = mix( vec3( 0.04 ), base.rgb, metalness );
		float NdotV       = max( dot( ibl_n, ibl_v ), 0.0 );
		vec3  F_amb       = fresnelSchlickRoughness( NdotV, F0, roughness );
		vec3  R           = reflect( -ibl_v, ibl_n );
		vec3  prefiltered = textureLod( radianceCube, R, roughness * 5.0 ).rgb;
		vec2  envBRDF     = textureLod( brdfLut, vec2( NdotV, roughness ), 0.0 ).rg;
		vec3  specularIBL = prefiltered * ( F_amb * envBRDF.x + envBRDF.y ) * ao;
		// Screen-space GTAO modulates ONLY this additive indirect (IBL-specular)
		// term — never the lightmap-baked diffuse-ambient (which carries its own
		// occlusion) and never direct light (the per-light passes are ambient-free).
		// The `ao` above is the texture-space ORM.r contact-AO; gtao_vis is the
		// larger-scale screen-space occlusion, an additional multiply. Screen UV from
		// gl_FragCoord; plain textureSize since gtaoMap is a real set-2 sampler2D, not
		// bindless. When GTAO is off the buffer is 1.0 (identity).
		vec2  gtaoUV      = gl_FragCoord.xy / vec2( textureSize( gtaoMap, 0 ) );
		float gtao_vis    = texture( gtaoMap, gtaoUV ).r;
		specularIBL      *= gtao_vis;
		base.rgb += specularIBL;
	}
#endif

#ifdef USE_FOG
	// fogColor is host-decoded to linear domain
	// (VK_SetFogParams — the single UBO fill site). `fog` (sampled from
	// fog_texture at the top of main) is a non-colour density ramp, not
	// decoded. The blend math below is unchanged; it now operates on
	// linear inputs.
	if ( acff == 1 ) {
		// ACFF_RGB
		base.rgb = base.rgb * (1.0 - fog.w);
	} else if ( acff == 2 ) {
		// ACFF_RGBA
		base = base * (1.0 - fog.w);
	} else if ( acff == 3 ) {
		// ACFF_ALPHA
		base.a = base.a * (1.0 - fog.w);
	} else {
		// default: ACFF_NONE
		base = mix( base, fog * fogColor, fog.a );
	}
#endif

	if ( discard_mode == 1 ) {
		if ( base.a == 0.0 ) {
			discard;
		}
	} else if ( discard_mode == 2 ) {
		if ( dot( base.rgb, base.rgb ) == 0.0 ) {
			discard;
		}
	}

#ifdef USE_DEPTH_FADE
	{
		// soft particle depth fade: compare fragment depth with scene depth
		vec2 screenUV = gl_FragCoord.xy / vec2(wired_tex_size(depth_texture, 0));
		float sceneDepth = wired_tex_raw(depth_texture, screenUV).r;
		float fragDepth = gl_FragCoord.z;
		// the engine uses reversed depth UNCONDITIONALLY (#define
		// USE_REVERSED_DEPTH in vk.h:65 — a hard define, not a cvar), but that
		// macro was never -D'd into the shader build, so this branch used to
		// take the non-reversed `sceneDepth - fragDepth` form: with near≈1.0 /
		// far≈0.0 every visible soft-particle fragment yielded a NEGATIVE
		// depthDiff → smoothstep == 0 → the particle was fully transparent. Under
		// reversed depth a fragment IN FRONT of the scene has fragDepth >
		// sceneDepth, so the correctly-signed difference is fragDepth - sceneDepth.
		// Hard-coded to match the engine's unconditional reversed-depth invariant
		// (the dead #else removed). NOTE: tonemap.frag's sunrays sky test has the
		// same un-passed-USE_REVERSED_DEPTH latent issue but is outside this
		// lane's file set.
		float depthDiff = fragDepth - sceneDepth;
		float fadeFactor = smoothstep(0.0, depth_fade_scale * 0.0005, depthDiff);
		base.a *= fadeFactor;
		base.rgb *= fadeFactor;
	}
#endif

#ifdef USE_DF
	if ( base.a < depth_fragment )
		discard;

	gl_FragDepth = gl_FragCoord.z;
#else
	out_color = base;

layout (constant_id = 3) const int alpha_to_coverage = 0;
// Block 5d: per-slot colour-domain bitmask. Bit N set => texture slot N is
// CD_LINEAR and is fetched raw; bit N clear => CD_SRGB, decoded via
// sRGBToLinear at sample time. Host-filled from each stage's bundle images
// (Vk_Pipeline_Def.tex_domain). Reuses spec-constant id 4 (the ex-color_mode
// slot, which color.frag still uses for its own white/green/red mode — a
// pipeline is exactly one shader type, so the id is unambiguous).
layout (constant_id = 4) const int tex_domain = 0;
//layout (constant_id = 5) const int abs_light = 0;
#if defined (USE_TX1) || defined(USE_TX2)
layout (constant_id = 6) const int tex_mode = 0; // modulate, add (identity), add(non-identity) etc
#endif
layout (constant_id = 7) const int discard_mode = 0;
// Which colour-texture slot holds the lightmap: 0 = none, else (bundle index + 1)
// — 1 = slot0, 2 = slot1, 3 = slot2. Host-filled from bundle[N].lightmap !=
// LIGHTMAP_INDEX_NONE. The world overbright (LIGHTMAP_BOOST) is applied to exactly
// this operand at sample time (wired_bl_sample_domain), so it follows the lightmap
// through EVERY combine branch and the lone single-texture pass — not just the
// modulate-default branch. Gated on lightmap-PRESENCE, not the combine mode: a
// lightmap in an add/blend/single-texture pass finally gets boosted, and a
// non-lightmap operand in a modulate collapse no longer gets an erroneous boost.
// A spec constant, so the slot resolves at pipeline build (static branch, no
// per-fragment cost); the boost MAGNITUDE stays the live UBO worldLightParams.x.
layout (constant_id = 26) const int lightmap_slot = 0;

// The legacy per-map `srgb` spec constant (id 15) and the
// worldLinearize* opt-in are retired. The engine is now
// self-consistently linear end-to-end: sampleColorTex
// below decodes every colour texel unconditionally, and LIGHTMAP_BOOST
// is applied unconditionally. Spec-constant id 15 is left a hole (ids
// are not required contiguous; renumbering would risk drift in the
// host-side map).

// Linear-domain lightmap boost (world overbright). q3map2 emits lightmap bytes at
// half-intensity expecting an engine-side doubling. The byte-space `<< 1`
// (R_ColorShiftLightingBytes) was incorrect in sRGB (byte 128 doubled to 255 is ~4×
// linear light, not 2×); the lightmap-texel call sites store the byte verbatim and the
// boost happens in linear domain, AFTER sampleColorTex's sRGB → linear decode.
//
// The boost follows the lightmap OPERAND, not the combine mode: it is applied in
// wired_bl_sample_domain to whichever colour slot the lightmap_slot spec constant flags
// as the lightmap (see lightmap_slot above). So a lightmap that lands in an add/blend/
// single-texture pass — not just the modulate-default MUL2/MUL3 collapse — still gets
// boosted, and a non-lightmap operand in a modulate collapse does not. The combine
// branches below therefore no longer multiply by LIGHTMAP_BOOST themselves.
//
// The factor is r_lightmapBoost, fed live via the set-0 UBO (worldLightParams.x), NOT
// a baked constant — so it tunes with no pipeline rebuild. Default 4.6 ≈ 2^2.2 matches
// vanilla Quake 3's gamma-space ×2 overbright: a linear ×N reads as N^(1/2.2) once the
// result is sRGB-encoded for display, so a linear 2.0 would only reach ~1.37× and leave
// the world darker than vanilla. See r_lightmapBoost (tr_init.c).
#define LIGHTMAP_BOOST (worldLightParams.x)


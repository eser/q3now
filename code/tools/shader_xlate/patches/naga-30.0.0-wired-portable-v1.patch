+    fn parse_spec_constant_op(
+        &mut self,
+        inst: Instruction,
+        module: &mut crate::Module,
+    ) -> Result<(), Error> {
+        let start = self.data_offset;
+        self.switch(ModuleState::Type, inst.op)?;
+        inst.expect(6)?;
+        let type_id = self.next()?;
+        let id = self.next()?;
+        let operation = spirv::Op::from_u32(self.next()?)
+            .ok_or(Error::UnsupportedInstruction(self.state, inst.op))?;
+        let left_id = self.next()?;
+        let right_id = self.next()?;
+        let operator = match operation {
+            spirv::Op::IEqual => crate::BinaryOperator::Equal,
+            spirv::Op::INotEqual => crate::BinaryOperator::NotEqual,
+            spirv::Op::SLessThanEqual => crate::BinaryOperator::LessEqual,
+            spirv::Op::SGreaterThan => crate::BinaryOperator::Greater,
+            spirv::Op::LogicalOr => crate::BinaryOperator::LogicalOr,
+            spirv::Op::ISub => crate::BinaryOperator::Subtract,
+            spirv::Op::BitwiseAnd => crate::BinaryOperator::And,
+            _ => return Err(Error::UnsupportedInstruction(self.state, operation)),
+        };
+        let span = self.span_from_with_op(start);
+        let left = module.global_expressions.append(
+            self.lookup_constant.lookup(left_id)?.inner.to_expr(), span);
+        let right = module.global_expressions.append(
+            self.lookup_constant.lookup(right_id)?.inner.to_expr(), span);
+        let init = module.global_expressions.append(
+            crate::Expression::Binary { op: operator, left, right }, span);
+        let ty = self.lookup_type.lookup(type_id)?.handle;
+        self.insert_derived_override(module, id, type_id, ty, init, span)
+    }
+
+    fn insert_derived_override(
+        &mut self,

+        id: u32,
+        type_id: u32,
+        ty: Handle<crate::Type>,
+        init: Handle<crate::Expression>,
+        span: crate::Span,
+    ) -> Result<(), Error> {
+        let decor = self.future_decor.remove(&id).unwrap_or_default();
+        if decor.specialization_constant_id.is_some() {
+            return Err(Error::UnsupportedInstruction(self.state, spirv::Op::SpecConstantOp));
+        }
+        let derived = crate::Override { name: decor.name, id: None, ty, init: Some(init) };
+        let inner = Constant::Override(module.overrides.append(derived, span));
+        self.lookup_constant.insert(id, LookupConstant { inner, type_id });
+        Ok(())
     }
 

vec3 wired_lighting_decode_oct(vec2 encoded)
{
    vec2 f = (encoded * 2.0) - vec2(1.0);
    vec3 n = vec3(f, (1.0 - abs(f.x)) - abs(f.y));
    if (n.z < 0.0)
    {
        vec2 folded = (vec2(1.0) - abs(n.yx)) * sign(n.xy);
        n.x = folded.x;
        n.y = folded.y;
    }
    return normalize(n);
}

vec3 wired_lighting_directional_static_indirect(vec3 radiance, vec2 encodedDirection, vec3 materialNormal)
{
    vec2 param = encodedDirection;
    vec3 dominantDirection = wired_lighting_decode_oct(param);
    return max(radiance, vec3(0.0)) * max(dot(normalize(materialNormal), dominantDirection), 0.0);
}

vec3 wired_display_visibility(vec3 sceneColor)
{

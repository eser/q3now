#version 460
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(std140, binding = 6) uniform TemporalBootstrapPush
{
    uvec2 extent;
    float zNear;
    float zFar;
} pc;

layout(binding = 0) uniform sampler2D currentColor;
layout(binding = 0, rgba16f) uniform writeonly image2D bootstrapColor;
layout(binding = 1, rgba16f) uniform writeonly image2D historyOutColor;
layout(binding = 2, r32f) uniform writeonly image2D historyOutLinearDepth;
layout(binding = 1) uniform sampler2D currentDeviceDepth;

bool finite4(vec4 v)
{
    bool _66 = all(equal(v, v));
    bool _74;
    if (_66)
    {
        _74 = all(lessThanEqual(abs(v), vec4(3.4028234663852885981170418348452e+38)));
    }
    else
    {
        _74 = _66;
    }
    return _74;
}

bool finite1(float v)
{
    bool _52 = v == v;
    bool _59;
    if (_52)
    {
        _59 = abs(v) <= 3.4028234663852885981170418348452e+38;
    }
    else
    {
        _59 = _52;
    }
    return _59;
}

float edgeLuma(vec3 c)
{
    float l = dot(c, vec3(0.2125999927520751953125, 0.715200006961822509765625, 0.072200000286102294921875));
    float param = l;
    if (!finite1(param))
    {
        return 0.0;
    }
    l = clamp(l, 0.0, 10000.0);
    return l * inversesqrt(1.0 + (l * l));
}

vec4 sampleCurrent(ivec2 pixel)
{
    ivec2 bounded = clamp(pixel, ivec2(0), ivec2(pc.extent) - ivec2(1));
    return texelFetch(currentColor, bounded, 0);
}

float edgeLumaAt(ivec2 p)
{
    ivec2 param = p;
    vec3 param_1 = sampleCurrent(param).xyz;
    return edgeLuma(param_1);
}

float edgeMidLuma(ivec2 base, ivec2 across)
{
    ivec2 param = base;
    ivec2 param_1 = base + across;
    return 0.5 * (edgeLumaAt(param) + edgeLumaAt(param_1));
}

vec4 spatialEdgeFilter(ivec2 px, vec4 centerColor)
{
    vec3 param = centerColor.xyz;
    float edgeM = edgeLuma(param);
    ivec2 param_1 = px + ivec2(0, -1);
    float edgeN = edgeLumaAt(param_1);
    ivec2 param_2 = px + ivec2(0, 1);
    float edgeS = edgeLumaAt(param_2);
    ivec2 param_3 = px + ivec2(-1, 0);
    float edgeW = edgeLumaAt(param_3);
    ivec2 param_4 = px + ivec2(1, 0);
    float edgeE = edgeLumaAt(param_4);
    float edgeHi = max(max(edgeN, edgeS), max(max(edgeW, edgeE), edgeM));
    float edgeLo = min(min(edgeN, edgeS), min(min(edgeW, edgeE), edgeM));
    float edgeSpan = edgeHi - edgeLo;
    if (edgeSpan < max(0.031199999153614044189453125, edgeHi * 0.125))
    {
        return centerColor;
    }
    ivec2 param_5 = px + ivec2(-1);
    float edgeNW = edgeLumaAt(param_5);
    ivec2 param_6 = px + ivec2(1, -1);
    float edgeNE = edgeLumaAt(param_6);
    ivec2 param_7 = px + ivec2(-1, 1);
    float edgeSW = edgeLumaAt(param_7);
    ivec2 param_8 = px + ivec2(1);
    float edgeSE = edgeLumaAt(param_8);
    float edgeNS = edgeN + edgeS;
    float edgeWE = edgeW + edgeE;
    float edgeNWSW = edgeNW + edgeSW;
    float edgeNESE = edgeNE + edgeSE;
    float edgeHorz = abs(((-2.0) * edgeW) + edgeNWSW) + ((abs(((-2.0) * edgeM) + edgeNS) * 2.0) + abs(((-2.0) * edgeE) + edgeNESE));
    float edgeVert = abs(((-2.0) * edgeS) + (edgeSW + edgeSE)) + ((abs(((-2.0) * edgeM) + edgeWE) * 2.0) + abs(((-2.0) * edgeN) + (edgeNW + edgeNE)));
    bool edgeHorzSpan = edgeHorz >= edgeVert;
    float edgeAround = ((edgeNS + edgeWE) * 2.0) + (edgeNWSW + edgeNESE);
    float edgeLoSide = edgeHorzSpan ? edgeN : edgeW;
    float edgeHiSide = edgeHorzSpan ? edgeS : edgeE;
    float edgeGradLo = edgeLoSide - edgeM;
    float edgeGradHi = edgeHiSide - edgeM;
    bool edgeLoSteeper = abs(edgeGradLo) >= abs(edgeGradHi);
    float edgeGradient = max(abs(edgeGradLo), abs(edgeGradHi));
    float _352;
    if (edgeLoSteeper)
    {
        _352 = edgeLoSide + edgeM;
    }
    else
    {
        _352 = edgeHiSide + edgeM;
    }
    float edgePair = _352;
    ivec2 edgeAcross = mix(ivec2(1, 0), ivec2(0, 1), bvec2(edgeHorzSpan));
    ivec2 edgeAlong = mix(ivec2(0, 1), ivec2(1, 0), bvec2(edgeHorzSpan));
    if (edgeLoSteeper)
    {
        edgeAcross = -edgeAcross;
    }
    float edgeInvSpan = inversesqrt(edgeSpan * edgeSpan);
    float edgeBlendC = clamp(abs((edgeAround * 0.083333335816860198974609375) - edgeM) * edgeInvSpan, 0.0, 1.0);
    float edgeBlendF = (((-2.0) * edgeBlendC) + 3.0) * (edgeBlendC * edgeBlendC);
    float edgeSubpixel = (edgeBlendF * edgeBlendF) * 0.75;
    float edgeHalfPair = edgePair * 0.5;
    float edgeScaled = edgeGradient * 0.25;
    bool edgeMidNegative = (edgeM - edgeHalfPair) < 0.0;
    ivec2 param_9 = px - edgeAlong;
    ivec2 param_10 = edgeAcross;
    float edgeEndN = edgeMidLuma(param_9, param_10) - edgeHalfPair;
    ivec2 param_11 = px + edgeAlong;
    ivec2 param_12 = edgeAcross;
    float edgeEndP = edgeMidLuma(param_11, param_12) - edgeHalfPair;
    bool edgeDoneN = abs(edgeEndN) >= edgeScaled;
    bool edgeDoneP = abs(edgeEndP) >= edgeScaled;
    int edgeStepsN = 1;
    int edgeStepsP = 1;
    for (int i = 2; i <= 12; i++)
    {
        if (!edgeDoneN)
        {
            ivec2 param_13 = px - (edgeAlong * ivec2(i));
            ivec2 param_14 = edgeAcross;
            edgeEndN = edgeMidLuma(param_13, param_14) - edgeHalfPair;
            edgeDoneN = abs(edgeEndN) >= edgeScaled;
            edgeStepsN = i;
        }
        if (!edgeDoneP)
        {
            ivec2 param_15 = px + (edgeAlong * ivec2(i));
            ivec2 param_16 = edgeAcross;
            edgeEndP = edgeMidLuma(param_15, param_16) - edgeHalfPair;
            edgeDoneP = abs(edgeEndP) >= edgeScaled;
            edgeStepsP = i;
        }
        if (edgeDoneN && edgeDoneP)
        {
            break;
        }
    }
    bool edgeTowardN = edgeStepsN < edgeStepsP;
    float edgeEndG = edgeTowardN ? edgeEndN : edgeEndP;
    bool edgeGoodSpan = (edgeEndG < 0.0) != edgeMidNegative;
    float edgeSpanLen = float(edgeStepsN + edgeStepsP);
    float edgeNear = float(edgeTowardN ? edgeStepsN : edgeStepsP);
    float _539;
    if (edgeGoodSpan)
    {
        _539 = 0.5 - (edgeNear * inversesqrt(edgeSpanLen * edgeSpanLen));
    }
    else
    {
        _539 = 0.0;
    }
    float edgeStepBlend = _539;
    float edgeBlend = clamp(max(edgeStepBlend, edgeSubpixel), 0.0, 1.0);
    ivec2 param_17 = px + edgeAcross;
    vec3 edgeAcrossColor = sampleCurrent(param_17).xyz;
    return vec4((centerColor.xyz * (1.0 - edgeBlend)) + (edgeAcrossColor * edgeBlend), centerColor.w);
}

float storeLinearDepth(float z)
{
    float denominator = pc.zNear + (z * (pc.zFar - pc.zNear));
    return (pc.zNear * pc.zFar) * inversesqrt(denominator * denominator);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, ivec2(pc.extent))))
    {
        return;
    }
    vec4 current = texelFetch(currentColor, pixel, 0);
    vec4 param = current;
    vec4 _632;
    if (finite4(param))
    {
        ivec2 param_1 = pixel;
        vec4 param_2 = current;
        _632 = spatialEdgeFilter(param_1, param_2);
    }
    else
    {
        _632 = vec4(0.0);
    }
    vec4 result = _632;
    vec4 param_3 = result;
    if (!finite4(param_3))
    {
        result = vec4(0.0);
    }
    imageStore(bootstrapColor, pixel, result);
    imageStore(historyOutColor, pixel, vec4(result.xyz, 1.0));
    float param_4 = texelFetch(currentDeviceDepth, pixel, 0).x;
    imageStore(historyOutLinearDepth, pixel, vec4(storeLinearDepth(param_4)));
}


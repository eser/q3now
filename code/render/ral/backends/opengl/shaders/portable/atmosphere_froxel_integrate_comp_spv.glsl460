#version 460
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, std140) uniform Params
{
    uvec4 gridHistory;
    vec4 depthRangeTemporal;
} p;

layout(binding = 0, std430) readonly buffer LitMedia
{
    vec4 source[];
} _117;

layout(binding = 1, std430) readonly buffer History
{
    vec4 previous[];
} _175;

layout(binding = 2, std430) writeonly buffer Integrated
{
    vec4 integrated[];
} _185;

layout(binding = 3, std430) writeonly buffer NextHistory
{
    vec4 nextHistory[];
} _192;

void main()
{
    uvec2 c = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(c, p.gridHistory.xy)))
    {
        return;
    }
    uint sliceStride = p.gridHistory.x * p.gridHistory.y;
    float transmittance = 1.0;
    vec3 radiance = vec3(0.0);
    float nearZ = max(p.depthRangeTemporal.x, 0.00999999977648258209228515625);
    float farZ = max(p.depthRangeTemporal.y, nearZ + 0.00999999977648258209228515625);
    float previousZ = nearZ;
    for (uint z = 0u; z < p.gridHistory.z; z++)
    {
        uint index = ((z * sliceStride) + (c.y * p.gridHistory.x)) + c.x;
        float slice = (float(z) + 1.0) / float(p.gridHistory.z);
        float currentZ = nearZ * pow(farZ / nearZ, slice);
        float stepLength = currentZ - previousZ;
        vec4 m = _117.source[index];
        float stepT = exp((-max(m.w, 0.0)) * stepLength);
        radiance += (((m.xyz * transmittance) * (1.0 - stepT)) / vec3(max(m.w, 9.9999997473787516355514526367188e-06)));
        transmittance *= stepT;
        vec4 current = vec4(radiance, transmittance);
        if (p.gridHistory.w != 0u)
        {
            float weight = clamp(p.depthRangeTemporal.z, 0.0, 0.980000019073486328125) * (1.0 - clamp(p.depthRangeTemporal.w, 0.0, 1.0));
            current = mix(current, _175.previous[index], vec4(weight));
        }
        _185.integrated[index] = current;
        _192.nextHistory[index] = current;
        previousZ = currentZ;
    }
}


#version 460

layout(constant_id = 16) const int ENTITY_SSBO = 0;
const bool _15 = (ENTITY_SSBO != 0);

layout(binding = 0, std430) readonly buffer EntityMatrices
{
    mat4 entMat[];
} _22;

layout(binding = 0, std140) uniform UBO
{
    vec4 eyePos;
    vec4 lightPos;
    vec4 lightColor;
    vec4 lightVector;
    vec4 _pad_to_mvp[26];
    mat4 mvp;
} ubo;

layout(location = 0) in vec3 in_position;
layout(location = 0) out vec2 frag_tex_coord;
layout(location = 1) in vec2 in_tex_coord;
layout(location = 1) out vec3 N;
layout(location = 2) in vec3 in_normal;
layout(location = 2) out vec4 L;
layout(location = 3) out vec4 V;
layout(location = 5) out vec3 frag_position;

void main()
{
    mat4 _16;
    if (_15)
    {
        _16 = _22.entMat[gl_InstanceIndex * 2];
    }
    else
    {
        _16 = ubo.mvp;
    }
    mat4 mvp = _16;
    gl_Position = mvp * vec4(in_position, 1.0);
    frag_tex_coord = in_tex_coord;
    N = in_normal;
    L = ubo.lightPos - vec4(in_position, 1.0);
    V = ubo.eyePos - vec4(in_position, 1.0);
    frag_position = in_position;
}


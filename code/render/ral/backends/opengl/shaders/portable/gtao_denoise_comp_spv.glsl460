#version 460
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(std140, binding = 4) uniform DenoisePush
{
    vec2 viewportSize;
    float zNear;
    float zFar;
} pc;

layout(binding = 0) uniform texture2D depthTex;
layout(binding = 0) uniform sampler depthSampler;
layout(binding = 0, r16f) uniform readonly image2D aoIn;
layout(binding = 1, r16f) uniform writeonly image2D aoOut;

shared vec2 tile[144];

float linearizeDepth(float z)
{
    return (pc.zNear * pc.zFar) / (pc.zNear + (z * (pc.zFar - pc.zNear)));
}

float linearAt(ivec2 p)
{
    vec2 uv = (vec2(p) + vec2(0.5)) / pc.viewportSize;
    float param = textureLod(sampler2D(depthTex, depthSampler), uv, 0.0).x;
    return linearizeDepth(param);
}

void main()
{
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dim = ivec2(pc.viewportSize);
    ivec2 origin = (ivec2(gl_WorkGroupID.xy) * ivec2(8)) - ivec2(2);
    for (uint i = gl_LocalInvocationIndex; i < 144u; i += 64u)
    {
        ivec2 q = clamp(origin + ivec2(int(i % 12u), int(i / 12u)), ivec2(0), dim - ivec2(1));
        ivec2 param = q;
        tile[i] = vec2(imageLoad(aoIn, q).x, linearAt(param));
    }
    barrier();
    bool _156 = pix.x >= dim.x;
    bool _166;
    if (!_156)
    {
        _166 = pix.y >= dim.y;
    }
    else
    {
        _166 = _156;
    }
    if (_166)
    {
        return;
    }
    ivec2 local = ivec2(gl_LocalInvocationID.xy) + ivec2(2);
    int center = (local.y * 12) + local.x;
    float centerLin = tile[center].y;
    float depthScale = 1.0 / max(centerLin * 0.0500000007450580596923828125, 0.001000000047497451305389404296875);
    float sum = 0.0;
    float wsum = 0.0;
    for (int dy = -2; dy <= 2; dy++)
    {
        for (int dx = -2; dx <= 2; dx++)
        {
            vec2 sampleValue = tile[(center + (dy * 12)) + dx];
            float ao = sampleValue.x;
            float dl = sampleValue.y;
            float wd = exp((-float((dx * dx) + (dy * dy))) * 0.5);
            float ddiff = abs(dl - centerLin) * depthScale;
            float we = exp((-ddiff) * ddiff);
            float w = wd * we;
            sum += (ao * w);
            wsum += w;
        }
    }
    float _276;
    if (wsum > 9.9999997473787516355514526367188e-06)
    {
        _276 = sum / wsum;
    }
    else
    {
        _276 = tile[center].x;
    }
    float result = _276;
    imageStore(aoOut, pix, vec4(result));
}


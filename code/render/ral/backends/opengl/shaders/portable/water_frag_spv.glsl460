    vec2 ripple = rippleNoise(param);
    vec2 refractionUV = clamp(screenUV + (ripple * distortion_scale), vec2(0.001000000047497451305389404296875), vec2(0.999000012874603271484375));
    uint _241 = _180.packed_indices[1].z & 4095u;
    uint _248 = (_180.packed_indices[1].z >> uint(12)) & 255u;
    vec3 refraction = texture(sampler2D(wired_bindless_images[_241], wired_bindless_samplers[_248]), refractionUV).xyz;
    uint _260 = _180.packed_indices[0].x & 4095u;
    uint _267 = (_180.packed_indices[0].x >> uint(12)) & 255u;
    vec4 waterTex = texture(sampler2D(wired_bindless_images[_260], wired_bindless_samplers[_267]), frag_tex_coord);

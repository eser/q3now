layout(location = 0) centroid in vec2 frag_tex_coord;
layout(location = 3) in vec4 V;
layout(location = 1) in vec3 N;
layout(location = 2) in vec4 L;
layout(location = 0) out vec4 out_color;

float hash(vec2 p)
{
    return fract(sin(dot(p, vec2(127.09999847412109375, 311.70001220703125))) * 43758.546875);
}

float _noise(vec2 p)
{
    vec2 i = floor(p);
    vec2 f = fract(p);
    f = (f * f) * (vec2(3.0) - (f * 2.0));
    vec2 param = i;
    vec2 param_1 = i + vec2(1.0, 0.0);
    vec2 param_2 = i + vec2(0.0, 1.0);
    vec2 param_3 = i + vec2(1.0);
    return mix(mix(hash(param), hash(param_1), f.x), mix(hash(param_2), hash(param_3), f.x), f.y);
}

vec2 rippleNoise(vec2 uv)
{
    vec2 param = uv * 6.0;
    vec2 param_1 = uv * 12.0;
    vec2 n;
    n.x = (_noise(param) * 0.60000002384185791015625) + (_noise(param_1) * 0.300000011920928955078125);
    vec2 param_2 = (uv * 6.0) + vec2(43.0);
    vec2 param_3 = (uv * 12.0) + vec2(43.0);
    n.y = (_noise(param_2) * 0.60000002384185791015625) + (_noise(param_3) * 0.300000011920928955078125);
    return (n - vec2(0.5)) * 2.0;
}

vec3 sRGBToLinear(inout vec3 c)
{
    c = max(c, vec3(0.0));
    bvec3 cutoff = lessThanEqual(c, vec3(0.040449999272823333740234375));
    vec3 lo = c / vec3(12.9200000762939453125);
    vec3 hi = pow((c + vec3(0.054999999701976776123046875)) / vec3(1.05499994754791259765625), vec3(2.400000095367431640625));
    return mix(hi, lo, vec3(cutoff));
}

void main()
{
    uint _189 = _180.packed_indices[1].z & 4095u;
    uint _203 = (_180.packed_indices[1].z >> uint(12)) & 255u;

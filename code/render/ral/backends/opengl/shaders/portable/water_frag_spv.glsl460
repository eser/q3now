    float fresnel = 1.0 - abs(dot(normalize(N), nV));
    fresnel *= fresnel;
    vec3 tinted = mix(refraction, waterColor, vec3(tint_strength));
    vec3 finalColor = mix(tinted, waterColor * 1.2999999523162841796875, vec3(fresnel * 0.60000002384185791015625));
    vec3 nL = normalize(L.xyz);
    vec3 halfVec = normalize(nL + nV);
    float spec = pow(max(dot(normalize(N), halfVec), 0.0), specular_power);

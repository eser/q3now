#version 460

layout(constant_id = 19) const float cg_tint_r = 1.0;
layout(constant_id = 20) const float cg_tint_g = 1.0;
layout(constant_id = 21) const float cg_tint_b = 1.0;
layout(constant_id = 22) const float cg_saturation = 1.0;
layout(constant_id = 23) const float cg_contrast = 1.0;
layout(constant_id = 24) const float chromatic_strength = 0.0;
layout(constant_id = 2) const float saturation = 1.0;
layout(constant_id = 12) const int hdr_mode = 0;
layout(constant_id = 13) const float hdr_peak_norm = 10.0;

layout(binding = 0, std140) uniform ExposureBlock
{
    float exposure_bias;
    float key;
    float pctLow;
    float pctHigh;
    float rateUp;
    float rateDown;
    float minExp;
    float maxExp;
    int autoEnabled;
    float brightness;
    float sunScreenX;
    float sunScreenY;
    float sunrayIntensity;
    float sunrayDecay;
} eb;

layout(binding = 0) uniform sampler2D texture0;

layout(location = 0) in vec2 frag_tex_coord;
layout(location = 0) out vec4 out_color;

vec3 sampleChromatic(vec2 uv)
{
    vec2 dir = uv - vec2(0.5);
    float radial = length(dir);
    vec2 offset = dir * ((chromatic_strength * radial) * 0.014999999664723873138427734375);
    float r = texture(texture0, clamp(uv + offset, vec2(0.0), vec2(1.0))).x;
    float g = texture(texture0, uv).y;
    float b = texture(texture0, clamp(uv - offset, vec2(0.0), vec2(1.0))).z;
    return vec3(r, g, b);
}

vec3 applyColorGrading(inout vec3 color)
{
    vec3 colorGradeTint;
    colorGradeTint.x = cg_tint_r;
    colorGradeTint.y = cg_tint_g;
    colorGradeTint.z = cg_tint_b;
    color *= colorGradeTint;
    float luma = dot(color, vec3(0.2125999927520751953125, 0.715200006961822509765625, 0.072200000286102294921875));
    color = mix(vec3(luma), color, vec3(cg_saturation));
    color = ((color - vec3(0.5)) * cg_contrast) + vec3(0.5);
    return clamp(color, vec3(0.0), vec3(1.0));
}

void main()
{
    vec3 _117;
    if (chromatic_strength > 0.0)
    {
        vec2 param = frag_tex_coord;
        _117 = sampleChromatic(param);
    }
    else
    {
        _117 = texture(texture0, frag_tex_coord).xyz;
    }
    vec3 base = _117;
    base *= eb.exposure_bias;
    vec3 param_1 = base;
    vec3 _143 = applyColorGrading(param_1);
    base = _143;
    if (saturation != 1.0)
    {
        vec3 luma = vec3(dot(base, vec3(0.2125999927520751953125, 0.715200006961822509765625, 0.072200000286102294921875)));
        base = mix(luma, base, vec3(saturation));
    }
    out_color = vec4(base, 1.0);
}


#version 460
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, rgba16f) uniform writeonly image2DArray skyImage;

vec3 cubeFaceDir(uint face, vec2 uv)
{
    float u = uv.x;
    float v = uv.y;
    vec3 dir;
    if (face == 0u)
    {
        dir = vec3(1.0, -v, -u);
    }
    else
    {
        if (face == 1u)
        {
            dir = vec3(-1.0, -v, u);
        }
        else
        {
            if (face == 2u)
            {
                dir = vec3(u, 1.0, v);
            }
            else
            {
                if (face == 3u)
                {
                    dir = vec3(u, -1.0, -v);
                }
                else
                {
                    if (face == 4u)
                    {
                        dir = vec3(u, -v, 1.0);
                    }
                    else
                    {
                        dir = vec3(-u, -v, -1.0);
                    }
                }
            }
        }
    }
    return normalize(dir);
}

vec3 analyticSky(vec3 dir)
{
    float up = dir.y;
    vec3 sky;
    if (up >= 0.0)
    {
        float t = smoothstep(0.0, 1.0, up);
        sky = mix(vec3(0.12999999523162841796875, 0.1500000059604644775390625, 0.180000007152557373046875), vec3(0.04500000178813934326171875, 0.0900000035762786865234375, 0.189999997615814208984375), vec3(t));
    }
    else
    {
        float t_1 = smoothstep(0.0, -0.3499999940395355224609375, up);
        sky = mix(vec3(0.12999999523162841796875, 0.1500000059604644775390625, 0.180000007152557373046875), vec3(0.04500000178813934326171875, 0.039999999105930328369140625, 0.034000001847743988037109375), vec3(t_1));
    }
    float sd = max(dot(dir, vec3(0.3999000489711761474609375, 0.819795072078704833984375, 0.4098975360393524169921875)), 0.0);
    float lobe = pow(sd, 320.0);
    if (up > 0.0)
    {
        sky += (vec3(1.2999999523162841796875, 1.0499999523162841796875, 0.699999988079071044921875) * lobe);
    }
    return sky;
}

void main()
{
    uvec2 size = uvec2(imageSize(skyImage).xy);
    ivec3 coord = ivec3(gl_GlobalInvocationID);
    bool _179 = uint(coord.x) >= size.x;
    bool _189;
    if (!_179)
    {
        _189 = uint(coord.y) >= size.y;
    }
    else
    {
        _189 = _179;
    }
    bool _198;
    if (!_189)
    {
        _198 = uint(coord.z) >= 6u;
    }
    else
    {
        _198 = _189;
    }
    if (_198)
    {
        return;
    }
    vec2 uv = (((vec2(coord.xy) + vec2(0.5)) / vec2(size)) * 2.0) - vec2(1.0);
    uint param = uint(coord.z);
    vec2 param_1 = uv;
    vec3 dir = cubeFaceDir(param, param_1);
    vec3 param_2 = dir;
    vec3 radiance = analyticSky(param_2);
    imageStore(skyImage, coord, vec4(radiance, 1.0));
}


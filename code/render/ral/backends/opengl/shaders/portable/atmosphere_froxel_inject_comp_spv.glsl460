#version 460
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

struct MediaVolume
{
    vec4 originRadius;
    vec4 extentShape;
    vec4 albedoAnisotropy;
    vec4 emissiveIntensity;
    vec4 media;
};

layout(binding = 0, std140) uniform Params
{
    mat4 invViewProjection;
    vec4 eyeNear;
    vec4 farGlobalDensity;
    vec4 globalAlbedoAnisotropy;
    uvec4 gridVolumeCount;
    vec4 timelineSeed;
} p;

layout(binding = 0, std430) readonly buffer Volumes
{
    MediaVolume v[];
} _305;

layout(binding = 1, std430) writeonly buffer Media
{
    vec4 scatteringExtinction[];
} _359;

float hash13(inout vec3 q)
{
    q = fract(q * 0.103100001811981201171875);
    q += vec3(dot(q, q.yzx + vec3(33.3300018310546875)));
    return fract((q.x + q.y) * q.z);
}

float volumeWeight(MediaVolume m, vec3 world)
{
    vec3 local = world - m.originRadius.xyz;
    float shape = m.extentShape.w;
    float _70;
    if (shape < 1.5)
    {
        _70 = 1.0 - smoothstep(m.originRadius.w * 0.85000002384185791015625, m.originRadius.w, length(local));
    }
    else
    {
        _70 = 1.0 - smoothstep(0.85000002384185791015625, 1.0, max(max(abs(local.x) / m.extentShape.x, abs(local.y) / m.extentShape.y), abs(local.z) / m.extentShape.z));
    }
    float weight = _70;
    if (m.media.z > 0.0)
    {
        vec3 param = (world / vec3(m.media.z)) + vec3(p.timelineSeed.x, p.timelineSeed.y, p.timelineSeed.w);
        float _137 = hash13(param);
        weight *= mix(0.550000011920928955078125, 1.0, _137);
    }
    return max(weight, 0.0) * exp((-max(m.media.y, 0.0)) * max(world.z - m.originRadius.z, 0.0));
}

void main()
{
    uvec3 c = gl_GlobalInvocationID;
    uvec3 dims = p.gridVolumeCount.xyz;
    if (any(greaterThanEqual(c, dims)))
    {
        return;
    }
    uint index = (((c.z * dims.y) + c.y) * dims.x) + c.x;
    vec2 uv = (vec2(c.xy) + vec2(0.5)) / vec2(dims.xy);
    float slice = (float(c.z) + 0.5) / float(dims.z);
    float nearZ = max(p.eyeNear.w, 0.00999999977648258209228515625);
    float farZ = max(p.farGlobalDensity.x, nearZ + 0.00999999977648258209228515625);
    float distanceZ = nearZ * pow(farZ / nearZ, slice);
    vec4 worldH = p.invViewProjection * vec4((uv * 2.0) - vec2(1.0), 1.0 - (nearZ / distanceZ), 1.0);
    vec3 world = worldH.xyz / vec3(max(abs(worldH.w), 9.9999999747524270787835121154785e-07));
    float extinction = max(p.farGlobalDensity.y, 0.0) * exp((-max(p.farGlobalDensity.z, 0.0)) * max(world.z, 0.0));
    vec3 scattering = p.globalAlbedoAnisotropy.xyz * extinction;
    uint count = min(p.gridVolumeCount.w, 64u);
    MediaVolume param;
    for (uint i = 0u; i < count; i++)
    {
        param.originRadius = _305.v[i].originRadius;
        param.extentShape = _305.v[i].extentShape;
        param.albedoAnisotropy = _305.v[i].albedoAnisotropy;
        param.emissiveIntensity = _305.v[i].emissiveIntensity;
        param.media = _305.v[i].media;
        vec3 param_1 = world;
        float weight = volumeWeight(param, param_1);
        float localExtinction = max(_305.v[i].media.x, 0.0) * weight;
        extinction += localExtinction;
        scattering += ((_305.v[i].albedoAnisotropy.xyz * localExtinction) + ((_305.v[i].emissiveIntensity.xyz * max(_305.v[i].emissiveIntensity.w, 0.0)) * weight));
    }
    _359.scatteringExtinction[index] = vec4(scattering, extinction);
}


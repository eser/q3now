#version 460
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, std140) uniform Params
{
    uvec4 outputGrid;
    vec4 depthRange;
    mat4 invViewProjection;
    vec4 eyeSkyControl;
    vec4 radianceControl;
    vec4 mediaColorDensity;
    vec4 mediaHeight;
} p;

layout(binding = 2) uniform sampler2D skyViewLut;
layout(binding = 3) uniform samplerCube currentSkyRadiance;
layout(binding = 0) uniform sampler2D sceneHdr;
layout(binding = 1) uniform sampler2D sceneDepth;
layout(binding = 0, rgba16f) uniform writeonly image2D composedHdr;
layout(binding = 4) uniform samplerCube previousSkyRadiance;

vec3 skyDirection(vec2 screenUv)
{
    vec4 worldH = p.invViewProjection * vec4((screenUv * 2.0) - vec2(1.0), 0.0, 1.0);
    vec3 world = worldH.xyz / vec3(max(abs(worldH.w), 9.9999999747524270787835121154785e-07));
    return normalize(world - p.eyeSkyControl.xyz);
}

vec2 skyViewUv(vec3 direction)
{
    float azimuth = atan(direction.y, direction.x);
    float elevation = asin(clamp(direction.z, -1.0, 1.0));
    return vec2(fract((azimuth / 6.283185482025146484375) + 0.5), clamp((elevation / 3.1415927410125732421875) + 0.5, 0.0, 1.0));
}

vec3 wiredComposeAuthoredPhysicalSky(vec3 authored, vec3 physical, float blend)
{
    float authoredEnergy = dot(max(authored, vec3(0.0)), vec3(0.2125999927520751953125, 0.715200006961822509765625, 0.072200000286102294921875));
    float physicalEnergy = dot(max(physical, vec3(0.0)), vec3(0.2125999927520751953125, 0.715200006961822509765625, 0.072200000286102294921875));
    if (authoredEnergy <= 9.9999997473787516355514526367188e-06)
    {
        return mix(authored, physical, vec3(blend));
    }
    float scale = clamp(physicalEnergy / max(authoredEnergy, 0.180000007152557373046875), 0.64999997615814208984375, 1.75);
    vec3 _279;
    if (physicalEnergy > 9.9999997473787516355514526367188e-06)
    {
        _279 = physical / vec3(physicalEnergy);
    }
    else
    {
        _279 = vec3(1.0);
    }
    vec3 physicalTint = _279;
    vec3 relit = ((authored * scale) * mix(vec3(1.0), clamp(physicalTint, vec3(0.5), vec3(2.0)), vec3(0.119999997317790985107421875))) + (physical * 0.07999999821186065673828125);
    return mix(authored, relit, vec3(blend));
}

vec3 wiredAerialInscatter(vec3 mediaColor, vec3 viewDir)
{
    float aerial = clamp(p.mediaHeight.w, 0.0, 1.0);
    if (aerial <= 0.0)
    {
        return mediaColor;
    }
    vec3 _123;
    if (p.eyeSkyControl.w > 0.0)
    {
        vec3 param = viewDir;
        _123 = textureLod(skyViewLut, skyViewUv(param), 0.0).xyz;
    }
    else
    {
        _123 = textureLod(currentSkyRadiance, viewDir, 4.0).xyz;
    }
    vec3 skyIn = _123;
    vec3 skySum = ((((textureLod(currentSkyRadiance, vec3(1.0, 0.0, 0.0), 7.0).xyz + textureLod(currentSkyRadiance, vec3(-1.0, 0.0, 0.0), 7.0).xyz) + textureLod(currentSkyRadiance, vec3(0.0, 1.0, 0.0), 7.0).xyz) + textureLod(currentSkyRadiance, vec3(0.0, -1.0, 0.0), 7.0).xyz) + textureLod(currentSkyRadiance, vec3(0.0, 0.0, 1.0), 7.0).xyz) + textureLod(currentSkyRadiance, vec3(0.0, 0.0, -1.0), 7.0).xyz;
    float skyMean = max(dot(skySum / vec3(6.0), vec3(0.2125999927520751953125, 0.715200006961822509765625, 0.072200000286102294921875)), 9.9999997473787516355514526367188e-05);
    vec3 directional = skyIn / vec3(skyMean);
    vec3 sunDir = normalize(vec3(p.depthRange.w, p.radianceControl.w, p.mediaHeight.z) + vec3(9.9999999747524270787835121154785e-07));
    float cosT = dot(viewDir, sunDir);
    float hg = 0.6974999904632568359375 / max(pow(1.3025000095367431640625 - (1.10000002384185791015625 * cosT), 1.5), 9.9999997473787516355514526367188e-05);
    vec3 tinted = mediaColor * mix(vec3(1.0), clamp(directional, vec3(0.3499999940395355224609375), vec3(3.0)), vec3(aerial));
    return tinted * mix(1.0, 0.75 + (0.25 * hg), aerial);
}

void main()
{
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(pixel, p.outputGrid.xy)))
    {
        return;
    }
    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(p.outputGrid.xy);
    vec3 scene = textureLod(sceneHdr, uv, 0.0).xyz;
    float _351;
    if (p.depthRange.z > 0.5)
    {
        _351 = textureLod(sceneDepth, uv, 0.0).x;
    }
    else
    {
        _351 = 1.0;
    }
    float depth = _351;
    if (depth <= 0.0)
    {
        vec2 param = uv;
        vec3 direction = skyDirection(param);
        if (p.eyeSkyControl.w > 0.0)
        {
            vec3 param_1 = direction;
            vec3 physicalSky = textureLod(skyViewLut, skyViewUv(param_1), 0.0).xyz;
            vec3 param_2 = scene;
            vec3 param_3 = physicalSky;
            float param_4 = clamp(p.eyeSkyControl.w, 0.0, 1.0);
            scene = wiredComposeAuthoredPhysicalSky(param_2, param_3, param_4);
        }
    }
    else
    {
        bool _393 = p.depthRange.z > 0.5;
        bool _400;
        if (_393)
        {
            _400 = p.mediaColorDensity.w > 0.0;
        }
        else
        {
            _400 = _393;
        }
        if (_400)
        {
            vec4 worldH = p.invViewProjection * vec4((uv * 2.0) - vec2(1.0), depth, 1.0);
            if (abs(worldH.w) > 9.9999999747524270787835121154785e-07)
            {
                vec3 world = worldH.xyz / vec3(worldH.w);
                float distanceToEye = length(world - p.eyeSkyControl.xyz);
                float heightWeight = exp((-p.mediaHeight.y) * max(world.z - p.mediaHeight.x, 0.0));
                float transmittance = exp(((-p.mediaColorDensity.w) * heightWeight) * distanceToEye);
                vec3 param_5 = p.mediaColorDensity.xyz;
                vec3 param_6 = normalize(world - p.eyeSkyControl.xyz);
                vec3 inscatter = wiredAerialInscatter(param_5, param_6);
                scene = mix(inscatter, scene, vec3(clamp(transmittance, 0.0, 1.0)));
            }
        }
    }
    imageStore(composedHdr, ivec2(pixel), vec4(scene, 1.0));
}


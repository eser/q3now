#version 450

// H4 history commit Store. The exact H2 producer target is either the bootstrap
// current-scene copy or H3's resolved feedback; this shader stores that target
// plus the same frame's current linear depth into the staged write slot. It
// does not recursively transform depth or claim a post-bloom source.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform texture2D currentColor;
layout(set = 0, binding = 1) uniform texture2D currentDeviceDepth;
layout(set = 0, binding = 2) uniform sampler nearestSampler;
layout(rgba16f, set = 0, binding = 3) uniform writeonly image2D outputColor;
layout(r32f, set = 0, binding = 4) uniform writeonly image2D outputLinearDepth;

layout(push_constant) uniform TemporalHistoryPush {
	uvec2 extent;
	float zNear;
	float zFar;
} pc;

float linearizeDepth(float z) {
	return pc.zNear * pc.zFar / (pc.zNear + z * (pc.zFar - pc.zNear));
}

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(pixel, ivec2(pc.extent)))) return;
	vec4 color = texelFetch(sampler2D(currentColor, nearestSampler), pixel, 0);
	float depth = linearizeDepth(texelFetch(
		sampler2D(currentDeviceDepth, nearestSampler), pixel, 0).r);
	imageStore(outputColor, pixel, color);
	imageStore(outputLinearDepth, pixel, vec4(depth));
}

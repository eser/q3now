#version 450

/*
forwardplus_tile.comp — tiled-lighting tile classification (a cull.comp sibling).

Divides the screen into fixed tiles (TILE_SIZE px) and, per tile, builds the
tile's view frustum (4 side planes from the tile's screen rect, in world space,
plus a near/far slab from the per-tile depth bounds) and culls the dynamic light
list (each light = a world-space sphere {origin, radius}) against it. The
survivors are written to a per-tile light-index list (fixed stride per tile):
  tileLights[tileBase + 0]              = this tile's light count (clamped)
  tileLights[tileBase + 1 .. + count]   = the surviving light indices
The lit fragment shader computes its tile from gl_FragCoord, reads this tile's
list, and iterates ONLY those lights (the per-light intens + BRDF math is the
same as the per-light-pass PMLIGHT path — only the GATHER changes).

One thread per tile scans the total scene light list (up to MAX_LIGHTS, host
FP_MAX_LIGHTS — DECOUPLED from MAX_DLIGHTS, which caps only the PMLIGHT path) and
records the lights whose sphere reaches its tile. The WIN that makes a large scene
light count affordable: a fragment iterates only its tile's few lights (≤ MAX_LIGHTS_
PER_TILE, far below the total) instead of all of them — the tile cull is the whole
point. Two-phase compute→consume, WebGPU-portable (storage buffers + a screen-space
compute dispatch).

Bindings (set 0, all COMPUTE):
  0: Lights  SSBO (read)  — per-light { vec4 posRadius (xyz world origin, w radius),
                            vec4 color (rgb linear, w 1/r^2 falloff), vec4 posRadius2
                            (xyz second endpoint for a linear/tube light, w isLine) }
  1: Depth   SSBO (read)  — per-tile { float minDepth, float maxDepth } (reversed-Z
                            device depth; from the Z-prepass reduction). depthValid==0
                            in params → use the full [0,1] slab (no prepass this frame).
  2: TileLights SSBO (write) — per-tile light-index list (stride 1+MAX_LIGHTS_PER_TILE)
Push:
  mat4 invViewProj   — clip → world (to unproject the tile corners)
  vec4 params0       — x=screenW, y=screenH, z=tilesX, w=tilesY
  vec4 params1       — x=numLights, y=depthValid, z=zNear, w=zFar
*/

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#define TILE_SIZE 16
#define MAX_LIGHTS 256             // total scene lights (== host FP_MAX_LIGHTS, decoupled from MAX_DLIGHTS)
#define MAX_LIGHTS_PER_TILE 32     // per-tile list capacity (NOT the total cap — a tile sees few lights)

struct Light {
	vec4 posRadius;   // xyz = world origin, w = radius
	vec4 color;       // rgb = linear color, w = 1/r^2 falloff
	vec4 posRadius2;  // xyz = second endpoint (linear light), w = isLine (1.0/0.0)
};

layout(std430, set = 0, binding = 0) readonly buffer Lights {
	Light lights[];
};

layout(std430, set = 0, binding = 1) readonly buffer TileDepth {
	// 2 floats per tile: [2*t]=minDepth, [2*t+1]=maxDepth (reversed-Z device depth)
	float tileDepth[];
};

layout(std430, set = 0, binding = 2) buffer TileLights {
	// stride (1 + MAX_LIGHTS_PER_TILE) uints per tile: [0]=count, [1..]=indices
	uint tileLights[];
};

layout(push_constant) uniform Push {
	mat4 invViewProj;
	vec4 params0;   // x=screenW, y=screenH, z=tilesX, w=tilesY
	vec4 params1;   // x=numLights, y=depthValid, z=zNear, w=zFar
};

// Unproject an NDC point (xy in [-1,1], z device depth) to world space.
vec3 unproject(vec3 ndc) {
	vec4 w = invViewProj * vec4(ndc, 1.0);
	return w.xyz / w.w;
}

// Plane from 3 world points (CCW → normal points "inward" toward the frustum
// interior given the winding chosen below). Returns vec4(normal.xyz, -dot(n,p0)).
vec4 planeFromPoints(vec3 a, vec3 b, vec3 c) {
	vec3 n = normalize(cross(b - a, c - a));
	return vec4(n, -dot(n, a));
}

// Signed distance of a point to a plane (positive = inside, on the +normal side).
float planeDist(vec4 pl, vec3 p) {
	return dot(pl.xyz, p) + pl.w;
}

void main() {
	uint tx = gl_GlobalInvocationID.x;
	uint ty = gl_GlobalInvocationID.y;
	uint tilesX = uint(params0.z);
	uint tilesY = uint(params0.w);
	if (tx >= tilesX || ty >= tilesY) return;

	uint tileIndex = ty * tilesX + tx;
	uint outBase = tileIndex * (1u + uint(MAX_LIGHTS_PER_TILE));

	float screenW = params0.x;
	float screenH = params0.y;
	uint  numLights = uint(params1.x);
	bool  depthValid = params1.y != 0.0;

	// Tile screen rect → NDC rect. (gl_FragCoord origin is top-left in Vulkan, y
	// down; NDC y is up — flip so the tile's world frustum matches the fragment's
	// tile lookup, which uses the same pixel→tile mapping.)
	float x0 = float(tx * uint(TILE_SIZE));
	float y0 = float(ty * uint(TILE_SIZE));
	float x1 = min(x0 + float(TILE_SIZE), screenW);
	float y1 = min(y0 + float(TILE_SIZE), screenH);

	// pixel → NDC [-1,1]
	float ndcX0 = (x0 / screenW) * 2.0 - 1.0;
	float ndcX1 = (x1 / screenW) * 2.0 - 1.0;
	float ndcY0 = (y0 / screenH) * 2.0 - 1.0;
	float ndcY1 = (y1 / screenH) * 2.0 - 1.0;

	// Per-tile depth slab (reversed-Z: near=1.0, far=0.0). Use the prepass bounds
	// when present (tighter), else the full [0,1] range.
	float dMin = 0.0, dMax = 1.0;
	if (depthValid) {
		dMin = tileDepth[2u * tileIndex + 0u];   // far-most (smaller in reversed-Z)
		dMax = tileDepth[2u * tileIndex + 1u];   // near-most (larger in reversed-Z)
		// guard a degenerate (empty) tile — keep the full slab so we never wrongly
		// drop a light (correctness over tightness).
		if (dMax < dMin) { dMin = 0.0; dMax = 1.0; }
	}

	// 8 frustum corners (near slab dMax, far slab dMin) in world space.
	vec3 c[8];
	c[0] = unproject(vec3(ndcX0, ndcY0, dMax));
	c[1] = unproject(vec3(ndcX1, ndcY0, dMax));
	c[2] = unproject(vec3(ndcX1, ndcY1, dMax));
	c[3] = unproject(vec3(ndcX0, ndcY1, dMax));
	c[4] = unproject(vec3(ndcX0, ndcY0, dMin));
	c[5] = unproject(vec3(ndcX1, ndcY0, dMin));
	c[6] = unproject(vec3(ndcX1, ndcY1, dMin));
	c[7] = unproject(vec3(ndcX0, ndcY1, dMin));

	// 6 tile-frustum planes, normals oriented INWARD (a point inside has
	// planeDist >= 0 on all 6). Build each from 3 corners wound so the cross
	// product faces inward; the sign is fixed below by testing the tile centroid.
	vec3 tileCentroid = vec3(0.0);
	for (int i = 0; i < 8; i++) tileCentroid += c[i];
	tileCentroid *= 0.125;

	vec4 planes[6];
	planes[0] = planeFromPoints(c[0], c[3], c[4]); // left
	planes[1] = planeFromPoints(c[1], c[5], c[2]); // right
	planes[2] = planeFromPoints(c[0], c[4], c[1]); // top
	planes[3] = planeFromPoints(c[3], c[2], c[7]); // bottom
	planes[4] = planeFromPoints(c[0], c[1], c[3]); // near slab
	planes[5] = planeFromPoints(c[4], c[7], c[5]); // far slab
	// orient each plane so the centroid is on the +normal (inside) side
	for (int i = 0; i < 6; i++) {
		if (planeDist(planes[i], tileCentroid) < 0.0) planes[i] = -planes[i];
	}

	uint count = 0u;
	uint cap = min(uint(MAX_LIGHTS_PER_TILE), uint(MAX_LIGHTS));
	for (uint li = 0u; li < numLights && li < uint(MAX_LIGHTS); li++) {
		vec3  lp = lights[li].posRadius.xyz;
		float lr = lights[li].posRadius.w;
		if (lr <= 0.0) continue;

		// sphere-vs-frustum: inside iff the sphere isn't fully outside any plane
		// (sphere center distance < -radius → fully outside that plane). For a
		// linear/tube light, conservatively expand by the endpoint span: test a
		// sphere around the segment midpoint with radius = lr + half-length.
		vec3  center = lp;
		float radius = lr;
		if (lights[li].posRadius2.w != 0.0) {
			vec3 lp2 = lights[li].posRadius2.xyz;
			center = 0.5 * (lp + lp2);
			radius = lr + 0.5 * length(lp2 - lp);
		}

		bool inside = true;
		for (int p = 0; p < 6; p++) {
			if (planeDist(planes[p], center) < -radius) { inside = false; break; }
		}
		if (inside && count < cap) {
			tileLights[outBase + 1u + count] = li;
			count++;
		}
	}

	tileLights[outBase] = count;
}

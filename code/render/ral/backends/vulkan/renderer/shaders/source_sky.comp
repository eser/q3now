#version 450
#extension GL_GOOGLE_include_directive : require
#include "../../../../core/ral_sky_cube.glsl"

/*
source_sky.comp — wired-render map-authored sky environment source cube.

Fills a 6-face cube (as a 2D array storage image) from the shared sky receipt's
already-cooked Q3 outer cube faces. This is the SOURCE that the IBL convolve
later prefilters into the irradiance + radiance probe cubes. It deliberately
has no universal Earth-blue palette or fixed sun: each map remains the colour
and directional-light authority.

Ordered inner/cloud stages remain a separate follow-up consumer rather than
being approximated inside this radiance capture. Keep this shader's output
format (RGBA16F linear radiance, GL cube-face order) identical so downstream
SH/specular consumers remain asset-source-agnostic.

Vulkan compute cannot imageStore into an imageCube (that type is sampled-only),
so the storage target is an image2DArray of 6 layers in GL cube-face order
(+X,-X,+Y,-Y,+Z,-Z). A VK_IMAGE_VIEW_TYPE_CUBE sampled view over the same image
reinterprets the 6 layers as a cube for later sampling.
*/

const float PI = 3.14159265358979323846;

const float SUN_TIGHT   = 320.0;  // higher = tighter disk

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(rgba16f, set = 0, binding = 0) uniform writeonly image2DArray skyImage;
layout(set = 0, binding = 1) uniform texture2D authoredRt;
layout(set = 0, binding = 2) uniform texture2D authoredBk;
layout(set = 0, binding = 3) uniform texture2D authoredLf;
layout(set = 0, binding = 4) uniform texture2D authoredFt;
layout(set = 0, binding = 5) uniform texture2D authoredUp;
layout(set = 0, binding = 6) uniform texture2D authoredDn;
layout(set = 0, binding = 7) uniform sampler authoredSampler;

layout(push_constant) uniform Push {
	uvec4 meta;                  // face, selected mode, authored available, reserved
	vec4 authoredRadiance;       // rgb map-authored average, sky luminance
	vec4 sunDirectionIntensity;  // xyz world direction, scalar energy
	vec4 sunRadianceExposure;    // rgb linear radiance, exposure
} p;

// GL cube-face (layer) + face-uv → world direction. Layer order is the Vulkan
// cube-array convention (+X,-X,+Y,-Y,+Z,-Z); u,v are the face-local [-1,1].

vec3 analyticSky( vec3 dir )
{
	const vec3 luma = vec3( 0.2126, 0.7152, 0.0722 );
	vec3 authored = max( p.authoredRadiance.rgb, vec3( 0.002 ) );
	float authoredEnergy = max( dot( authored, luma ), 0.002 );
	vec3 authoredTint = authored / authoredEnergy;
	vec3 horizon = authored;
	vec3 zenith = authoredTint * authoredEnergy * 0.55;
	vec3 ground = authored * 0.18;

	// up = dir.z in [-1,1] in the engine's Z-up world. The source hemisphere
	// stays chromatically tied to the authored material rather than a global
	// clear-day preset.
	float up = dir.z;

	vec3 sky;
	if ( up >= 0.0 ) {
		float t = smoothstep( 0.0, 1.0, up );
		sky = mix( horizon, zenith, t );
	} else {
		// smoothstep requires ascending edges on every target language.
		// Negate the input instead: horizon=0, lower hemisphere=1.
		float t = smoothstep( 0.0, 0.35, -up );
		sky = mix( horizon, ground, t );
	}

	// Soft sun lobe (only above the horizon so the ground stays unlit).
	vec3 sunDirection = p.sunDirectionIntensity.xyz;
	float sunLength = length( sunDirection );
	float sd = sunLength > 1e-5
		? max( dot( dir, sunDirection / sunLength ), 0.0 ) : 0.0;
	float lobe = pow( sd, SUN_TIGHT );
	if ( up > 0.0 )
		sky += max( p.sunRadianceExposure.rgb, vec3( 0.0 ) )
			* max( p.sunDirectionIntensity.w, 0.0 ) * lobe;

	return max( sky, vec3( 0.0 ) );
}

vec3 authoredSky( vec3 dir )
{
	vec3 a = abs( dir );
	uint axis;
	vec2 st;
	if ( a.x >= a.y && a.x >= a.z ) {
		if ( dir.x >= 0.0 ) {
			axis = 0u; st = vec2( -dir.y, dir.z ) / a.x;
		} else {
			axis = 1u; st = vec2( dir.y, dir.z ) / a.x;
		}
	} else if ( a.y >= a.z ) {
		if ( dir.y >= 0.0 ) {
			axis = 2u; st = vec2( dir.x, dir.z ) / a.y;
		} else {
			axis = 3u; st = vec2( -dir.x, dir.z ) / a.y;
		}
	} else if ( dir.z >= 0.0 ) {
		axis = 4u; st = vec2( -dir.y, -dir.x ) / a.z;
	} else {
		axis = 5u; st = vec2( -dir.y, dir.x ) / a.z;
	}
	/* Match MakeSkyVec + sky_texorder exactly.  Q3 authored face order is
	 * rt,bk,lf,ft,up,dn while the geometric axis order is +X,-X,+Y,-Y,+Z,-Z. */
	vec2 uv = vec2( st.x * 0.5 + 0.5, 0.5 - st.y * 0.5 );
	if ( axis == 0u ) return texture( sampler2D( authoredRt, authoredSampler ), uv ).rgb;
	if ( axis == 1u ) return texture( sampler2D( authoredLf, authoredSampler ), uv ).rgb;
	if ( axis == 2u ) return texture( sampler2D( authoredBk, authoredSampler ), uv ).rgb;
	if ( axis == 3u ) return texture( sampler2D( authoredFt, authoredSampler ), uv ).rgb;
	if ( axis == 4u ) return texture( sampler2D( authoredUp, authoredSampler ), uv ).rgb;
	return texture( sampler2D( authoredDn, authoredSampler ), uv ).rgb;
}

void main()
{
	uvec2 size  = uvec2( imageSize( skyImage ).xy );
	uint face = p.meta.x;
	ivec3 coord = ivec3( gl_GlobalInvocationID.xy, int( face ) );
	if ( uint( coord.x ) >= size.x || uint( coord.y ) >= size.y || face >= 6u )
		return;

	// Face-local uv at the texel centre, mapped to [-1,1].
	vec2 uv = ( ( vec2( coord.xy ) + 0.5 ) / vec2( size.xy ) ) * 2.0 - 1.0;
	vec3 dir = wired_sky_cube_direction( face, uv );

	vec3 radiance = p.meta.w != 0u
		? max( authoredSky( dir ), vec3( 0.0 ) )
		: analyticSky( dir );
	/* Physical mode preserves the authored environment but still layers the
	 * map-authored q3map_sun energy into the radiance product. */
	if ( p.meta.w != 0u ) {
		vec3 sunDirection = p.sunDirectionIntensity.xyz;
		float sunLength = length( sunDirection );
		float sd = sunLength > 1e-5
			? max( dot( dir, sunDirection / sunLength ), 0.0 ) : 0.0;
		radiance += max( p.sunRadianceExposure.rgb, vec3( 0.0 ) )
			* max( p.sunDirectionIntensity.w, 0.0 ) * pow( sd, SUN_TIGHT );
	}
	// Apply exposure once to the complete environment, including its sun.
	// Both source paths must feed the same radiance scale to SH and IBL.
	radiance *= clamp( p.sunRadianceExposure.w, 0.0, 8.0 );
	imageStore( skyImage, coord, vec4( radiance, 1.0 ) );
}

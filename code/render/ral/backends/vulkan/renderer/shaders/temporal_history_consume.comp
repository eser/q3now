#version 450

// Explicit-arm H1 proof only. This shader never writes scene/history images and
// is not a temporal resolve. One invocation samples the exact current store
// source and, only for a physically committed valid history receipt, both prior
// RGBA16F color and prior R32F linear depth into a fence-delayed witness.
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(set=0,binding=0) uniform texture2D currentColor;
layout(set=0,binding=1) uniform texture2D currentDeviceDepth;
layout(set=0,binding=2) uniform texture2D previousColor;
layout(set=0,binding=3) uniform texture2D previousLinearDepth;
layout(set=0,binding=4) uniform sampler nearestSampler;
layout(std430,set=0,binding=5) buffer HistoryWitness { uint words[20]; } witness;

layout(push_constant) uniform HistoryConsumePush {
	uvec2 extent;
	uint frameLo, frameHi;
	uint worldIndex;
	uint planGeneration;
	uint allocationGeneration;
	uint historyValid;
	uint readIndex;
	uint writeIndex;
	float zNear;
	float zFar;
} pc;

float linearizeDepth(float z) {
	return pc.zNear * pc.zFar / (pc.zNear + z * (pc.zFar - pc.zNear));
}

void main() {
	vec2 uv=(vec2(pc.extent/2u)+0.5)/vec2(pc.extent);
	vec4 current=textureLod(sampler2D(currentColor,nearestSampler),uv,0.0);
	float currentDepth=linearizeDepth(textureLod(sampler2D(currentDeviceDepth,nearestSampler),uv,0.0).r);
	witness.words[0]=0x48535431u; witness.words[1]=pc.historyValid;
	witness.words[2]=pc.frameLo; witness.words[3]=pc.frameHi;
	witness.words[4]=pc.worldIndex; witness.words[5]=pc.planGeneration;
	witness.words[6]=pc.allocationGeneration; witness.words[7]=pc.readIndex;
	witness.words[8]=pc.writeIndex; witness.words[9]=pc.extent.x; witness.words[10]=pc.extent.y;
	witness.words[11]=packHalf2x16(current.rg); witness.words[12]=packHalf2x16(current.ba);
	witness.words[13]=floatBitsToUint(currentDepth);
	if(pc.historyValid!=0u){
		vec4 previous=textureLod(sampler2D(previousColor,nearestSampler),uv,0.0);
		float previousDepth=textureLod(sampler2D(previousLinearDepth,nearestSampler),uv,0.0).r;
		witness.words[14]=packHalf2x16(previous.rg);
		witness.words[15]=packHalf2x16(previous.ba);
		witness.words[16]=floatBitsToUint(previousDepth);
	}else{
		witness.words[14]=0u; witness.words[15]=0u; witness.words[16]=0u;
	}
}

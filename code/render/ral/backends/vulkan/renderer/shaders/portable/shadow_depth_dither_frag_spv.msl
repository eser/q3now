#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct main0_in
{
    float in_opacity [[user(locn0), flat]];
};

fragment void main0(main0_in in [[stage_in]], float4 gl_FragCoord [[position]])
{
    float n = fract(52.98291778564453125 * fract(dot(gl_FragCoord.xy, float2(0.067110560834407806396484375, 0.005837149918079376220703125))));
    if (n >= in.in_opacity)
    {
        discard_fragment();
    }
}


#version 460
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(std140, binding = 8) uniform Push
{
    uvec4 meta;
    vec4 authoredRadiance;
    vec4 sunDirectionIntensity;
    vec4 sunRadianceExposure;
} p;

layout(binding = 0) uniform texture2D authoredRt;
layout(binding = 0) uniform sampler authoredSampler;
layout(binding = 2) uniform texture2D authoredLf;
layout(binding = 1) uniform texture2D authoredBk;
layout(binding = 3) uniform texture2D authoredFt;
layout(binding = 4) uniform texture2D authoredUp;
layout(binding = 5) uniform texture2D authoredDn;
layout(binding = 0, rgba16f) uniform writeonly image2DArray skyImage;

vec3 wired_sky_cube_direction(uint face, vec2 uv)
{
    float u = uv.x;
    float v = uv.y;
    vec3 dir;
    if (face == 0u)
    {
        dir = vec3(1.0, -v, -u);
    }
    else
    {
        if (face == 1u)
        {
            dir = vec3(-1.0, -v, u);
        }
        else
        {
            if (face == 2u)
            {
                dir = vec3(u, 1.0, v);
            }
            else
            {
                if (face == 3u)
                {
                    dir = vec3(u, -1.0, -v);
                }
                else
                {
                    if (face == 4u)
                    {
                        dir = vec3(u, -v, 1.0);
                    }
                    else
                    {
                        dir = vec3(-u, -v, -1.0);
                    }
                }
            }
        }
    }
    return normalize(dir);
}

vec3 authoredSky(vec3 dir)
{
    vec3 a = abs(dir);
    bool _221 = a.x >= a.y;
    bool _229;
    if (_221)
    {
        _229 = a.x >= a.z;
    }
    else
    {
        _229 = _221;
    }
    uint axis;
    vec2 st;
    if (_229)
    {
        if (dir.x >= 0.0)
        {
            axis = 0u;
            st = vec2(-dir.y, dir.z) / vec2(a.x);
        }
        else
        {
            axis = 1u;
            st = vec2(dir.y, dir.z) / vec2(a.x);
        }
    }
    else
    {
        if (a.y >= a.z)
        {
            if (dir.y >= 0.0)
            {
                axis = 2u;
                st = vec2(dir.x, dir.z) / vec2(a.y);
            }
            else
            {
                axis = 3u;
                st = vec2(-dir.x, dir.z) / vec2(a.y);
            }
        }
        else
        {
            if (dir.z >= 0.0)
            {
                axis = 4u;
                st = vec2(-dir.y, -dir.x) / vec2(a.z);
            }
            else
            {
                axis = 5u;
                st = vec2(-dir.y, dir.x) / vec2(a.z);
            }
        }
    }
    vec2 uv = vec2((st.x * 0.5) + 0.5, 0.5 - (st.y * 0.5));
    if (axis == 0u)
    {
        return textureLod(sampler2D(authoredRt, authoredSampler), uv, 0.0).xyz;
    }
    if (axis == 1u)
    {
        return textureLod(sampler2D(authoredLf, authoredSampler), uv, 0.0).xyz;
    }
    if (axis == 2u)
    {
        return textureLod(sampler2D(authoredBk, authoredSampler), uv, 0.0).xyz;
    }
    if (axis == 3u)
    {
        return textureLod(sampler2D(authoredFt, authoredSampler), uv, 0.0).xyz;
    }
    if (axis == 4u)
    {
        return textureLod(sampler2D(authoredUp, authoredSampler), uv, 0.0).xyz;
    }
    return textureLod(sampler2D(authoredDn, authoredSampler), uv, 0.0).xyz;
}

vec3 analyticSky(vec3 dir)
{
    vec3 authored = max(p.authoredRadiance.xyz, vec3(0.00200000009499490261077880859375));
    float authoredEnergy = max(dot(authored, vec3(0.2125999927520751953125, 0.715200006961822509765625, 0.072200000286102294921875)), 0.00200000009499490261077880859375);
    vec3 authoredTint = authored / vec3(authoredEnergy);
    vec3 horizon = authored;
    vec3 zenith = (authoredTint * authoredEnergy) * 0.550000011920928955078125;
    vec3 ground = authored * 0.180000007152557373046875;
    float up = dir.z;
    vec3 sky;
    if (up >= 0.0)
    {
        float t = smoothstep(0.0, 1.0, up);
        sky = mix(horizon, zenith, vec3(t));
    }
    else
    {
        float t_1 = smoothstep(0.0, 0.3499999940395355224609375, -up);
        sky = mix(horizon, ground, vec3(t_1));
    }
    vec3 sunDirection = p.sunDirectionIntensity.xyz;
    float sunLength = length(sunDirection);
    float _175;
    if (sunLength > 9.9999997473787516355514526367188e-06)
    {
        _175 = max(dot(dir, sunDirection / vec3(sunLength)), 0.0);
    }
    else
    {
        _175 = 0.0;
    }
    float sd = _175;
    float lobe = pow(sd, 320.0);
    if (up > 0.0)
    {
        sky += ((max(p.sunRadianceExposure.xyz, vec3(0.0)) * max(p.sunDirectionIntensity.w, 0.0)) * lobe);
    }
    return max(sky, vec3(0.0));
}

void main()
{
    uvec2 size = uvec2(imageSize(skyImage).xy);
    uint face = p.meta.x;
    ivec3 coord = ivec3(ivec2(gl_GlobalInvocationID.xy), int(face));
    bool _443 = uint(coord.x) >= size.x;
    bool _453;
    if (!_443)
    {
        _453 = uint(coord.y) >= size.y;
    }
    else
    {
        _453 = _443;
    }
    if (_453 || (face >= 6u))
    {
        return;
    }
    vec2 uv = (((vec2(coord.xy) + vec2(0.5)) / vec2(size)) * 2.0) - vec2(1.0);
    uint param = face;
    vec2 param_1 = uv;
    vec3 dir = wired_sky_cube_direction(param, param_1);
    vec3 _484;
    if (p.meta.w != 0u)
    {
        vec3 param_2 = dir;
        _484 = max(authoredSky(param_2), vec3(0.0));
    }
    else
    {
        vec3 param_3 = dir;
        _484 = analyticSky(param_3);
    }
    vec3 radiance = _484;
    if (p.meta.w != 0u)
    {
        vec3 sunDirection = p.sunDirectionIntensity.xyz;
        float sunLength = length(sunDirection);
        float _511;
        if (sunLength > 9.9999997473787516355514526367188e-06)
        {
            _511 = max(dot(dir, sunDirection / vec3(sunLength)), 0.0);
        }
        else
        {
            _511 = 0.0;
        }
        float sd = _511;
        radiance += ((max(p.sunRadianceExposure.xyz, vec3(0.0)) * max(p.sunDirectionIntensity.w, 0.0)) * pow(sd, 320.0));
    }
    radiance *= clamp(p.sunRadianceExposure.w, 0.0, 8.0);
    imageStore(skyImage, coord, vec4(radiance, 1.0));
}


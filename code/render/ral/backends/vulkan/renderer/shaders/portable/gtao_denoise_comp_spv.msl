        int2 param = q;
        tile[i] = float2(spvDescriptorSet0.aoIn.read(uint2(q)).x, linearAt(param, pc, spvDescriptorSet0.depthTex, spvDescriptorSet0.depthSampler));
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    bool _156 = pix.x >= dim.x;
    bool _166;
    if (!_156)
    {
        _166 = pix.y >= dim.y;
    }
    else
    {
        _166 = _156;
    }
    if (_166)
    {
        return;
    }
    int2 local = int2(gl_LocalInvocationID.xy) + int2(2);
    int center = (local.y * 12) + local.x;
    float centerLin = ((threadgroup float*)&tile[center])[1u];
    float depthScale = 1.0 / fast::max(centerLin * 0.0500000007450580596923828125, 0.001000000047497451305389404296875);
    float sum = 0.0;
    float wsum = 0.0;
    for (int dy = -2; dy <= 2; dy++)
    {

#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct SkyParams
{
    float4 sunDirectionAngularRadius;
    float4 sunRadiance;
    float4 moonDirectionAngularRadius;
    float4 moonRadiance;
    float4 atmosphereRadii;
    float4 scatteringScale;
    float4 groundExposure;
};

constant uint3 gl_WorkGroupSize [[maybe_unused]] = uint3(8u, 8u, 1u);

struct spvDescriptorSetBuffer0
{
    texture2d<float, access::write> multiscatterLut [[id(0)]];
    texture2d<float> transmittanceLut [[id(1)]];
    sampler transmittanceLutSmplr [[id(2)]];
    constant SkyParams* sky [[id(3)]];
};

kernel void main0(const device spvDescriptorSetBuffer0& spvDescriptorSet0 [[buffer(0)]], uint3 gl_GlobalInvocationID [[thread_position_in_grid]])
{
    int2 coord = int2(gl_GlobalInvocationID.xy);
    int2 extent = int2(spvDescriptorSet0.multiscatterLut.get_width(), spvDescriptorSet0.multiscatterLut.get_height());
    if (any(coord >= extent))
    {
        return;
    }
    float2 uv = (float2(coord) + float2(0.5)) / float2(extent);
    float3 accumulated = float3(0.0);
    for (int i = 0; i < 16; i++)
    {
        float u = (float(i) + 0.5) / 16.0;
        float2 sampleUv = float2(fract(u + uv.x), uv.y);
        float3 transmittance = spvDescriptorSet0.transmittanceLut.sample(spvDescriptorSet0.transmittanceLutSmplr, sampleUv, level(0.0)).xyz;
        accumulated += ((float3(1.0) - transmittance) * transmittance);
    }
    float3 energy = accumulated / float3(16.0);
    energy *= fast::max((*spvDescriptorSet0.sky).sunRadiance.xyz, float3(0.001000000047497451305389404296875));
    energy *= (0.3499999940395355224609375 + (0.64999997615814208984375 * fast::clamp((*spvDescriptorSet0.sky).groundExposure.w, 0.0, 4.0)));
    spvDescriptorSet0.multiscatterLut.write(float4(fast::max(energy, float3(0.0)), 1.0), uint2(coord));
}


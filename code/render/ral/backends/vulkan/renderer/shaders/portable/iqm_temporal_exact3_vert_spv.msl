    uint recordIndex = uint(int(gl_InstanceIndex));
    if (recordIndex >= 256u)
    {
        out.gl_Position = float4(0.0, 0.0, -2.0, 1.0);
        out.frag_tex_coord = float2(0.0);
        out.frag_normal = float3(0.0);
        out.frag_tangent = float4(0.0);
        out.temporalCurrentClip = float4(0.0);
        out.temporalPreviousClip = float4(0.0);
        return out;
    }
    uint param = recordIndex;
    float3 currentPosition = skinCurrentPosition(param, (*spvDescriptorSet0.temporalIqmPayload), in.in_bone_weights, in.in_bone_indices, in.in_position);
    uint param_1 = recordIndex;
    float3 previousPosition = skinPreviousPosition(param_1, (*spvDescriptorSet0.temporalIqmPayload), in.in_bone_weights, in.in_bone_indices, in.in_position);
    uint param_2 = recordIndex;
    float3 param_3 = in.in_normal;
    float3 currentNormal = skinDirection(param_2, param_3, (*spvDescriptorSet0.temporalIqmPayload), in.in_bone_weights, in.in_bone_indices);
    uint param_4 = recordIndex;
    float3 param_5 = in.in_tangent.xyz;
    float3 currentTangent = skinDirection(param_4, param_5, (*spvDescriptorSet0.temporalIqmPayload), in.in_bone_weights, in.in_bone_indices);
    out.gl_Position = (*spvDescriptorSet0.temporalIqmPayload).records[recordIndex].rasterMvp * float4(currentPosition, 1.0);
    out.temporalCurrentClip = (*spvDescriptorSet0.temporalIqmPayload).records[recordIndex].temporalCurrentMvp * float4(currentPosition, 1.0);
    out.temporalPreviousClip = (*spvDescriptorSet0.temporalIqmPayload).records[recordIndex].temporalPreviousMvp * float4(previousPosition, 1.0);
    out.frag_tex_coord = in.in_tex_coord;
    out.frag_normal = fast::normalize(currentNormal);
    out.frag_tangent = float4(fast::normalize(currentTangent), in.in_tangent.w);

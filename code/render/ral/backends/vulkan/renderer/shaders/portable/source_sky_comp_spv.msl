static inline __attribute__((always_inline))
float3 analyticSky(thread const float3& dir, constant Push& p)
{
    float3 authored = fast::max(p.authoredRadiance.xyz, float3(0.00200000009499490261077880859375));
    float authoredEnergy = fast::max(dot(authored, float3(0.2125999927520751953125, 0.715200006961822509765625, 0.072200000286102294921875)), 0.00200000009499490261077880859375);
    float3 authoredTint = authored / float3(authoredEnergy);
    float3 horizon = authored;
    float3 zenith = (authoredTint * authoredEnergy) * 0.550000011920928955078125;
    float3 ground = authored * 0.180000007152557373046875;
    float up = dir.z;
    float3 sky;
    if (up >= 0.0)
    {
        float t = smoothstep(0.0, 1.0, up);
        sky = mix(horizon, zenith, float3(t));
    }
    else
    {
        float t_1 = smoothstep(0.0, 0.3499999940395355224609375, -up);
        sky = mix(horizon, ground, float3(t_1));
    }
    float3 sunDirection = p.sunDirectionIntensity.xyz;
    float sunLength = length(sunDirection);
    float _175;
    if (sunLength > 9.9999997473787516355514526367188e-06)
    {
        _175 = fast::max(dot(dir, sunDirection / float3(sunLength)), 0.0);
    }
    else
    {
        _175 = 0.0;
    }
    float sd = _175;
    float lobe = powr(sd, 320.0);
    if (up > 0.0)
    {
        sky += ((fast::max(p.sunRadianceExposure.xyz, float3(0.0)) * fast::max(p.sunDirectionIntensity.w, 0.0)) * lobe);
    }
    return fast::max(sky, float3(0.0));
}


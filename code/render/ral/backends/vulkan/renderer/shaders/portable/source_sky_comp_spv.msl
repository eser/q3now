static inline __attribute__((always_inline))
float3 wired_sky_cube_direction(thread const uint& face, thread const float2& uv)
{
    float u = uv.x;
    float v = uv.y;
    float3 dir;
    if (face == 0u)
    {
        dir = float3(1.0, -v, -u);
    }
    else
    {
        if (face == 1u)
        {
            dir = float3(-1.0, -v, u);
        }
        else
        {
            if (face == 2u)
            {
                dir = float3(u, 1.0, v);
            }
            else
            {
                if (face == 3u)
                {
                    dir = float3(u, -1.0, -v);
                }
                else
                {
                    if (face == 4u)
                    {
                        dir = float3(u, -v, 1.0);
                    }
                    else
                    {
                        dir = float3(-u, -v, -1.0);
                    }
                }
            }
        }
    }
    return fast::normalize(dir);
}

static inline __attribute__((always_inline))
float3 authoredSky(thread const float3& dir, texture2d<float> authoredRt, sampler authoredSampler, texture2d<float> authoredLf, texture2d<float> authoredBk, texture2d<float> authoredFt, texture2d<float> authoredUp, texture2d<float> authoredDn)

#version 460

layout(constant_id = 0) const float msdf_distance_range = 8.0;

layout(binding = 0, std140) uniform MsdfUBO
{
    mat4 mvp;
    float outlineWidth;
    float glowWidth;
    vec2 shadowOffset;
    vec4 outlineColor;
    vec4 glowColor;
    vec4 shadowColor;
    uint bindless_packed_slot;
} pc;

layout(binding = 0) uniform texture2D wired_bindless_images[64];
layout(binding = 0) uniform sampler wired_bindless_samplers[32];

layout(location = 0) in vec4 frag_color0;
layout(location = 1) in vec2 frag_tex_coord0;
layout(location = 0) out vec4 out_color;

vec3 sRGBToLinear(inout vec3 c)
{
    c = max(c, vec3(0.0));
    bvec3 cutoff = lessThanEqual(c, vec3(0.040449999272823333740234375));
    vec3 lo = c / vec3(12.9200000762939453125);
    vec3 hi = pow((c + vec3(0.054999999701976776123046875)) / vec3(1.05499994754791259765625), vec3(2.400000095367431640625));
    return mix(hi, lo, vec3(cutoff));
}

float median(float r, float g, float b)
{
    return max(min(r, g), min(max(r, g), b));
}

void main()
{
    vec3 param = frag_color0.xyz;
    vec3 _75 = sRGBToLinear(param);
    vec3 fillColor = _75;
    uint _94 = pc.bindless_packed_slot & 4095u;
    uint _108 = (pc.bindless_packed_slot >> uint(12)) & 255u;
    vec3 msd = texture(sampler2D(wired_bindless_images[_94], wired_bindless_samplers[_108]), frag_tex_coord0).xyz;
    float param_1 = msd.x;
    float param_2 = msd.y;
    float param_3 = msd.z;
    float sd = median(param_1, param_2, param_3);
    uint _138 = pc.bindless_packed_slot & 4095u;
    uint _145 = (pc.bindless_packed_slot >> uint(12)) & 255u;
    vec2 atlasSize = vec2(textureSize(sampler2D(wired_bindless_images[_138], wired_bindless_samplers[_145]), 0));
    vec2 unitRange;
    unitRange.x = msdf_distance_range / atlasSize.x;
    unitRange.y = msdf_distance_range / atlasSize.y;
    vec2 screenTexSize = vec2(1.0) / fwidth(frag_tex_coord0);
    float screenPxRange = max(0.5 * dot(unitRange, screenTexSize), 1.0);
    float fillDist = screenPxRange * (sd - 0.5);
    float outlineDist = screenPxRange * ((sd - 0.5) + pc.outlineWidth);
    float glowDist = screenPxRange * (((sd - 0.5) + pc.outlineWidth) + pc.glowWidth);
    float fillAlpha = clamp(fillDist + 0.5, 0.0, 1.0);
    float outlineAlpha = clamp(outlineDist + 0.5, 0.0, 1.0);
    float glowAlpha = clamp(glowDist + 0.5, 0.0, 1.0);
    uint _224 = pc.bindless_packed_slot & 4095u;
    uint _231 = (pc.bindless_packed_slot >> uint(12)) & 255u;
    vec2 shadowUV = frag_tex_coord0 - (pc.shadowOffset / vec2(textureSize(sampler2D(wired_bindless_images[_224], wired_bindless_samplers[_231]), 0)));
    uint _244 = pc.bindless_packed_slot & 4095u;
    uint _251 = (pc.bindless_packed_slot >> uint(12)) & 255u;
    vec3 shadowMsd = texture(sampler2D(wired_bindless_images[_244], wired_bindless_samplers[_251]), shadowUV).xyz;
    float param_4 = shadowMsd.x;
    float param_5 = shadowMsd.y;
    float param_6 = shadowMsd.z;
    float shadowSd = median(param_4, param_5, param_6);
    float shadowAlpha = clamp((screenPxRange * (shadowSd - 0.5)) + 0.5, 0.0, 1.0) * pc.shadowColor.w;
    vec4 fill = vec4(fillColor, frag_color0.w * fillAlpha);
    vec4 outline = vec4(pc.outlineColor.xyz, pc.outlineColor.w * outlineAlpha);
    vec4 glow = vec4(pc.glowColor.xyz, (pc.glowColor.w * glowAlpha) * (1.0 - outlineAlpha));
    vec4 shadow = vec4(pc.shadowColor.xyz, shadowAlpha);
    vec3 col = shadow.xyz * shadow.w;
    float a = shadow.w;
    col = (col * (1.0 - glow.w)) + (glow.xyz * glow.w);
    a = (a * (1.0 - glow.w)) + glow.w;
    col = (col * (1.0 - outline.w)) + (outline.xyz * outline.w);
    a = (a * (1.0 - outline.w)) + outline.w;
    col = (col * (1.0 - fill.w)) + (fill.xyz * fill.w);
    a = (a * (1.0 - fill.w)) + fill.w;
    out_color = vec4(col, a);
}


static inline __attribute__((always_inline))
void emitDegenerate(thread float4& gl_Position, thread float2& fragUV, thread float4& fragColor, thread uint& fragShaderHandle)
{
    gl_Position = float4(0.0, 0.0, -2.0, 1.0);
    fragUV = float2(0.0);
    fragColor = float4(0.0);
    fragShaderHandle = 0u;
}

static inline __attribute__((always_inline))
bool helixPoint(thread const int& j, thread const int& numSegs, thread const float3& start, thread const float3& beamAxis, thread const float& beamLen, thread const float& curRadius, thread const float& curSpacing, thread const float& curWidth, thread const float& frac, thread const float& trailAlpha, thread const RailRibbonHeader& hdr, thread float3& pos, thread float3& normal, thread float& halfW, thread float& alpha)
{
    if (j > (numSegs - 1))
    {
        return false;
    }
    float d = beamLen - (float(j) * curSpacing);
    if (d < 0.0)
    {
        return false;
    }
    int ring = spvSMod(j * 2, 36);
    if (ring < 0)
    {
        ring += 36;
    }
    float3 perp = hdr.perpAxis[ring].xyz;
    pos = (start + (beamAxis * d)) + (perp * curRadius);
    normal = fast::normalize(cross(beamAxis, perp));
    halfW = curWidth;
    float segPos = float(j) / float(numSegs - 1);
    float unwindFade = 1.0 - (frac * (1.0 + segPos));
    if (unwindFade < 0.0)
    {
        unwindFade = 0.0;
    }
    alpha = trailAlpha * unwindFade;
    return true;
}


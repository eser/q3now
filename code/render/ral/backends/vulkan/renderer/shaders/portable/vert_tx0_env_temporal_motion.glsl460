#version 460

layout(constant_id = 16) const int ENTITY_SSBO = 0;
const bool _15 = (ENTITY_SSBO != 0);

struct TemporalPayloadRecord
{
    mat4 currentMvp;
    mat4 previousMvp;
    uvec4 outcomeReserved;
};

layout(binding = 0, std430) readonly buffer EntityMatrices
{
    mat4 entMat[];
} _22;

layout(binding = 0, std140) uniform UBO
{
    vec4 eyePos;
    vec4 lightPos;
    vec4 lightColor;
    vec4 lightVector;
    vec4 _pad_to_mvp[26];
    mat4 mvp;
} ubo;

layout(binding = 1, std430) readonly buffer TemporalPayloads
{
    TemporalPayloadRecord temporalPayload[];
} temporalPayloads;

layout(location = 0) in vec3 in_position;
layout(location = 10) out vec4 temporalCurrentClip;
layout(location = 11) out vec4 temporalPreviousClip;
layout(location = 12) flat out uint temporalOutcome;
layout(location = 0) out vec4 frag_color0;
layout(location = 1) in vec4 in_color0;
layout(location = 5) in vec3 in_normal;
layout(location = 1) out vec2 frag_tex_coord0;

void main()
{
    mat4 _16;
    if (_15)
    {
        _16 = _22.entMat[gl_InstanceIndex * 2];
    }
    else
    {
        _16 = ubo.mvp;
    }
    mat4 mvp = _16;
    gl_Position = mvp * vec4(in_position, 1.0);
    TemporalPayloadRecord temporal;
    temporal.currentMvp = temporalPayloads.temporalPayload[gl_InstanceIndex].currentMvp;
    temporal.previousMvp = temporalPayloads.temporalPayload[gl_InstanceIndex].previousMvp;
    temporal.outcomeReserved = temporalPayloads.temporalPayload[gl_InstanceIndex].outcomeReserved;
    vec4 temporalLocalPosition = vec4(in_position, 1.0);
    temporalCurrentClip = temporal.currentMvp * temporalLocalPosition;
    temporalPreviousClip = temporal.previousMvp * temporalLocalPosition;
    temporalOutcome = temporal.outcomeReserved.x;
    frag_color0 = in_color0;
    vec3 viewer = normalize(ubo.eyePos.xyz - in_position);
    float d = dot(in_normal, viewer);
    vec2 reflected = ((in_normal.yz * 2.0) * d) - viewer.yz;
    frag_tex_coord0.x = 0.5 + (reflected.x * 0.5);
    frag_tex_coord0.y = 0.5 - (reflected.y * 0.5);
}


#version 460

layout(binding = 0, std140) uniform AtmFrame
{
    mat4 mvp;
    vec4 viewLeft;
    vec4 viewUp;
    vec4 eyeWorld;
    float dt;
    float time;
    uint poolSize;
    uint pingPongRead;
    vec4 boundsMin;
    vec4 boundsMax;
    vec2 worldMins;
    vec2 worldMaxs;
    vec2 invGridStep;
    uint gridSize;
    uint atmType;
    float _distance;
    float computePad0;
    float computePad1;
    float computePad2;
    vec4 windGust;
    vec4 precipitation;
    float dustAsh;
    float indoorExposure;
    uint climateSeed;
    uint climatePad;
    vec4 climate;
    vec4 surfaceClimate;
    vec4 sun;
    vec4 moon;
    vec4 ambientCloud;
    vec4 cloudMedia;
    vec4 effectMeta;
    vec4 effectWorkloads[48];
    vec4 renderParams;
} _67;

layout(binding = 0) uniform sampler2D sceneDepthTex;

layout(location = 0) in vec2 fragUV;
layout(location = 1) in vec4 fragColor;
layout(location = 0) out vec4 outColor;

float softParticleFade()
{
    if (_67.renderParams.z < 0.5)
    {
        return 1.0;
    }
    vec2 screenUV = gl_FragCoord.xy * _67.renderParams.xy;
    float sceneDepth = texture(sceneDepthTex, screenUV).x;
    if (sceneDepth <= 0.0)
    {
        return 1.0;
    }
    float depthDiff = gl_FragCoord.z - sceneDepth;
    return smoothstep(0.0, 0.001000000047497451305389404296875, depthDiff);
}

vec3 sRGBToLinear(inout vec3 c)
{
    c = max(c, vec3(0.0));
    bvec3 cutoff = lessThanEqual(c, vec3(0.040449999272823333740234375));
    vec3 lo = c / vec3(12.9200000762939453125);
    vec3 hi = pow((c + vec3(0.054999999701976776123046875)) / vec3(1.05499994754791259765625), vec3(2.400000095367431640625));
    return mix(hi, lo, vec3(cutoff));
}

vec3 displayVisibility(vec3 sceneColor)
{
    vec3 exposed = max(sceneColor, vec3(0.0)) * _67.viewLeft.w;
    float luminance = dot(exposed, vec3(0.2125999927520751953125, 0.715200006961822509765625, 0.072200000286102294921875));
    bool _84 = luminance > 0.0;
    bool _92;
    if (_84)
    {
        _92 = luminance < _67.eyeWorld.w;
    }
    else
    {
        _92 = _84;
    }
    bool _99;
    if (_92)
    {
        _99 = _67.viewUp.w != 1.0;
    }
    else
    {
        _99 = _92;
    }
    if (_99)
    {
        float curved = pow(luminance / _67.eyeWorld.w, _67.viewUp.w) * _67.eyeWorld.w;
        exposed *= (curved / luminance);
    }
    return exposed;
}

void main()
{
    float edge = 1.0 - smoothstep(0.0, 0.5, abs(fragUV.x - 0.5));
    float alpha = (fragColor.w * edge) * softParticleFade();
    vec3 param = fragColor.xyz;
    vec3 _188 = sRGBToLinear(param);
    vec3 param_1 = _188;
    vec3 rgb = displayVisibility(param_1);
    outColor = vec4(rgb, alpha);
}


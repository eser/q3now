static inline __attribute__((always_inline))
float edgeLuma(thread const float3& c)
{
    float l = dot(c, float3(0.2125999927520751953125, 0.715200006961822509765625, 0.072200000286102294921875));
    float param = l;
    if (!finite1(param))
    {
        return 0.0;
    }
    l = fast::clamp(l, 0.0, 10000.0);
    return l * rsqrt(1.0 + (l * l));
}

static inline __attribute__((always_inline))
float4 sampleCurrent(thread const int2& pixel, constant TemporalBootstrapPush& pc, texture2d<float> currentColor, sampler nearestSampler)
{
    int2 bounded = clamp(pixel, int2(0), int2(pc.extent) - int2(1));
    return currentColor.read(uint2(bounded), 0);
}

static inline __attribute__((always_inline))
float edgeLumaAt(thread const int2& p, constant TemporalBootstrapPush& pc, texture2d<float> currentColor, sampler nearestSampler)
{
    int2 param = p;
    float3 param_1 = sampleCurrent(param, pc, currentColor, nearestSampler).xyz;
    return edgeLuma(param_1);
}

static inline __attribute__((always_inline))
float edgeMidLuma(thread const int2& base, thread const int2& across, constant TemporalBootstrapPush& pc, texture2d<float> currentColor, sampler nearestSampler)
{
    int2 param = base;
    int2 param_1 = base + across;
    return 0.5 * (edgeLumaAt(param, pc, currentColor, nearestSampler) + edgeLumaAt(param_1, pc, currentColor, nearestSampler));
}

static inline __attribute__((always_inline))
float4 spatialEdgeFilter(thread const int2& px, thread const float4& centerColor, constant TemporalBootstrapPush& pc, texture2d<float> currentColor, sampler nearestSampler)
{
    float3 param = centerColor.xyz;
    float edgeM = edgeLuma(param);
    int2 param_1 = px + int2(0, -1);
    float edgeN = edgeLumaAt(param_1, pc, currentColor, nearestSampler);
    int2 param_2 = px + int2(0, 1);
    float edgeS = edgeLumaAt(param_2, pc, currentColor, nearestSampler);
    int2 param_3 = px + int2(-1, 0);
    float edgeW = edgeLumaAt(param_3, pc, currentColor, nearestSampler);
    int2 param_4 = px + int2(1, 0);
    float edgeE = edgeLumaAt(param_4, pc, currentColor, nearestSampler);
    float edgeHi = fast::max(fast::max(edgeN, edgeS), fast::max(fast::max(edgeW, edgeE), edgeM));
    float edgeLo = fast::min(fast::min(edgeN, edgeS), fast::min(fast::min(edgeW, edgeE), edgeM));
    float edgeSpan = edgeHi - edgeLo;
    if (edgeSpan < fast::max(0.031199999153614044189453125, edgeHi * 0.125))
    {
        return centerColor;
    }
    int2 param_5 = px + int2(-1);
    float edgeNW = edgeLumaAt(param_5, pc, currentColor, nearestSampler);
    int2 param_6 = px + int2(1, -1);
    float edgeNE = edgeLumaAt(param_6, pc, currentColor, nearestSampler);
    int2 param_7 = px + int2(-1, 1);
    float edgeSW = edgeLumaAt(param_7, pc, currentColor, nearestSampler);
    int2 param_8 = px + int2(1);
    float edgeSE = edgeLumaAt(param_8, pc, currentColor, nearestSampler);
    float edgeNS = edgeN + edgeS;
    float edgeWE = edgeW + edgeE;
    float edgeNWSW = edgeNW + edgeSW;
    float edgeNESE = edgeNE + edgeSE;
    float edgeHorz = abs(((-2.0) * edgeW) + edgeNWSW) + ((abs(((-2.0) * edgeM) + edgeNS) * 2.0) + abs(((-2.0) * edgeE) + edgeNESE));
    float edgeVert = abs(((-2.0) * edgeS) + (edgeSW + edgeSE)) + ((abs(((-2.0) * edgeM) + edgeWE) * 2.0) + abs(((-2.0) * edgeN) + (edgeNW + edgeNE)));
    bool edgeHorzSpan = edgeHorz >= edgeVert;
    float edgeAround = ((edgeNS + edgeWE) * 2.0) + (edgeNWSW + edgeNESE);
    float edgeLoSide = edgeHorzSpan ? edgeN : edgeW;
    float edgeHiSide = edgeHorzSpan ? edgeS : edgeE;
    float edgeGradLo = edgeLoSide - edgeM;
    float edgeGradHi = edgeHiSide - edgeM;
    bool edgeLoSteeper = abs(edgeGradLo) >= abs(edgeGradHi);
    float edgeGradient = fast::max(abs(edgeGradLo), abs(edgeGradHi));
    float _352;
    if (edgeLoSteeper)
    {
        _352 = edgeLoSide + edgeM;
    }
    else
    {
        _352 = edgeHiSide + edgeM;
    }
    float edgePair = _352;
    int2 edgeAcross = select(int2(1, 0), int2(0, 1), bool2(edgeHorzSpan));
    int2 edgeAlong = select(int2(0, 1), int2(1, 0), bool2(edgeHorzSpan));
    if (edgeLoSteeper)
    {
        edgeAcross = -edgeAcross;
    }
    float edgeInvSpan = rsqrt(edgeSpan * edgeSpan);
    float edgeBlendC = fast::clamp(abs((edgeAround * 0.083333335816860198974609375) - edgeM) * edgeInvSpan, 0.0, 1.0);
    float edgeBlendF = (((-2.0) * edgeBlendC) + 3.0) * (edgeBlendC * edgeBlendC);
    float edgeSubpixel = (edgeBlendF * edgeBlendF) * 0.75;
    float edgeHalfPair = edgePair * 0.5;
    float edgeScaled = edgeGradient * 0.25;
    bool edgeMidNegative = (edgeM - edgeHalfPair) < 0.0;
    int2 param_9 = px - edgeAlong;
    int2 param_10 = edgeAcross;
    float edgeEndN = edgeMidLuma(param_9, param_10, pc, currentColor, nearestSampler) - edgeHalfPair;
    int2 param_11 = px + edgeAlong;
    int2 param_12 = edgeAcross;
    float edgeEndP = edgeMidLuma(param_11, param_12, pc, currentColor, nearestSampler) - edgeHalfPair;
    bool edgeDoneN = abs(edgeEndN) >= edgeScaled;
    bool edgeDoneP = abs(edgeEndP) >= edgeScaled;
    int edgeStepsN = 1;
    int edgeStepsP = 1;
    for (int i = 2; i <= 12; i++)
    {
        if (!edgeDoneN)
        {
            int2 param_13 = px - (edgeAlong * int2(i));
            int2 param_14 = edgeAcross;
            edgeEndN = edgeMidLuma(param_13, param_14, pc, currentColor, nearestSampler) - edgeHalfPair;
            edgeDoneN = abs(edgeEndN) >= edgeScaled;
            edgeStepsN = i;
        }
        if (!edgeDoneP)
        {
            int2 param_15 = px + (edgeAlong * int2(i));
            int2 param_16 = edgeAcross;
            edgeEndP = edgeMidLuma(param_15, param_16, pc, currentColor, nearestSampler) - edgeHalfPair;
            edgeDoneP = abs(edgeEndP) >= edgeScaled;
            edgeStepsP = i;
        }
        if (edgeDoneN && edgeDoneP)
        {
            break;
        }
    }
    bool edgeTowardN = edgeStepsN < edgeStepsP;
    float edgeEndG = edgeTowardN ? edgeEndN : edgeEndP;
    bool edgeGoodSpan = (edgeEndG < 0.0) != edgeMidNegative;
    float edgeSpanLen = float(edgeStepsN + edgeStepsP);
    float edgeNear = float(edgeTowardN ? edgeStepsN : edgeStepsP);
    float _539;
    if (edgeGoodSpan)
    {
        _539 = 0.5 - (edgeNear * rsqrt(edgeSpanLen * edgeSpanLen));
    }
    else
    {
        _539 = 0.0;
    }
    float edgeStepBlend = _539;
    float edgeBlend = fast::clamp(fast::max(edgeStepBlend, edgeSubpixel), 0.0, 1.0);
    int2 param_17 = px + edgeAcross;
    float3 edgeAcrossColor = sampleCurrent(param_17, pc, currentColor, nearestSampler).xyz;
    return float4((centerColor.xyz * (1.0 - edgeBlend)) + (edgeAcrossColor * edgeBlend), centerColor.w);
}

static inline __attribute__((always_inline))
float storeLinearDepth(thread const float& z, constant TemporalBootstrapPush& pc)
{
    float denominator = pc.zNear + (z * (pc.zFar - pc.zNear));
    return (pc.zNear * pc.zFar) * rsqrt(denominator * denominator);
}

kernel void main0(const device spvDescriptorSetBuffer0& spvDescriptorSet0 [[buffer(0)]], constant TemporalBootstrapPush& pc [[buffer(1)]], uint3 gl_GlobalInvocationID [[thread_position_in_grid]])
{
    int2 pixel = int2(gl_GlobalInvocationID.xy);
    if (any(pixel >= int2(pc.extent)))
    {
        return;
    }
    float4 current = spvDescriptorSet0.currentColor.read(uint2(pixel), 0);
    float4 param = current;
    float4 _632;
    if (finite4(param))
    {
        int2 param_1 = pixel;
        float4 param_2 = current;
        _632 = spatialEdgeFilter(param_1, param_2, pc, spvDescriptorSet0.currentColor, spvDescriptorSet0.nearestSampler);
    }
    else
    {
        _632 = float4(0.0);
    }
    float4 result = _632;
    float4 param_3 = result;
    if (!finite4(param_3))
    {
        result = float4(0.0);
    }
    spvDescriptorSet0.bootstrapColor.write(result, uint2(pixel));
    spvDescriptorSet0.historyOutColor.write(float4(result.xyz, 1.0), uint2(pixel));
    float param_4 = spvDescriptorSet0.currentDeviceDepth.read(uint2(pixel), 0).x;
    spvDescriptorSet0.historyOutLinearDepth.write(float4(storeLinearDepth(param_4, pc)), uint2(pixel));
}


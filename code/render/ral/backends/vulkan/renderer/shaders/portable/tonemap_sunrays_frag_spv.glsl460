} eb;

layout(binding = 1) uniform sampler2D depthMap;
layout(binding = 0) uniform sampler2D texture0;

layout(location = 0) in vec2 frag_tex_coord;
layout(location = 0) out vec4 out_color;

vec3 sampleChromatic(vec2 uv)
{
    vec2 dir = uv - vec2(0.5);
    float radial = length(dir);
    vec2 offset = dir * ((chromatic_strength * radial) * 0.014999999664723873138427734375);
    float r = texture(texture0, clamp(uv + offset, vec2(0.0), vec2(1.0))).x;
    float g = texture(texture0, uv).y;
    float b = texture(texture0, clamp(uv - offset, vec2(0.0), vec2(1.0))).z;
    return vec3(r, g, b);
}

vec3 computeSunRays()
{
    float _37 = float(sunrays_samples);
    vec2 deltaUV = ((frag_tex_coord - vec2(eb.sunScreenX, eb.sunScreenY)) * sunrays_density) / vec2(_37);
    vec2 uv = frag_tex_coord;
    vec3 illumination = vec3(0.0);
    float weight = 1.0;
    vec3 threshold;
    for (int i = 0; i < sunrays_samples; i++)
    {
        uv -= deltaUV;
        bool _67 = uv.x < 0.0;
        bool _74;
        if (!_67)
        {
            _74 = uv.x > 1.0;
        }
        else
        {
            _74 = _67;
        }
        bool _82;
        if (!_74)
        {
            _82 = uv.y < 0.0;
        }
        else
        {
            _82 = _74;
        }
        bool _89;
        if (!_82)
        {
            _89 = uv.y > 1.0;
        }
        else
        {
            _89 = _82;
        }
        if (_89)
        {
            break;
        }
        float depth = texture(depthMap, uv).x;
        float isSky = step(depth, 0.001000000047497451305389404296875);
        vec3 sceneColor = texture(texture0, uv).xyz;
        threshold.x = sunrays_threshold;
        threshold.y = sunrays_threshold;
        threshold.z = sunrays_threshold;
        vec3 bright = max(sceneColor - threshold, vec3(0.0));
        illumination += ((bright * isSky) * weight);
        weight *= eb.sunrayDecay;
    }
    float _139 = float(sunrays_samples);
    illumination /= vec3(_139);
    return illumination * eb.sunrayIntensity;
}

void main()
{
    vec3 _199;
    if (chromatic_strength > 0.0)
    {
        vec2 param = frag_tex_coord;
        _199 = sampleChromatic(param);
    }
    else
    {
        _199 = texture(texture0, frag_tex_coord).xyz;
    }
    vec3 base = _199;
    base *= eb.exposure_bias;
    float shadowLuma = dot(max(base, vec3(0.0)), vec3(0.2125999927520751953125, 0.715200006961822509765625, 0.072200000286102294921875));
    bool _229 = (eb.shadowExponent != 1.0) && (shadowLuma > 0.0);
    bool _237;
    if (_229)
    {
        _237 = shadowLuma < eb.shadowPivot;
    }
    else
    {
        _237 = _229;
    }
    if (_237)
    {
        float normalized = shadowLuma / eb.shadowPivot;
        float curved = pow(normalized, eb.shadowExponent) * eb.shadowPivot;
        base *= (curved / shadowLuma);
    }
    base += computeSunRays();
    if (saturation != 1.0)
    {
        vec3 luma = vec3(dot(base, vec3(0.2125999927520751953125, 0.715200006961822509765625, 0.072200000286102294921875)));
        base = mix(luma, base, vec3(saturation));
    }
    out_color = vec4(base, 1.0);
}


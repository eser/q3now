                dir = float3(u, 1.0, v);
            }
            else
            {
                if (face == 3u)
                {
                    dir = float3(u, -1.0, -v);
                }
                else
                {
                    if (face == 4u)
                    {
                        dir = float3(u, -v, 1.0);
                    }
                    else
                    {
                        dir = float3(-u, -v, -1.0);
                    }
                }
            }
        }
    }
    return fast::normalize(dir);
}

static inline __attribute__((always_inline))
float radicalInverse_VdC(thread uint& bits)
{

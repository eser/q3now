    float param_2 = NdotL;
    float param_3 = roughness;
    return GeometrySchlickGGX(param, param_1) * GeometrySchlickGGX(param_2, param_3);
}

vec3 FresnelSchlick(float cosTheta, vec3 F0)
{
    float t = 1.0 - cosTheta;
    float t2 = t * t;
    return F0 + ((vec3(1.0) - F0) * ((t2 * t2) * t));
}


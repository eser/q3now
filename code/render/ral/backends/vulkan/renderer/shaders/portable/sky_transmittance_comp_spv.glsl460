#version 460
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, std140) uniform SkyParams
{
    vec4 sunDirectionAngularRadius;
    vec4 sunRadiance;
    vec4 moonDirectionAngularRadius;
    vec4 moonRadiance;
    vec4 atmosphereRadii;
    vec4 scatteringScale;
    vec4 groundExposure;
} sky;

layout(binding = 0, rgba16f) uniform writeonly image2D transmittanceLut;

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(transmittanceLut);
    if (any(greaterThanEqual(coord, extent)))
    {
        return;
    }
    vec2 uv = (vec2(coord) + vec2(0.5)) / vec2(extent);
    float altitude = uv.y;
    float mu = (uv.x * 2.0) - 1.0;
    float horizon = sqrt(max(1.0 - (mu * mu), 0.0));
    float airMass = mix(32.0, 1.0, clamp((mu * 0.5) + 0.5, 0.0, 1.0));
    airMass *= mix(1.0, 0.0350000001490116119384765625, altitude);
    airMass *= mix(1.0, 1.7999999523162841796875, horizon);
    vec3 rayleigh = vec3(0.00580199994146823883056640625, 0.0135580003261566162109375, 0.033100001513957977294921875) * max(sky.scatteringScale.x, 0.001000000047497451305389404296875);
    vec3 mie = vec3(0.0039960001595318317413330078125) * max(sky.scatteringScale.y, 0.001000000047497451305389404296875);
    vec3 absorption = vec3(0.0006500000017695128917694091796875, 0.001881000003777444362640380859375, 8.4999999671708792448043823242188e-05) * max(sky.scatteringScale.z, 0.001000000047497451305389404296875);
    vec3 transmittance = exp((-((rayleigh + mie) + absorption)) * airMass);
    imageStore(transmittanceLut, coord, vec4(clamp(transmittance, vec3(0.0), vec3(1.0)), airMass));
}


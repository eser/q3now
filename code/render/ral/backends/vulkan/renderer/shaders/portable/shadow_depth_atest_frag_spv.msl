#pragma clang diagnostic ignored "-Wmissing-prototypes"

#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

template<typename T>
struct spvDescriptor
{
    T value;
};

template<typename T>
struct spvDescriptorArray
{
    spvDescriptorArray(const device spvDescriptor<T>* ptr_) : ptr(&ptr_->value) {}
    spvDescriptorArray(const device void *ptr_) : spvDescriptorArray(static_cast<const device spvDescriptor<T>*>(ptr_)) {}
    const device T& operator [] (size_t i) const { return ptr[i]; }
    const device T* ptr;
};

struct spvDescriptorSetBuffer2
{
    spvDescriptor<texture2d<float>> wired_bindless_images [[id(0)]][1] /* unsized array hack */;
    // Overlapping binding: spvDescriptor<sampler> wired_bindless_samplers [[id(0)]][1] /* unsized array hack */;
};

struct main0_in
{
    float2 in_texcoord [[user(locn0)]];
    uint in_packed [[user(locn1)]];
};

fragment void main0(main0_in in [[stage_in]], const device spvDescriptorSetBuffer2& spvDescriptorSet2 [[buffer(2)]])
{
    spvDescriptorArray<texture2d<float>> wired_bindless_images {spvDescriptorSet2.wired_bindless_images};
    spvDescriptorArray<sampler> wired_bindless_samplers {reinterpret_cast<const device spvDescriptor<sampler>*>(&spvDescriptorSet2.wired_bindless_images)};

    uint atFunc = (in.in_packed >> uint(24)) & 255u;
    uint imgSlot = in.in_packed & 4095u;
    uint smpSlot = (in.in_packed >> uint(12)) & 255u;
    uint _34 = imgSlot;
    uint _43 = smpSlot;
    float a = wired_bindless_images[_34].sample(wired_bindless_samplers[_43], in.in_texcoord).w;
    if (atFunc == 1u)
    {
        if (a == 0.0)
        {
            discard_fragment();
        }
    }
    else
    {
        if (atFunc == 2u)
        {
            if (a >= 0.5)
            {
                discard_fragment();
            }
        }
        else
        {
            if (atFunc == 3u)
            {
                if (a < 0.5)
                {
                    discard_fragment();
                }
            }
        }
    }
}


            float3 param_1 = direction;
            float3 physicalSky = spvDescriptorSet0.skyViewLut.sample(spvDescriptorSet0.skyViewLutSmplr, skyViewUv(param_1), level(0.0)).xyz;
            float3 param_2 = scene;

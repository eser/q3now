static inline __attribute__((always_inline))
float3 skyDirection(thread const float2& screenUv, constant Params& p)
{
    float4 worldH = p.invViewProjection * float4((screenUv * 2.0) - float2(1.0), 0.0, 1.0);
    float3 world = worldH.xyz / float3(fast::max(abs(worldH.w), 9.9999999747524270787835121154785e-07));
    return fast::normalize(world - p.eyeSkyControl.xyz);
}

static inline __attribute__((always_inline))
float2 skyViewUv(thread const float3& direction)
{
    float azimuth = precise::atan2(direction.y, direction.x);
    float elevation = asin(fast::clamp(direction.z, -1.0, 1.0));
    return float2(fract((azimuth / 6.283185482025146484375) + 0.5), fast::clamp((elevation / 3.1415927410125732421875) + 0.5, 0.0, 1.0));
}

static inline __attribute__((always_inline))
float3 wiredComposeAuthoredPhysicalSky(thread const float3& authored, thread const float3& physical, thread const float& blend)
{
    float authoredEnergy = dot(fast::max(authored, float3(0.0)), float3(0.2125999927520751953125, 0.715200006961822509765625, 0.072200000286102294921875));
    float physicalEnergy = dot(fast::max(physical, float3(0.0)), float3(0.2125999927520751953125, 0.715200006961822509765625, 0.072200000286102294921875));
    if (authoredEnergy <= 9.9999997473787516355514526367188e-06)
    {
        return mix(authored, physical, float3(blend));
    }
    float scale = fast::clamp(physicalEnergy / fast::max(authoredEnergy, 0.180000007152557373046875), 0.64999997615814208984375, 1.75);
    float3 _279;
    if (physicalEnergy > 9.9999997473787516355514526367188e-06)
    {
        _279 = physical / float3(physicalEnergy);
    }
    else
    {
        _279 = float3(1.0);
    }
    float3 physicalTint = _279;
    float3 relit = ((authored * scale) * mix(float3(1.0), fast::clamp(physicalTint, float3(0.5), float3(2.0)), float3(0.119999997317790985107421875))) + (physical * 0.07999999821186065673828125);
    return mix(authored, relit, float3(blend));
}

static inline __attribute__((always_inline))
float3 wiredAerialInscatter(thread const float3& mediaColor, thread const float3& viewDir, constant Params& p, texture2d<float> skyViewLut, sampler skyViewLutSmplr, texturecube<float> currentSkyRadiance, sampler currentSkyRadianceSmplr)
{
    float aerial = fast::clamp(p.mediaHeight.w, 0.0, 1.0);
    if (aerial <= 0.0)
    {
        return mediaColor;
    }
    float3 _123;
    if (p.eyeSkyControl.w > 0.0)
    {
        float3 param = viewDir;
        _123 = skyViewLut.sample(skyViewLutSmplr, skyViewUv(param), level(0.0)).xyz;
    }
    else
    {
        _123 = currentSkyRadiance.sample(currentSkyRadianceSmplr, viewDir, level(4.0)).xyz;
    }
    float3 skyIn = _123;
    float3 skySum = ((((currentSkyRadiance.sample(currentSkyRadianceSmplr, float3(1.0, 0.0, 0.0), level(7.0)).xyz + currentSkyRadiance.sample(currentSkyRadianceSmplr, float3(-1.0, 0.0, 0.0), level(7.0)).xyz) + currentSkyRadiance.sample(currentSkyRadianceSmplr, float3(0.0, 1.0, 0.0), level(7.0)).xyz) + currentSkyRadiance.sample(currentSkyRadianceSmplr, float3(0.0, -1.0, 0.0), level(7.0)).xyz) + currentSkyRadiance.sample(currentSkyRadianceSmplr, float3(0.0, 0.0, 1.0), level(7.0)).xyz) + currentSkyRadiance.sample(currentSkyRadianceSmplr, float3(0.0, 0.0, -1.0), level(7.0)).xyz;
    float skyMean = fast::max(dot(skySum / float3(6.0), float3(0.2125999927520751953125, 0.715200006961822509765625, 0.072200000286102294921875)), 9.9999997473787516355514526367188e-05);
    float3 directional = skyIn / float3(skyMean);
    float3 sunDir = fast::normalize(float3(p.depthRange.w, p.radianceControl.w, p.mediaHeight.z) + float3(9.9999999747524270787835121154785e-07));
    float cosT = dot(viewDir, sunDir);
    float hg = 0.6974999904632568359375 / fast::max(powr(1.3025000095367431640625 - (1.10000002384185791015625 * cosT), 1.5), 9.9999997473787516355514526367188e-05);
    float3 tinted = mediaColor * mix(float3(1.0), fast::clamp(directional, float3(0.3499999940395355224609375), float3(3.0)), float3(aerial));
    return tinted * mix(1.0, 0.75 + (0.25 * hg), aerial);
}

kernel void main0(const device spvDescriptorSetBuffer0& spvDescriptorSet0 [[buffer(0)]], uint3 gl_GlobalInvocationID [[thread_position_in_grid]])
{
    uint2 pixel = gl_GlobalInvocationID.xy;

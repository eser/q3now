kernel void main0(const device spvDescriptorSetBuffer0& spvDescriptorSet0 [[buffer(0)]], constant GtaoPush& pc [[buffer(1)]], uint3 gl_GlobalInvocationID [[thread_position_in_grid]])
{
    int2 pix = int2(gl_GlobalInvocationID.xy);
    int2 dim = int2(pc.viewportSize);

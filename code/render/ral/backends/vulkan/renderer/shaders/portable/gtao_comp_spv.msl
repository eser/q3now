        float param_16 = fast::clamp(horizonCos1, -1.0, 1.0);
        float h0 = -fastAcos(param_16);
        float param_17 = fast::clamp(horizonCos0, -1.0, 1.0);
        float h1 = fastAcos(param_17);
        float iarc0 = ((cosN + ((2.0 * h0) * sin(n))) - cos((2.0 * h0) - n)) * 0.25;
        float iarc1 = ((cosN + ((2.0 * h1) * sin(n))) - cos((2.0 * h1) - n)) * 0.25;
        visibility += (projLen * (iarc0 + iarc1));
    }
    visibility /= float(pc.sliceCount);
    visibility = fast::clamp(visibility, 0.0, 1.0);
    visibility = powr(visibility, pc.finalPower);
    visibility = mix(1.0, visibility, fast::clamp(pc.intensity, 0.0, 1.0));
    visibility = fast::max(visibility, 0.0);
    float3 param_18 = P;
    float2 param_19 = texel;

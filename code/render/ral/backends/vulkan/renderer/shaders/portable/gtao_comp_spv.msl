static inline __attribute__((always_inline))
float sscsContact(thread const float3& P, thread const float2& texel, thread const float& _noise, constant GtaoPush& pc, texture2d<float> depthTex, sampler depthSampler)
{
    bool _304 = pc.sscsEnabled == 0;
    bool _312;
    if (!_304)
    {
        _312 = pc.sscsStrength <= 0.0;
    }
    else
    {
        _312 = _304;
    }
    if (_312)
    {
        return 1.0;
    }
    float3 L = pc.sscsSunDirVS.xyz;
    float stepLen = pc.sscsRadius / float(max(pc.sscsSteps, 1));
    float occluded = 0.0;
    for (int i = 1; i <= pc.sscsSteps; i++)
    {
        float t = ((float(i) - 0.5) + _noise) * stepLen;
        float3 sp = P + (L * t);
        if (sp.z <= 0.001000000047497451305389404296875)
        {
            break;
        }
        float2 ndc = ((sp.xy / float2(sp.z)) - pc.ndcToViewAdd) / pc.ndcToViewMul;
        float2 uvS = (ndc * 0.5) + float2(0.5);
        bool _386 = uvS.x < 0.0;
        bool _393;
        if (!_386)
        {
            _393 = uvS.x > 1.0;
        }
        else
        {
            _393 = _386;
        }
        bool _400;
        if (!_393)
        {
            _400 = uvS.y < 0.0;
        }
        else
        {
            _400 = _393;
        }
        bool _407;
        if (!_400)
        {
            _407 = uvS.y > 1.0;
        }
        else
        {
            _407 = _400;
        }
        if (_407)
        {
            break;
        }
        float2 param = uvS;
        float sceneVz = sampleViewDepth0(param, depthTex, depthSampler);
        if (sceneVz >= skyDepthThreshold(pc))
        {
            continue;
        }
        float diff = sp.z - sceneVz;
        bool _429 = diff > (stepLen * 0.5);
        bool _436;
        if (_429)
        {
            _436 = diff < pc.sscsRadius;
        }

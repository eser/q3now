            float w0 = fast::clamp((dist0 * falloffMul) + falloffAdd, 0.0, 1.0);
            float w1 = fast::clamp((dist1 * falloffMul) + falloffAdd, 0.0, 1.0);
            w0 = 1.0 - w0;

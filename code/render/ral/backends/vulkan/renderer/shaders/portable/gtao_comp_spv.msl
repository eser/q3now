kernel void main0(const device spvDescriptorSetBuffer0& spvDescriptorSet0 [[buffer(0)]], constant GtaoPush& pc [[buffer(1)]], uint3 gl_GlobalInvocationID [[thread_position_in_grid]])
{
    int2 pix = int2(gl_GlobalInvocationID.xy);
    int2 dim = int2(pc.viewportSize);
    bool _467 = pix.x >= dim.x;
    bool _476;
    if (!_467)
    {
        _476 = pix.y >= dim.y;
    }
    else
    {
        _476 = _467;
    }
    if (_476)
    {
        return;
    }
    float2 texel = float2(1.0) / pc.viewportSize;
    float2 uv = (float2(pix) + float2(0.5)) * texel;
    float2 param = uv;
    float centerZ = sampleViewDepth0(param, spvDescriptorSet0.depthTex, spvDescriptorSet0.depthSampler);
    if (centerZ >= skyDepthThreshold(pc))
    {
        spvDescriptorSet0.aoImage.write(float4(1.0), uint2(pix));
        return;
    }
    float2 param_1 = uv;
    float param_2 = centerZ;
    float3 P = viewPosFromUV(param_1, param_2, pc);
    float2 param_3 = uv;
    float3 param_4 = P;
    float2 param_5 = texel;
    float3 N = normalFromDepth(param_3, param_4, param_5, pc, spvDescriptorSet0.depthTex, spvDescriptorSet0.depthSampler);
    float3 V = fast::normalize(-P);
    float tanHalfFovX = 0.5 * abs(pc.ndcToViewMul.x);
    float screenRadiusUV = fast::clamp(pc.effectRadius / (P.z * fast::max(tanHalfFovX, 9.9999997473787516355514526367188e-05)), texel.x, 0.5);
    float2 param_6 = float2(pix);
    float _noise = ign(param_6);
    float visibility = 0.0;
    float falloffMul = 1.0 / fast::max(pc.effectRadius * pc.falloffRange, 9.9999997473787516355514526367188e-05);
    float falloffAdd = ((-pc.effectRadius) * (1.0 - pc.falloffRange)) * falloffMul;
    for (int slice = 0; slice < pc.sliceCount; slice++)
    {
        float sliceK = (float(slice) + _noise) / float(pc.sliceCount);
        float phi = sliceK * 3.1415927410125732421875;
        float2 dir = float2(cos(phi), sin(phi));
        float3 dirVec = float3(dir, 0.0);
        float3 orthoDir = dirVec - (V * dot(dirVec, V));
        float3 axis = fast::normalize(cross(orthoDir, V));
        float3 projN = N - (axis * dot(N, axis));
        float projLen = length(projN);
        if (projLen < 9.9999997473787516355514526367188e-06)
        {
            continue;
        }
        float signN = sign(dot(orthoDir, projN));
        float cosN = fast::clamp(dot(projN, V) / projLen, -1.0, 1.0);
        float param_7 = cosN;
        float n = signN * fastAcos(param_7);
        float horizonCos0 = cos(n + 1.57079637050628662109375);
        float horizonCos1 = cos(n - 1.57079637050628662109375);
        float minS = (1.5 * texel.x) / fast::max(screenRadiusUV, 9.9999997473787516355514526367188e-06);
        for (int _step = 0; _step < pc.stepsPerSlice; _step++)
        {
            float stepNoise = fract(_noise + (float((slice * pc.stepsPerSlice) + _step) * 0.61803400516510009765625));
            float s = (float(_step) + stepNoise) / float(pc.stepsPerSlice);
            s = powr(s, 2.0);
            s += minS;
            float2 off = (dir * s) * screenRadiusUV;
            float offPixels = length(off * pc.viewportSize);
            float mip = fast::clamp(log2(fast::max(offPixels, 1.0)) - 3.2999999523162841796875, 0.0, 4.0);
            float2 uv0 = uv + off;
            float2 uv1 = uv - off;
            float2 param_8 = uv0;
            float param_9 = mip;
            float z0 = sampleViewDepth(param_8, param_9, spvDescriptorSet0.depthTex, spvDescriptorSet0.depthSampler);
            float2 param_10 = uv1;
            float param_11 = mip;
            float z1 = sampleViewDepth(param_10, param_11, spvDescriptorSet0.depthTex, spvDescriptorSet0.depthSampler);
            float2 param_12 = uv0;
            float param_13 = z0;
            float3 s0 = viewPosFromUV(param_12, param_13, pc);
            float2 param_14 = uv1;
            float param_15 = z1;
            float3 s1 = viewPosFromUV(param_14, param_15, pc);
            float3 d0 = s0 - P;
            float3 d1 = s1 - P;
            float dist0 = length(d0);

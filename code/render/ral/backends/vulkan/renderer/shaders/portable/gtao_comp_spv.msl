static inline __attribute__((always_inline))
float ign(thread const float2& pix)
{
    return fract(52.98291778564453125 * fract(dot(pix, float2(0.067110560834407806396484375, 0.005837149918079376220703125))));
}

static inline __attribute__((always_inline))
float fastAcos(thread const float& x)
{
    float xa = abs(x);
    float r = (((-0.15658299624919891357421875) * xa) + 1.57079637050628662109375) * sqrt(1.0 - xa);

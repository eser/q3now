    float2 param_3 = uv;
    float3 param_4 = P;
    float2 param_5 = texel;
    float3 N = normalFromDepth(param_3, param_4, param_5, pc, spvDescriptorSet0.depthTex, spvDescriptorSet0.depthSampler);
    float3 V = fast::normalize(-P);

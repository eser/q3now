static inline __attribute__((always_inline))
float3 sRGBToLinear(thread float3& c)
{
    c = fast::max(c, float3(0.0));
    bool3 cutoff = c <= float3(0.040449999272823333740234375);
    float3 lo = c / float3(12.9200000762939453125);
    float3 hi = powr((c + float3(0.054999999701976776123046875)) / float3(1.05499994754791259765625), float3(2.400000095367431640625));
    return mix(hi, lo, float3(cutoff));
}

static inline __attribute__((always_inline))
float4 wired_bl_sample_domain(thread const uint& role, thread const float2& uv, thread const int& slot, const spvDescriptorArray<texture2d<float>> wired_bindless_images, constant UBO& _54, const spvDescriptorArray<sampler> wired_bindless_samplers)
{
    uint _256 = _54.packed_indices[role / 4u][role % 4u] & 4095u;
    uint _267 = (_54.packed_indices[role / 4u][role % 4u] >> uint(12)) & 255u;
    float4 c = wired_bindless_images[_256].sample(wired_bindless_samplers[_267], uv);
    if ((tex_domain & (1 << slot)) != 0)
    {
        return c;
    }
    float3 param = c.xyz;
    float3 _285 = sRGBToLinear(param);
    c.x = _285.x;
    c.y = _285.y;
    c.z = _285.z;
    return c;
}

static inline __attribute__((always_inline))
float CorrectAlpha(thread const float& threshold, thread const float& alpha, thread const float2& tc, const spvDescriptorArray<texture2d<float>> wired_bindless_images, constant UBO& _54, const spvDescriptorArray<sampler> wired_bindless_samplers)
{
    uint _63 = _54.packed_indices[0].x & 4095u;
    uint _77 = (_54.packed_indices[0].x >> uint(12)) & 255u;
    int2 ts = int2(wired_bindless_images[_63].get_width(), wired_bindless_images[_63].get_height());
    float dx = fast::max(abs(dfdx(tc.x * float(ts.x))), 0.001000000047497451305389404296875);
    float dy = fast::max(abs(dfdy(tc.y * float(ts.y))), 0.001000000047497451305389404296875);
    float dxy = fast::max(dx, dy);
    float scale = fast::max(1.0 / dxy, 1.0);
    float ac = threshold + ((alpha - threshold) * scale);
    return ac;
}

static inline __attribute__((always_inline))
bool wired_advanced_fog_enabled(constant UBO& _54)
{
    int fogType = int(_54.advancedFogTypeFarEnabled.x + 0.5);
    return ((_54.advancedFogTypeFarEnabled.z > 0.5) && (fogType >= 1)) && (fogType <= 3);
}

static inline __attribute__((always_inline))
float wired_advanced_fog_amount(constant UBO& _54, thread float4& gl_FragCoord)
{
    if (!wired_advanced_fog_enabled(_54))
    {
        return 0.0;
    }
    float viewDepth = 1.0 / fast::max(gl_FragCoord.w, 9.9999999747524270787835121154785e-07);
    int fogType = int(_54.advancedFogTypeFarEnabled.x + 0.5);
    if (fogType == 1)
    {
        if (_54.advancedFogTypeFarEnabled.y <= 0.0)
        {
            return 0.0;
        }
        return fast::clamp(viewDepth / _54.advancedFogTypeFarEnabled.y, 0.0, 1.0);
    }
    float opticalDepth = fast::max(_54.advancedFogColorDensity.w, 0.0) * viewDepth;
    if (fogType == 2)
    {
        return fast::clamp(1.0 - exp(-opticalDepth), 0.0, 1.0);
    }
    return fast::clamp(1.0 - exp(-(opticalDepth * opticalDepth)), 0.0, 1.0);
}

fragment main0_out main0(main0_in in [[stage_in]], const device spvDescriptorSetBuffer0& spvDescriptorSet0 [[buffer(0)]], const device spvDescriptorSetBuffer1& spvDescriptorSet1 [[buffer(1)]], float4 gl_FragCoord [[position]])

#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct UBO
{
    float4 _pad_to_mvp[30];
    float4x4 mvp;
};

struct spvDescriptorSetBuffer0
{
    constant UBO* ubo [[id(0)]];
};

struct main0_out
{
    float2 frag_tex_coord0 [[user(locn1)]];
    float2 frag_tex_coord1 [[user(locn2)]];
    float4 gl_Position [[position]];
};

struct main0_in
{
    float3 in_position [[attribute(0)]];
    float2 in_tex_coord0 [[attribute(2)]];
    float2 in_tex_coord1 [[attribute(3)]];
};

vertex main0_out main0(main0_in in [[stage_in]], const device spvDescriptorSetBuffer0& spvDescriptorSet0 [[buffer(0)]])
{
    main0_out out = {};
    out.gl_Position = (*spvDescriptorSet0.ubo).mvp * float4(in.in_position, 1.0);
    out.frag_tex_coord0 = in.in_tex_coord0;
    out.frag_tex_coord1 = in.in_tex_coord1;
    return out;
}


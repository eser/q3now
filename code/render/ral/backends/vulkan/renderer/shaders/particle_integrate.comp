#version 450

/*
particle_integrate.comp — wired-render particle compute shader

Reads from the "read" particle pool, integrates physics + age, writes
to the "write" pool. Each thread handles one particle slot indexed by
gl_GlobalInvocationID.x. Workgroup size = 64; dispatch ceil(poolSize/64).

A slot is dead when classHandle == 0 OR age >= 1.0. Dead slots are
written back as zero-filled (classHandle = 0) so the bounded GPU spawn
pass can recycle them through deterministic ring allocation.

World gravity is hardcoded to 800 units/sec² along world -Z (the q3
convention; cgame's cg_gravity defaults to 800).

Layout matches the host-side packed mirrors in vk.c:
    Particle         = 64 bytes per std430
    ParticleClassGPU = 400 bytes per std430
    ParticleFrame    = 128 bytes per std140
*/

#define PALETTE_MAX 16

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(constant_id = 0) const uint PARTICLE_PASS = 0u; // 0 integrate, 1 spawn

struct Particle {
	vec3  pos;
	float age;
	vec3  vel;
	float lifetimeInv;
	uint  classHandle;
	uint  paletteIndex;     // selected by GPU spawn, passed through unchanged by integrate
	float sizeJitterPick;   // per-particle sizeStart offset; passed through unchanged by integrate
	uint  pad1;
	uint  pad2;
	uint  pad3;
	uint  pad4;
	uint  pad5;
};

struct ParticleParm {
	int   calc;       // 0=CONSTANT 1=LINEAR 2=CURVE 3=CURVE_TIMES_LINEAR
	int   hasCurve;   // 0 = samples[] unused
	float val0;
	float val1;
	float variance;
	float parmPad0;
	float parmPad1;
	float parmPad2;
	float samples[8]; // PARTICLE_CURVE_SAMPLES; resolved host-side
};

// Evaluate a parm at a normalised lifetime fraction. Mirrors
// ParticleParm_Eval in qcommon/wired/render/particle_curve.c — the two are
// pinned against each other by tests/particle_curve_test.c, because a
// divergence here renders something other than what was authored without
// ever failing loudly.
float parmSampleCurve( ParticleParm p, float fraction ) {
	if ( p.hasCurve == 0 )
		return 1.0;                       // neutral, never a zeroing surprise
	if ( fraction <= 0.0 ) return p.samples[0];
	if ( fraction >= 1.0 ) return p.samples[7];
	// Samples span 0..1 INCLUSIVE, so the last sample sits AT fraction 1 and
	// the span is (N-1) intervals. Using N here shifts every curve slightly.
	float pos  = fraction * 7.0;
	int   i0   = int( pos );
	int   i1   = min( i0 + 1, 7 );
	float frac = pos - float( i0 );
	return mix( p.samples[i0], p.samples[i1], frac );
}

float parmEval( ParticleParm p, float fraction, float jitterPick ) {
	fraction = clamp( fraction, 0.0, 1.0 );
	float base;
	if ( p.calc == 1 ) {                  // LINEAR
		base = mix( p.val0, p.val1, fraction );
	} else if ( p.calc == 2 ) {           // CURVE
		base = mix( p.val0, p.val1, parmSampleCurve( p, fraction ) );
	} else if ( p.calc == 3 ) {           // CURVE_TIMES_LINEAR
		base = parmSampleCurve( p, fraction ) * mix( p.val0, p.val1, fraction );
	} else {                              // CONSTANT
		base = p.val0;
	}
	return base + p.variance * jitterPick;
}

// A parm that was never authored: constant zero. Callers fall back to the
// scalar field it overrides, which is what keeps pre-curve classes
// rendering bit-identically.
bool parmIsUnset( ParticleParm p ) {
	return p.calc == 0 && p.val0 == 0.0;
}

struct ParticleClassGPU {
	uint  shader;
	uint  renderFlags;
	uint  emitMode;
	uint  scatterShape;
	float scatterMagnitude;
	uint  velocityShape;
	float axialSpeed;
	float cubeJitter;
	float coneHalfAngle;
	float lifetimeMean;
	float lifetimeJitter;
	int   paletteCount;
	vec4  colorPalette[PALETTE_MAX];
	vec4  colorEndMult;
	float sizeStart;
	float sizeEnd;
	float gravityScale;
	float drag;
	uint  shaderBlendIsAdditive;  // phase 5; 0 = alpha, 1 = additive (compute does not use this; field present for std430 layout match)
	uint  pad1;
	uint  pad2;
	uint  pad3;
	// Expressivity extension fields — compute does not consume any of
	// these. They are present here purely so the std430 layout matches
	// host particleClassGPU_t and the renderer-side particle.vert
	// mirror; classes[] SSBO indexing would drift otherwise.
	vec4  velocityBias;
	vec4  velocityBiasJitter;
	float speedJitter;
	float sizeJitter;
	uint  colorDomain;   // Block 5d-followup: was pad4 — CD_SRGB(0)|CD_LINEAR(1); compute does not consume it.
	uint  pad5;
	// Sprite-frame (flipbook) animation — compute does not consume these;
	// present so the std430 layout matches host particleClassGPU_t and
	// the particle.vert mirror (classes[] SSBO stride would drift otherwise).
	uint  frameSlots[16];
	uint  frameCount;
	uint  frameBlend;
	uint  framePad0;
	uint  framePad1;
	// Curve-valued parameters — mirrors particleClassGPU_t. A parm with
	// calc==0 and val0==0 was never authored; the reader falls back to the
	// scalar field it overrides, which is what keeps pre-curve classes
	// rendering bit-identically.
	ParticleParm sizeParm;
	ParticleParm alphaParm;
	ParticleParm dragParm;
	ParticleParm gravityParm;
};

layout(set = 0, binding = 0) uniform ParticleFrame {
	mat4  mvp;
	vec4  viewLeft;
	vec4  viewUp;
	vec4  eyeWorld;
	float dt;
	uint  poolSize;
	uint  numClasses;
	uint  pingPongRead;
	// 16 B of std140 vec4-stride padding so the layout matches host
	// particleFrame_t and the particle.vert / particle.frag mirrors;
	// compute consumes none of it. pad0 (offset 128) was the legacy
	// `identityLight` halving factor — since dropped, the field
	// removed in a later cleanup sweep.
	float pad0;
	float pad1;
	float pad2;
	float pad3;
};

layout(std430, set = 0, binding = 1) buffer ReadPool {
	Particle readParticles[];
};

layout(std430, set = 0, binding = 2) writeonly buffer WritePool {
	Particle writeParticles[];
};

layout(std430, set = 0, binding = 3) readonly buffer Classes {
	ParticleClassGPU classes[];
};

struct ParticleSpawnRequest {
	vec4 origin;
	vec4 axis;
	vec4 end;
	vec4 colorTint;
	uint classHandle;
	uint count;
	uint firstSlot;
	uint seed;
	uint profileHandle;
	uint stageIndex;
	uint stageFlags;
	uint reserved;
};

layout(std430, set = 0, binding = 4) readonly buffer SpawnRequests {
	ParticleSpawnRequest spawnRequests[];
};

struct AtmosphereEffectStage {
	uint trigger;
	uint particleClass;
	uint parentStage;
	uint flags;
	uint maxParticles;
	uint burstCount;
	float spawnRate;
	float delay;
	float duration;
	float lodNear;
	float lodFar;
	float boundsRadius;
	float intensityScale;
	uint reserved0;
	uint reserved1;
	uint reserved2;
};

struct AtmosphereEffectProfile {
	uint schemaVersion;
	uint stageCount;
	uint maxParticles;
	uint flags;
	uint parentProfile;
	uint stageOverrideMask;
	uint seed;
	uint reserved0;
	float duration;
	float lodNear;
	float lodFar;
	float boundsRadius;
	AtmosphereEffectStage stages[8];
	uint reserved[8];
};

layout(std430, set = 0, binding = 5) readonly buffer AtmosphereProfiles {
	AtmosphereEffectProfile atmosphereProfiles[];
};

struct ParticleChildEvent {
	vec4 origin;
	vec4 velocity;
	vec4 colorTint;
	uint profileHandle;
	uint stageIndex;
	uint count;
	uint seed;
};

layout(std430, set = 0, binding = 6) buffer ChildEvents {
	uint dispatchX;
	uint dispatchY;
	uint dispatchZ;
	uint dispatchPad;
	uint eventCount;
	uint particleCursor;
	uint droppedEvents;
	uint droppedParticles;
	uint eventBaseSlot;
	uint particleBudget;
	uint eventCapacity;
	uint collisionEnabled;
	vec2 collisionWorldMins;
	vec2 collisionWorldMaxs;
	ParticleChildEvent childEvents[1024];
	uint stageParticles[512];
	uint profileParticles[64];
};

layout(set = 0, binding = 7) uniform sampler2D collisionHeightgrid;

const uint ATMOSPHERE_PROFILE_MAX = 64u;
const uint ATMOSPHERE_STAGE_MAX = 8u;
const uint CHILD_SPAWN_MAX = 64u;
const uint STAGE_EMISSION = 0u;
const uint STAGE_CONTINUOUS = 1u;
const uint STAGE_COLLISION = 2u;
const uint STAGE_DEATH = 3u;
const uint INHERIT_VELOCITY = 2u;
const uint INHERIT_COLOR = 4u;
const uint INHERIT_INTENSITY = 8u;

const float WORLD_GRAVITY = 800.0;

Particle deadParticle() {
	Particle p;
	p.pos            = vec3(0.0);
	p.age            = 0.0;
	p.vel            = vec3(0.0);
	p.lifetimeInv    = 0.0;
	p.classHandle    = 0u;
	p.paletteIndex   = 0u;
	p.sizeJitterPick = 0.0;
	p.pad1           = 0u;
	p.pad2           = 0u;
	p.pad3           = 0u;
	p.pad4           = 0u;
	p.pad5           = 0u;
	return p;
}

uint spawnHash( uint value ) {
	value ^= value >> 16;
	value *= 0x7feb352du;
	value ^= value >> 15;
	value *= 0x846ca68bu;
	value ^= value >> 16;
	return value;
}

float spawn01( uint seed, uint ordinal, uint lane ) {
	return float( spawnHash( seed ^ ( ordinal * 747796405u )
		^ ( lane * 2891336453u ) ) ) * ( 1.0 / 4294967296.0 );
}

float spawnSigned( uint seed, uint ordinal, uint lane ) {
	return spawn01( seed, ordinal, lane ) * 2.0 - 1.0;
}

vec3 spawnAxis( vec3 axis ) {
	float lengthSquared = dot( axis, axis );
	return lengthSquared > 1e-8 ? axis * inversesqrt( lengthSquared )
		: vec3( 0.0, 0.0, 1.0 );
}

Particle buildSpawnParticle( ParticleSpawnRequest request, uint ordinal ) {
	if ( request.classHandle == 0u || request.classHandle > numClasses
			|| request.count == 0u || poolSize == 0u ) return deadParticle();
	ParticleClassGPU c = classes[request.classHandle - 1u];
	vec3 axis = spawnAxis( request.axis.xyz );
	vec3 base = request.origin.xyz;
	if ( c.emitMode != 0u ) {
		float pathFraction = ( float( ordinal ) + 0.5 ) / float( request.count );
		base = mix( request.origin.xyz, request.end.xyz, pathFraction );
	}
	vec3 scatter = vec3( 0.0 );
	if ( c.scatterShape == 1u ) {
		scatter = vec3( spawnSigned( request.seed, ordinal, 1u ),
			spawnSigned( request.seed, ordinal, 2u ),
			spawnSigned( request.seed, ordinal, 3u ) ) * c.scatterMagnitude;
	} else if ( c.scatterShape == 2u ) {
		float z = spawnSigned( request.seed, ordinal, 4u );
		float phi = spawn01( request.seed, ordinal, 5u ) * 6.28318530718;
		float radial = sqrt( max( 0.0, 1.0 - z * z ) );
		float radius = pow( spawn01( request.seed, ordinal, 6u ), 1.0 / 3.0 )
			* c.scatterMagnitude;
		scatter = vec3( radial * cos( phi ), radial * sin( phi ), z ) * radius;
	} else if ( c.scatterShape == 3u ) {
		vec3 tangent = normalize( abs( axis.z ) < 0.999
			? cross( axis, vec3( 0.0, 0.0, 1.0 ) )
			: cross( axis, vec3( 0.0, 1.0, 0.0 ) ) );
		vec3 bitangent = cross( axis, tangent );
		float radius = sqrt( spawn01( request.seed, ordinal, 7u ) )
			* c.scatterMagnitude;
		float phi = spawn01( request.seed, ordinal, 8u ) * 6.28318530718;
		scatter = ( tangent * cos( phi ) + bitangent * sin( phi ) ) * radius;
	}
	float speed = c.axialSpeed
		+ spawnSigned( request.seed, ordinal, 9u ) * c.speedJitter;
	vec3 velocity;
	if ( c.velocityShape == 0u ) {
		velocity = axis * speed;
	} else if ( c.velocityShape == 1u ) {
		velocity = axis * speed + vec3(
			spawnSigned( request.seed, ordinal, 10u ),
			spawnSigned( request.seed, ordinal, 11u ),
			spawnSigned( request.seed, ordinal, 12u ) ) * c.cubeJitter;
	} else if ( c.velocityShape == 2u ) {
		vec3 tangent = normalize( abs( axis.z ) < 0.999
			? cross( axis, vec3( 0.0, 0.0, 1.0 ) )
			: cross( axis, vec3( 0.0, 1.0, 0.0 ) ) );
		vec3 bitangent = cross( axis, tangent );
		float cosHalf = cos( c.coneHalfAngle );
		float z = mix( cosHalf, 1.0, spawn01( request.seed, ordinal, 13u ) );
		float radial = sqrt( max( 0.0, 1.0 - z * z ) );
		float phi = spawn01( request.seed, ordinal, 14u ) * 6.28318530718;
		velocity = ( axis * z + tangent * ( radial * cos( phi ) )
			+ bitangent * ( radial * sin( phi ) ) ) * speed;
	} else {
		velocity = vec3( spawnSigned( request.seed, ordinal, 15u ),
			spawnSigned( request.seed, ordinal, 16u ),
			spawnSigned( request.seed, ordinal, 17u ) ) * c.cubeJitter;
	}
	velocity += c.velocityBias.xyz + vec3(
		spawnSigned( request.seed, ordinal, 18u ),
		spawnSigned( request.seed, ordinal, 19u ),
		spawnSigned( request.seed, ordinal, 20u ) ) * c.velocityBiasJitter.xyz;
	float lifetime = max( 0.001, c.lifetimeMean
		+ spawnSigned( request.seed, ordinal, 21u ) * c.lifetimeJitter );
	Particle p = deadParticle();
	p.pos = base + scatter;
	p.vel = velocity;
	p.lifetimeInv = 1.0 / lifetime;
	p.classHandle = request.classHandle;
	p.paletteIndex = c.paletteCount > 1
		? spawnHash( request.seed ^ ordinal ^ 0x9e3779b9u ) % uint( c.paletteCount )
		: 0u;
	p.sizeJitterPick = spawnSigned( request.seed, ordinal, 22u ) * c.sizeJitter;
	p.pad1 = request.profileHandle;
	p.pad2 = request.stageIndex;
	p.pad3 = request.seed ^ ordinal;
	p.pad4 = request.stageFlags;
	p.pad5 = packUnorm4x8( clamp( request.colorTint, vec4( 0.0 ), vec4( 1.0 ) ) );
	return p;
}

bool particleHasCollisionChild( Particle p ) {
	if ( p.pad1 == 0u || p.pad1 > ATMOSPHERE_PROFILE_MAX
			|| p.pad2 >= ATMOSPHERE_STAGE_MAX ) return false;
	uint count = min( atmosphereProfiles[p.pad1 - 1u].stageCount,
		ATMOSPHERE_STAGE_MAX );
	for ( uint i = 0u; i < count; ++i ) {
		AtmosphereEffectStage stage = atmosphereProfiles[p.pad1 - 1u].stages[i];
		if ( stage.parentStage == p.pad2 && stage.trigger == STAGE_COLLISION )
			return true;
	}
	return false;
}

bool particleCollided( Particle p ) {
	if ( collisionEnabled == 0u ) return false;
	vec2 extent = collisionWorldMaxs - collisionWorldMins;
	if ( any( lessThanEqual( extent, vec2( 0.0 ) ) )
			|| any( lessThan( p.pos.xy, collisionWorldMins ) )
			|| any( greaterThan( p.pos.xy, collisionWorldMaxs ) ) ) return false;
	vec2 uv = clamp( ( p.pos.xy - collisionWorldMins ) / extent,
		vec2( 0.0 ), vec2( 1.0 ) );
	return p.pos.z <= texture( collisionHeightgrid, uv ).r;
}

uint stageTriggerCount( AtmosphereEffectStage stage, Particle p,
		float previousAge, float currentAge, bool collided, bool died ) {
	float lifetime = p.lifetimeInv > 0.0 ? 1.0 / p.lifetimeInv : 0.0;
	float previousSeconds = previousAge * lifetime;
	float currentSeconds = currentAge * lifetime;
	uint count = 0u;
	if ( stage.trigger == STAGE_EMISSION || stage.trigger == STAGE_CONTINUOUS ) {
		float previousActive = clamp( previousSeconds - stage.delay,
			0.0, stage.duration );
		float currentActive = clamp( currentSeconds - stage.delay,
			0.0, stage.duration );
		if ( previousSeconds <= stage.delay && currentSeconds > stage.delay )
			count += stage.burstCount;
		float before = floor( previousActive * stage.spawnRate + 1e-5 );
		float after = floor( currentActive * stage.spawnRate + 1e-5 );
		if ( after > before ) count += uint( after - before );
	} else if ( stage.trigger == STAGE_COLLISION && collided
			&& currentSeconds >= stage.delay
			&& currentSeconds <= stage.delay + stage.duration ) {
		count = stage.burstCount
			+ uint( ceil( stage.spawnRate * min( dt, stage.duration ) ) );
	} else if ( stage.trigger == STAGE_DEATH && died
			&& currentSeconds >= stage.delay
			&& currentSeconds <= stage.delay + stage.duration ) {
		count = stage.burstCount
			+ uint( ceil( stage.spawnRate * min( dt, stage.duration ) ) );
	}
	vec4 parentTint = unpackUnorm4x8( p.pad5 );
	float intensity = ( stage.flags & INHERIT_INTENSITY ) != 0u
		? parentTint.a : 1.0;
	count = uint( ceil( float( count ) * intensity * stage.intensityScale ) );
	return min( min( count, stage.maxParticles ), CHILD_SPAWN_MAX );
}

void appendChildEvents( Particle p, float previousAge, float currentAge,
		bool collided, bool died ) {
	if ( p.pad1 == 0u || p.pad1 > ATMOSPHERE_PROFILE_MAX
			|| p.pad2 >= ATMOSPHERE_STAGE_MAX ) return;
	uint stageCount = min( atmosphereProfiles[p.pad1 - 1u].stageCount,
		ATMOSPHERE_STAGE_MAX );
	for ( uint i = 0u; i < stageCount; ++i ) {
		AtmosphereEffectStage stage = atmosphereProfiles[p.pad1 - 1u].stages[i];
		if ( stage.parentStage != p.pad2 ) continue;
		if ( stage.lodFar > 0.0
				&& distance( p.pos, eyeWorld.xyz ) > stage.lodFar ) continue;
		uint count = stageTriggerCount( stage, p, previousAge, currentAge,
			collided, died );
		if ( count == 0u ) continue;
		uint stageCounterIndex = ( p.pad1 - 1u ) * ATMOSPHERE_STAGE_MAX + i;
		uint stageBefore = atomicAdd( stageParticles[stageCounterIndex], count );
		uint stageAccepted = stageBefore < stage.maxParticles
			? min( count, stage.maxParticles - stageBefore ) : 0u;
		uint profileBefore = atomicAdd( profileParticles[p.pad1 - 1u],
			stageAccepted );
		uint profileBudget = atmosphereProfiles[p.pad1 - 1u].maxParticles;
		uint accepted = profileBefore < profileBudget
			? min( stageAccepted, profileBudget - profileBefore ) : 0u;
		if ( accepted < count ) atomicAdd( droppedParticles, count - accepted );
		count = accepted;
		if ( count == 0u ) continue;
		uint eventIndex = atomicAdd( eventCount, 1u );
		if ( eventIndex >= eventCapacity ) {
			atomicAdd( droppedEvents, 1u );
			atomicAdd( droppedParticles, count );
			continue;
		}
		vec4 parentTint = unpackUnorm4x8( p.pad5 );
		vec4 tint = vec4( 1.0 );
		if ( ( stage.flags & INHERIT_COLOR ) != 0u )
			tint.rgb = parentTint.rgb;
		if ( ( stage.flags & INHERIT_INTENSITY ) != 0u )
			tint.a = parentTint.a;
		tint.a = clamp( tint.a * stage.intensityScale, 0.0, 1.0 );
		ParticleChildEvent event;
		event.origin = vec4( p.pos, 1.0 );
		event.velocity = vec4( ( stage.flags & INHERIT_VELOCITY ) != 0u
			? p.vel : vec3( 0.0, 0.0, 1.0 ), 0.0 );
		event.colorTint = tint;
		event.profileHandle = p.pad1;
		event.stageIndex = i;
		event.count = count;
		event.seed = spawnHash( p.pad3 ^ ( i * 2246822519u )
			^ floatBitsToUint( currentAge ) );
		childEvents[eventIndex] = event;
	}
}

shared uint childFirstSlot;
shared uint childAcceptedCount;

void main() {
	if ( PARTICLE_PASS == 3u ) {
		if ( gl_GlobalInvocationID.x == 0u ) {
			dispatchX = min( eventCount, eventCapacity );
			dispatchY = 1u;
			dispatchZ = 1u;
		}
		return;
	}
	if ( PARTICLE_PASS == 2u ) {
		uint eventIndex = gl_WorkGroupID.x;
		if ( eventIndex >= min( eventCount, eventCapacity ) ) return;
		ParticleChildEvent event = childEvents[eventIndex];
		if ( event.profileHandle == 0u
				|| event.profileHandle > ATMOSPHERE_PROFILE_MAX
				|| event.stageIndex >= ATMOSPHERE_STAGE_MAX
				|| event.stageIndex >= atmosphereProfiles[event.profileHandle - 1u].stageCount )
			return;
		AtmosphereEffectStage stage =
			atmosphereProfiles[event.profileHandle - 1u].stages[event.stageIndex];
		if ( gl_LocalInvocationID.x == 0u ) {
			uint requested = min( event.count, CHILD_SPAWN_MAX );
			uint cursor = atomicAdd( particleCursor, requested );
			childFirstSlot = ( eventBaseSlot + cursor ) % max( poolSize, 1u );
			childAcceptedCount = cursor < particleBudget
				? min( requested, particleBudget - cursor ) : 0u;
			if ( childAcceptedCount < requested )
				atomicAdd( droppedParticles, requested - childAcceptedCount );
		}
		barrier();
		uint ordinal = gl_LocalInvocationID.x;
		if ( ordinal < childAcceptedCount ) {
			ParticleSpawnRequest request;
			request.origin = event.origin;
			request.axis = event.velocity;
			request.end = event.origin;
			request.colorTint = event.colorTint;
			request.classHandle = stage.particleClass;
			request.count = childAcceptedCount;
			request.firstSlot = childFirstSlot;
			request.seed = event.seed;
			request.profileHandle = event.profileHandle;
			request.stageIndex = event.stageIndex;
			request.stageFlags = stage.flags;
			request.reserved = 0u;
			Particle child = buildSpawnParticle( request, ordinal );
			if ( ( stage.flags & INHERIT_VELOCITY ) != 0u )
				child.vel += event.velocity.xyz;
			writeParticles[( childFirstSlot + ordinal ) % poolSize] = child;
		}
		return;
	}
	if ( PARTICLE_PASS == 1u ) {
		uint requestIndex = gl_WorkGroupID.x;
		uint ordinal = gl_WorkGroupID.y * gl_WorkGroupSize.x
			+ gl_LocalInvocationID.x;
		ParticleSpawnRequest request = spawnRequests[requestIndex];
		if ( ordinal < request.count )
			readParticles[( request.firstSlot + ordinal ) % poolSize]
				= buildSpawnParticle( request, ordinal );
		return;
	}
	uint idx = gl_GlobalInvocationID.x;
	if (idx >= poolSize) return;

	Particle p = readParticles[idx];

	if (p.classHandle == 0u || p.age >= 1.0 || p.classHandle > numClasses) {
		writeParticles[idx] = deadParticle();
		return;
	}

	ParticleClassGPU c = classes[p.classHandle - 1u];

	// Integrate. Q3 world is z-up; gravity acts along -Z.
	//
	// gravityParm / dragParm, when authored, replace the constants. Both are
	// evaluated at the particle's CURRENT age, so they vary as it lives —
	// "heavy at first, then float", "slow abruptly at the end" — which a
	// single constant cannot express at all.
	//
	// Unauthored parms take the fallback branch and the arithmetic is
	// byte-identical to what it was, so classes that never opt in are not
	// merely visually unchanged: they execute the same instructions.
	float gScale = parmIsUnset(c.gravityParm)
	             ? c.gravityScale
	             : parmEval(c.gravityParm, p.age, p.sizeJitterPick);
	float dragV  = parmIsUnset(c.dragParm)
	             ? c.drag
	             : parmEval(c.dragParm, p.age, p.sizeJitterPick);

	float previousAge = p.age;
	p.vel.z += -WORLD_GRAVITY * gScale * dt;
	p.vel   *= exp(-dragV * dt);
	p.pos   += p.vel * dt;
	p.age   += dt * p.lifetimeInv;

	bool died = p.age >= 1.0;
	bool collided = particleHasCollisionChild( p ) && particleCollided( p );
	appendChildEvents( p, previousAge, p.age, collided, died || collided );

	if ( died || collided ) {
		writeParticles[idx] = deadParticle();
		return;
	}

	writeParticles[idx] = p;
}

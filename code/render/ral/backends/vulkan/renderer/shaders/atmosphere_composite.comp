#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set=0,binding=0) uniform Params {
	uvec4 outputGrid;
	vec4 depthRange; // near, far, depth-valid, froxel slice count
} p;
layout(set=0,binding=1) uniform sampler2D sceneHdr;
layout(set=0,binding=2) uniform sampler2D sceneDepth;
layout(std430,set=0,binding=3) readonly buffer Integrated { vec4 media[]; };
layout(set=0,binding=4,rgba16f) uniform writeonly image2D composedHdr;

void main() {
	uvec2 pixel = gl_GlobalInvocationID.xy;
	if (any(greaterThanEqual(pixel, p.outputGrid.xy))) return;
	vec2 uv = (vec2(pixel) + 0.5) / vec2(p.outputGrid.xy);
	float depth = p.depthRange.z > 0.5 ? texture(sceneDepth, uv).r : 0.0;
	float linearFraction = depth <= 0.0 ? 1.0 : clamp(1.0 - depth, 0.0, 1.0);
	uvec2 froxelXY = min(uvec2(uv * vec2(p.outputGrid.zw)), p.outputGrid.zw - 1u);
	uint slices = uint(max(p.depthRange.w, 1.0));
	uint z = min(uint(linearFraction * float(slices)), slices - 1u);
	uint index = (z * p.outputGrid.w + froxelXY.y) * p.outputGrid.z + froxelXY.x;
	vec4 atmosphere = media[index];
	vec3 scene = texture(sceneHdr, uv).rgb;
	imageStore(composedHdr, ivec2(pixel),
		vec4(scene * atmosphere.a + atmosphere.rgb, 1.0));
}

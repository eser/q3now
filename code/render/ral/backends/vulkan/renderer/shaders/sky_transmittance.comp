#version 450

// Bounded physical-sky transmittance product.  The dimensions are fixed by the
// RAL sky product contract (256x64); the shader still bounds-checks imageSize so
// backend validation fixtures can use smaller targets.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(std140, set = 0, binding = 0) uniform SkyParams {
	vec4 sunDirectionAngularRadius;
	vec4 sunRadiance;
	vec4 moonDirectionAngularRadius;
	vec4 moonRadiance;
	vec4 atmosphereRadii;
	vec4 scatteringScale;
	vec4 groundExposure;
} sky;

layout(rgba16f, set = 0, binding = 1) uniform writeonly image2D transmittanceLut;

void main()
{
	ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
	ivec2 extent = imageSize(transmittanceLut);
	if (any(greaterThanEqual(coord, extent))) return;

	vec2 uv = (vec2(coord) + 0.5) / vec2(extent);
	float altitude = uv.y;
	float mu = uv.x * 2.0 - 1.0;
	float horizon = sqrt(max(1.0 - mu * mu, 0.0));
	float airMass = mix(32.0, 1.0, clamp(mu * 0.5 + 0.5, 0.0, 1.0));
	airMass *= mix(1.0, 0.035, altitude);
	airMass *= mix(1.0, 1.8, horizon);

	vec3 rayleigh = vec3(5.802, 13.558, 33.100) * 1e-3
		* max(sky.scatteringScale.x, 0.001);
	vec3 mie = vec3(3.996) * 1e-3 * max(sky.scatteringScale.y, 0.001);
	vec3 absorption = vec3(0.650, 1.881, 0.085) * 1e-3
		* max(sky.scatteringScale.z, 0.001);
	vec3 transmittance = exp(-(rayleigh + mie + absorption) * airMass);
	imageStore(transmittanceLut, coord,
		vec4(clamp(transmittance, vec3(0.0), vec3(1.0)), airMass));
}

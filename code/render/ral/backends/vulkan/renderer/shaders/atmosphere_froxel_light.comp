#version 450

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

struct ForwardLight {
	vec4 positionRadius;
	vec4 colorInvRadius2;
	vec4 endpointLinear;
};

layout(set=0,binding=0) uniform Params {
	mat4 invViewProjection;
	vec4 eyeNear;
	vec4 farPad;
	uvec4 gridLightCount;
	vec4 sunDirectionIntensity;
	vec4 sunColorCloudShadow;
	vec4 moonDirectionIntensity;
	vec4 moonColorLightning;
	vec4 ambientCloud;
} p;
layout(std430,set=0,binding=1) readonly buffer Media {
	vec4 scatteringExtinction[];
};
// Reuse the shipping Forward+ producer directly. One 16x16 screen tile owns
// 33 uints: count + at most 32 light indices. Froxel XY is the same grid.
layout(std430,set=0,binding=2) readonly buffer TileLights { uint tileLight[]; };
layout(std430,set=0,binding=3) readonly buffer Lights { ForwardLight light[]; };
layout(std430,set=0,binding=4) writeonly buffer LitMedia { vec4 radianceExtinction[]; };

void main() {
	uvec3 c = gl_GlobalInvocationID.xyz;
	uvec3 dims = p.gridLightCount.xyz;
	if (any(greaterThanEqual(c, dims))) return;
	uint index = (c.z * dims.y + c.y) * dims.x + c.x;
	vec4 medium = scatteringExtinction[index];
	vec2 uv = (vec2(c.xy) + 0.5) / vec2(dims.xy);
	float slice = (float(c.z) + 0.5) / float(dims.z);
	float nearZ = max(p.eyeNear.w, 0.01);
	float farZ = max(p.farPad.x, nearZ + 0.01);
	float distanceZ = nearZ * pow(farZ / nearZ, slice);
	vec4 worldH = p.invViewProjection * vec4(uv * 2.0 - 1.0,
		1.0 - nearZ / distanceZ, 1.0);
	vec3 world = worldH.xyz / max(abs(worldH.w), 1e-6);
	vec3 illumination = p.ambientCloud.rgb;
	illumination += p.sunColorCloudShadow.rgb
		* p.sunDirectionIntensity.w * (1.0 - p.sunColorCloudShadow.w);
	illumination += p.moonColorLightning.rgb * p.moonDirectionIntensity.w;
	illumination += p.moonColorLightning.www;
	uint tile = c.y * dims.x + c.x;
	uint base = tile * 33u;
	uint count = min(min(tileLight[base], 32u), p.gridLightCount.w);
	for (uint i = 0u; i < count; ++i) {
		uint lightIndex = tileLight[base + 1u + i];
		if (lightIndex >= p.gridLightCount.w) continue;
		ForwardLight l = light[lightIndex];
		vec3 delta = l.positionRadius.xyz - world;
		float radius = max(l.positionRadius.w, 0.001);
		float attenuation = max(1.0 - length(delta) / radius, 0.0);
		attenuation *= attenuation;
		illumination += l.colorInvRadius2.rgb * attenuation;
	}
	radianceExtinction[index] = vec4(medium.rgb * illumination, medium.a);
}

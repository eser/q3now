#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform texture2D currentColor;
layout(set = 0, binding = 1) uniform texture2D currentDeviceDepth;
layout(set = 0, binding = 2) uniform texture2D previousColor;
layout(set = 0, binding = 3) uniform texture2D previousLinearDepth;
layout(set = 0, binding = 4) uniform texture2D motionVelocity;
layout(set = 0, binding = 5) uniform texture2D motionValidity;
layout(set = 0, binding = 6) uniform sampler nearestSampler;
layout(rgba16f, set = 0, binding = 7) uniform writeonly image2D resolvedColor;
// History commit, folded into the resolve: the pair the next frame reads. It receives exactly what the separate store pass
// used to copy (the resolved colour and the same frame's linear depth), so the store pass only dispatches on the bootstrap path.
layout(rgba16f, set = 0, binding = 8) uniform writeonly image2D historyOutColor;
layout(r32f, set = 0, binding = 9) uniform writeonly image2D historyOutLinearDepth;

// One 8x8 workgroup reads a 10x10 tile (its pixels plus a one texel halo) of the current colour and device depth once. The 3x3
// neighbourhood box, the velocity dilation and the stored history depth read workgroup memory instead of issuing nine texture
// fetches per pixel. Halo texels outside the image are clamped, exactly like the per-fetch clamp they replace.
const int tileSide = 10;
const uint tileCount = 100u;
shared vec4 tileColor[100];
shared float tileDepth[100];

layout(push_constant) uniform TemporalResolvePush {
	uvec2 extent;
	vec2 currentEffectiveJitterUv;
	vec2 previousEffectiveJitterUv;
	float zNear;
	float zFar;
	float depthThresholdAbsolute;
	float depthThresholdRelative;
	float historyWeight;
	uint historyReadIndex;
	uint qualityFlags;
} pc;

bool finite1(float v) { return v == v && abs(v) <= 3.402823466e38; }
bool finite2(vec2 v) { return all(equal(v, v)) && all(lessThanEqual(abs(v), vec2(3.402823466e38))); }
bool finite3(vec3 v) { return all(equal(v, v)) && all(lessThanEqual(abs(v), vec3(3.402823466e38))); }
bool finite4(vec4 v) { return all(equal(v, v)) && all(lessThanEqual(abs(v), vec4(3.402823466e38))); }

float linearizeDepth(float z) {
	precise float range = pc.zFar - pc.zNear;
	precise float scaled = z * range;
	precise float denominator = pc.zNear + scaled;
	precise float numerator = pc.zNear * pc.zFar;
	precise float result = numerator / denominator;
	return result;
}

float mixPrecise(float x, float y, float a) {
	precise float oneMinus = 1.0 - a;
	precise float left = x * oneMinus;
	precise float right = y * a;
	precise float result = left + right;
	return result;
}

vec3 mixPrecise(vec3 x, vec3 y, float a) {
	precise float oneMinus = 1.0 - a;
	precise vec3 left = x * oneMinus;
	precise vec3 right = y * a;
	precise vec3 result = left + right;
	return result;
}

vec4 mixPrecise(vec4 x, vec4 y, float a) {
	precise float oneMinus = 1.0 - a;
	precise vec4 left = x * oneMinus;
	precise vec4 right = y * a;
	precise vec4 result = left + right;
	return result;
}

// Multiply two already-clamped weights. Declared AFTER the mixPrecise family on
// purpose: the reflection contract pins each `precise` result by its generated
// SPIR-V name (%result, %result_0, …), which is assigned in declaration order,
// so inserting a function above them renumbers the lot and breaks the gate.
//
// It takes plain parameters instead of clamping inline for the same reason
// mixPrecise does its arithmetic one step at a time: `precise` does not
// propagate through a builtin such as clamp. Writing `clamp(a,0,1) * b` here
// yields a bare OpFMul with no NoContraction — verified in the disassembly, not
// assumed — leaving this one step silently weaker than the rest of the shader.
float scalePrecise(float weight, float confidence) {
	precise float scaled = weight * confidence;
	return scaled;
}

// Plain (contractable) lerp for the bilinear taps of the history depth. The reprojected POSITION stays precise (jitter, motion,
// fraction f); the weights applied to already-fetched texels need no bit-exactness, and every `precise` operation costs a non-inlined
// optnone call after SPIRV-Cross. The final history blend keeps mixPrecise.
float mixFast(float x, float y, float a) { return x * (1.0 - a) + y * a; }

vec4 sampleCurrent(ivec2 pixel) {
	ivec2 bounded = clamp(pixel, ivec2(0), ivec2(pc.extent) - ivec2(1));
	return texelFetch(sampler2D(currentColor, nearestSampler), bounded, 0);
}

// Bicubic (Keys a = -0.75) resampling of the history. Bilinear history taps are a low-pass applied again every frame: they left TAA
// with about half of the AA-off edge energy. Injecting the current frame's high frequency instead put the JITTERED frame's detail back
// every frame, which made a static scene shimmer (measured: 2.5 % of the pixels moved by more than 8/255 between frames). A sharp
// history kernel keeps the detail without touching the current frame; its overshoot is removed by the neighbourhood clamp.
// The 4x4 kernel is evaluated with bilinear fetches: the two middle taps of each axis (both weights positive) collapse into one
// fetch at w2 / (w1 + w2). `nearestSampler` is therefore a LINEAR clamp-to-edge sampler; every other read in this shader is a
// texelFetch, which ignores filtering. Reciprocals use inversesqrt (the reflection contract admits one non-precise division).
vec4 samplePreviousColor(vec2 texel, inout vec3 tapMin, inout vec3 tapMax, inout float centreCount) {
	vec2 baseFloat = floor(texel);
	precise vec2 f = texel - baseFloat;
	const float A = -0.75;
	vec2 d0 = 1.0 + f, d1 = f, d2 = 1.0 - f, d3 = 2.0 - f;
	vec2 w0 = ((A * d0 - 5.0 * A) * d0 + 8.0 * A) * d0 - 4.0 * A;
	vec2 w1 = ((A + 2.0) * d1 - (A + 3.0)) * d1 * d1 + 1.0;
	vec2 w2 = ((A + 2.0) * d2 - (A + 3.0)) * d2 * d2 + 1.0;
	vec2 w3 = ((A * d3 - 5.0 * A) * d3 + 8.0 * A) * d3 - 4.0 * A;
	vec2 w12 = w1 + w2;
	vec2 offset12 = w2 * inversesqrt(w12 * w12);
	vec2 extent = vec2(pc.extent);
	vec2 invExtent = inversesqrt(extent * extent);
	// UV of texel centres: (texel + 0.5) / extent.
	vec2 uv0 = (baseFloat - 1.0 + 0.5) * invExtent;
	vec2 uv12 = (baseFloat + offset12 + 0.5) * invExtent;
	vec2 uv3 = (baseFloat + 2.0 + 0.5) * invExtent;
	// Five of the nine fetches: the four corner products (w0 or w3 on both axes) are below 1 % of the kernel, so they are dropped
	// and the remaining weights renormalized (the usual 5-tap bicubic history fetch).
	float ux[5] = float[5](uv12.x, uv0.x, uv3.x, uv12.x, uv12.x);
	float uy[5] = float[5](uv12.y, uv12.y, uv12.y, uv0.y, uv3.y);
	float w[5] = float[5](w12.x * w12.y, w0.x * w12.y, w3.x * w12.y, w12.x * w0.y, w12.x * w3.y);
	vec4 sum = vec4(0.0);
	float total = 0.0;
	for (int i = 0; i < 5; ++i) {
		vec4 tap = textureLod(sampler2D(previousColor, nearestSampler), vec2(ux[i], uy[i]), 0.0);
		sum += w[i] * tap;
		total += w[i];
		tapMin = min(tapMin, tap.rgb);
		tapMax = max(tapMax, tap.rgb);
		if (i == 0) centreCount = tap.a;   // the centre tap: on a static pixel exactly its own texel
	}
	return sum * inversesqrt(total * total);
}

// History weight from the pixel's accumulated sample count, kept in the history alpha (a frame without usable history stores 1).
// The resolved colour is the running mean of the last n jittered samples: weight n / (n + 1), up to historyCountCap, so a pixel
// that stays put converges towards the average of the jitter phases instead of rippling with the 8-frame jitter cycle (static
// items and edges). A moving pixel falls back to the backend weight (pc.historyWeight = m / (m + 1)): its count is limited to m,
// so its lag is unchanged and, once it stops, the weight ramps up from there one sample per frame rather than jumping (a jump
// kept the moving frames' history visible for longer after the camera stopped). The count is read from the centre bicubic tap
// (the pixel's own texel when it does not move). History the clamp had to move far, relative to the size of the neighbourhood
// box, is content the pixel no longer shows: its count drops accordingly, so a mismatch fades at the moving rate or faster
// instead of the static one. The small clamps the jitter causes on static edges leave the count alone.
// The cap sets the static residue: an exponential mean keeps about 1 / (cap + 1) of the jitter-phase variation. 48 (weight 0.98)
// against 24, Vulkan arena17/arena6 2026-11-25: static item shimmer 0.70 -> 0.53, edges 0.76 -> 0.67, consecutive-frame pixels
// above 8/255 0.57 % -> 0.01 %, while first-settled (0.264 -> 0.234), old-frame residual (0.72 -> 0.62 %) and the effect and
// mover trails are unchanged or better: a real content change exceeds the 3x3 box, is clamped and rectified, so the higher cap
// does not lengthen the response to it.
const float historyCountCap = 48.0;   // weight 0.98
const float staticMotionScale = 8.0;  // fully moving from 1/8 pixel of motion per frame
// A moving pixel's history is resampled every frame, which averages its texture detail away from the current frame; the faster
// it moves, the less of that history it keeps, and the less output sharpening (built from the same resampled history) it gets:
// both scale by 1 / (1 + movingSpeedFalloff * pixels per frame). Measured on a firing view weapon and a rocket in flight (arena1,
// Vulkan, 2026-11-26), against the same frames with AA off: pixels further than 24/255 -19 % (weapon -23 %); a still pixel is
// unchanged.
const float movingSpeedFalloff = 0.25;
float movingSpeedScale(float pixelsPerFrame) {
	float s = 1.0 + movingSpeedFalloff * pixelsPerFrame;
	return inversesqrt(s * s);
}
float movingHistoryCount(float movingWeight) {
	// m = w / (1 - w); 1 / x as inversesqrt(x * x) (the reflection contract admits one division, in linearizeDepth)
	float rest = max(1.0 - movingWeight, 1.0 / historyCountCap);
	return movingWeight * inversesqrt(rest * rest);
}
float accumulatedHistoryCount(float storedCount, float movingWeight, vec2 motionPixels) {
	float count = clamp(storedCount, 1.0, historyCountCap);
	float speed = length(motionPixels);
	float moving = clamp(speed * staticMotionScale, 0.0, 1.0);
	float movingCount = max(1.0, movingHistoryCount(movingWeight) * movingSpeedScale(speed));
	return count + (min(count, movingCount) - count) * moving;
}
float rectifiedHistoryCount(float count, vec3 clampMove, vec3 boxExtent) {
	// rectified: clamp distance over box size, 1 / x as inversesqrt(x * x)
	float boxSize = max(length(boxExtent), 1.0e-4);
	float rectified = clamp(length(clampMove) * inversesqrt(boxSize * boxSize) - 0.5, 0.0, 1.0);
	return max(1.0, count - (count - 1.0) * rectified);
}
float historyWeightForCount(float count) {
	return count * inversesqrt((count + 1.0) * (count + 1.0));
}

// Output-only sharpening. TAA averages the jittered sub-pixel samples, which softens texture detail SMAA leaves untouched. The
// detail is taken from the history (previous output, stable on the fixed grid): its bicubic sample minus a [1 2 1] blur built from
// four bilinear taps half a texel off on the diagonals. It is added to the displayed colour only; the history keeps the unsharpened
// result, so nothing feeds back and nothing follows the jitter (re-injecting the current frame's detail did, as shimmer).
//
// The range the sharpened colour is kept in (no halos) is the range of the history taps both fetches already read (the five bicubic
// taps and the four blur taps), so it costs no fetch. It comes from the history, like the detail: the current frame's 3x3 box (the
// old bound) moves with the jitter phase and made the displayed image ripple with the 8-frame jitter cycle on items and edges. That
// range is narrower than the jittered box, and the accumulated history (historyCountCap) is smoother still, so the gain is 2.4
// (Vulkan aacompare edge energy vs AA off 0.990 at 2.4, 0.973 at 2.0; SMAA 0.996).
const float outputSharpen = 2.6;
vec3 samplePreviousBlur(vec2 texel, inout vec3 tapMin, inout vec3 tapMax) {
	vec2 extent = vec2(pc.extent);
	vec2 invExtent = inversesqrt(extent * extent);
	vec3 sum = vec3(0.0);
	for (int i = 0; i < 4; ++i) {
		vec2 o = vec2((i & 1) != 0 ? 0.5 : -0.5, (i & 2) != 0 ? 0.5 : -0.5);
		vec3 tap = textureLod(sampler2D(previousColor, nearestSampler), (texel + 0.5 + o) * invExtent, 0.0).rgb;
		sum += tap;
		tapMin = min(tapMin, tap);
		tapMax = max(tapMax, tap);
	}
	return sum * 0.25;
}

float samplePreviousDepthLinear(vec2 texel) {
	vec2 baseFloat = floor(texel);
	ivec2 base = ivec2(baseFloat);
	precise vec2 f = texel - baseFloat;
	ivec2 hi = ivec2(pc.extent) - ivec2(1);
	float d00 = texelFetch(sampler2D(previousLinearDepth, nearestSampler),
		clamp(base, ivec2(0), hi), 0).r;
	float d10 = texelFetch(sampler2D(previousLinearDepth, nearestSampler),
		clamp(base + ivec2(1, 0), ivec2(0), hi), 0).r;
	float d01 = texelFetch(sampler2D(previousLinearDepth, nearestSampler),
		clamp(base + ivec2(0, 1), ivec2(0), hi), 0).r;
	float d11 = texelFetch(sampler2D(previousLinearDepth, nearestSampler),
		clamp(base + ivec2(1, 1), ivec2(0), hi), 0).r;
	float top = mixFast(d00, d10, f.x);
	float bottom = mixFast(d01, d11, f.x);
	return mixFast(top, bottom, f.y);
}

// Same arithmetic as temporal_history_store.comp (deliberately not precise): the folded history depth must be bit-identical to
// what the store pass wrote. Declared after the precise helpers so their generated result names keep their numbering.
float storeLinearDepth(float z) {
	// 1/x as inversesqrt(x*x): the denominator is positive for any depth in [0, 1]. A true division is a long instruction sequence on
	// Apple GPUs; every shader that writes or reads the history depth uses this exact expression so the values stay bit-identical
	// across the store, bootstrap and folded paths.
	float denominator = pc.zNear + z * (pc.zFar - pc.zNear);
	return pc.zNear * pc.zFar * inversesqrt(denominator * denominator);
}

// ---- Spatial fallback ---------------------------------------------------------------------------------------------------
// A pixel without usable history (no motion validity, reprojection off screen or refused by the depth test, a secondary view
// such as a portal or mirror that is neither jittered nor reprojected, a disocclusion) used to keep its raw, aliased colour.
// It now gets an edge-directed filter: detect the local contrast, find which way the edge runs,
// walk along it to both ends and blend the pixel toward the neighbour across the edge by how far along the stair step it
// sits. It only runs for those pixels, adds no pass and no binding, and uses no division (the reflection contract admits
// exactly one non-precise division, the history depth), so reciprocals are written with inversesqrt.
//
// Luma is compressed (l / sqrt(1 + l^2)) so HDR highlights do not dominate the edge test; the blend itself stays linear.
float edgeLuma(vec3 c) {
	float l = dot(c, vec3(0.2126, 0.7152, 0.0722));
	if (!finite1(l)) return 0.0;
	l = clamp(l, 0.0, 1.0e4);
	return l * inversesqrt(1.0 + l * l);
}

float edgeLumaAt(ivec2 p) {
	return edgeLuma(sampleCurrent(p).rgb);
}

// Luma half-way between a pixel and its neighbour across the edge: the position the edge search walks along.
float edgeMidLuma(ivec2 base, ivec2 across) {
	return 0.5 * (edgeLumaAt(base) + edgeLumaAt(base + across));
}

vec4 spatialEdgeFilter(ivec2 px, vec4 centerColor) {
	float edgeM = edgeLuma(centerColor.rgb);
	float edgeN = edgeLumaAt(px + ivec2(0, -1));
	float edgeS = edgeLumaAt(px + ivec2(0, 1));
	float edgeW = edgeLumaAt(px + ivec2(-1, 0));
	float edgeE = edgeLumaAt(px + ivec2(1, 0));
	float edgeHi = max(max(edgeN, edgeS), max(max(edgeW, edgeE), edgeM));
	float edgeLo = min(min(edgeN, edgeS), min(min(edgeW, edgeE), edgeM));
	float edgeSpan = edgeHi - edgeLo;
	if (edgeSpan < max(0.0312, edgeHi * 0.125)) return centerColor;

	float edgeNW = edgeLumaAt(px + ivec2(-1, -1));
	float edgeNE = edgeLumaAt(px + ivec2(1, -1));
	float edgeSW = edgeLumaAt(px + ivec2(-1, 1));
	float edgeSE = edgeLumaAt(px + ivec2(1, 1));
	float edgeNS = edgeN + edgeS;
	float edgeWE = edgeW + edgeE;
	float edgeNWSW = edgeNW + edgeSW;
	float edgeNESE = edgeNE + edgeSE;
	float edgeHorz = abs(-2.0 * edgeW + edgeNWSW)
		+ (abs(-2.0 * edgeM + edgeNS) * 2.0 + abs(-2.0 * edgeE + edgeNESE));
	float edgeVert = abs(-2.0 * edgeS + (edgeSW + edgeSE))
		+ (abs(-2.0 * edgeM + edgeWE) * 2.0 + abs(-2.0 * edgeN + (edgeNW + edgeNE)));
	bool edgeHorzSpan = edgeHorz >= edgeVert;
	float edgeAround = (edgeNS + edgeWE) * 2.0 + (edgeNWSW + edgeNESE);
	// Rename the two neighbours across the edge: north/south for a horizontal span, west/east for a vertical one.
	float edgeLoSide = edgeHorzSpan ? edgeN : edgeW;
	float edgeHiSide = edgeHorzSpan ? edgeS : edgeE;
	float edgeGradLo = edgeLoSide - edgeM;
	float edgeGradHi = edgeHiSide - edgeM;
	bool edgeLoSteeper = abs(edgeGradLo) >= abs(edgeGradHi);
	float edgeGradient = max(abs(edgeGradLo), abs(edgeGradHi));
	float edgePair = edgeLoSteeper ? edgeLoSide + edgeM : edgeHiSide + edgeM;
	ivec2 edgeAcross = edgeHorzSpan ? ivec2(0, 1) : ivec2(1, 0);
	ivec2 edgeAlong = edgeHorzSpan ? ivec2(1, 0) : ivec2(0, 1);
	if (edgeLoSteeper) edgeAcross = -edgeAcross;

	float edgeInvSpan = inversesqrt(edgeSpan * edgeSpan);
	float edgeBlendC = clamp(abs(edgeAround * (1.0 / 12.0) - edgeM) * edgeInvSpan, 0.0, 1.0);
	float edgeBlendF = (-2.0 * edgeBlendC + 3.0) * (edgeBlendC * edgeBlendC);
	float edgeSubpixel = edgeBlendF * edgeBlendF * 0.75;

	float edgeHalfPair = edgePair * 0.5;
	float edgeScaled = edgeGradient * 0.25;
	bool edgeMidNegative = edgeM - edgeHalfPair < 0.0;
	float edgeEndN = edgeMidLuma(px - edgeAlong, edgeAcross) - edgeHalfPair;
	float edgeEndP = edgeMidLuma(px + edgeAlong, edgeAcross) - edgeHalfPair;
	bool edgeDoneN = abs(edgeEndN) >= edgeScaled;
	bool edgeDoneP = abs(edgeEndP) >= edgeScaled;
	int edgeStepsN = 1;
	int edgeStepsP = 1;
	for (int i = 2; i <= 12; ++i) {
		if (!edgeDoneN) {
			edgeEndN = edgeMidLuma(px - edgeAlong * i, edgeAcross) - edgeHalfPair;
			edgeDoneN = abs(edgeEndN) >= edgeScaled;
			edgeStepsN = i;
		}
		if (!edgeDoneP) {
			edgeEndP = edgeMidLuma(px + edgeAlong * i, edgeAcross) - edgeHalfPair;
			edgeDoneP = abs(edgeEndP) >= edgeScaled;
			edgeStepsP = i;
		}
		if (edgeDoneN && edgeDoneP) break;
	}
	bool edgeTowardN = edgeStepsN < edgeStepsP;
	float edgeEndG = edgeTowardN ? edgeEndN : edgeEndP;
	bool edgeGoodSpan = (edgeEndG < 0.0) != edgeMidNegative;
	float edgeSpanLen = float(edgeStepsN + edgeStepsP);
	float edgeNear = float(edgeTowardN ? edgeStepsN : edgeStepsP);
	float edgeStepBlend = edgeGoodSpan ? (0.5 - edgeNear * inversesqrt(edgeSpanLen * edgeSpanLen)) : 0.0;
	float edgeBlend = clamp(max(edgeStepBlend, edgeSubpixel), 0.0, 1.0);
	vec3 edgeAcrossColor = sampleCurrent(px + edgeAcross).rgb;
	// Written out instead of mix(): the reflection contract forbids the opaque FMix instruction anywhere in this shader.
	return vec4(centerColor.rgb * (1.0 - edgeBlend) + edgeAcrossColor * edgeBlend, centerColor.a);
}

// ---- end spatial fallback ----

// Velocity dilation: at a foreground edge the centre pixel often belongs to the background while the edge belongs to the object in
// front, so reprojecting it with the background velocity drags a ghost behind the object. Taking the velocity of the closest pixel
// of the 3x3 neighbourhood moves the whole edge with the object. The depth range is reversed (a larger device depth is closer).
vec2 dlMotionVelocity(ivec2 px, int tileIndex, float centerValid) {
	vec2 centerVelocity = texelFetch(
		sampler2D(motionVelocity, nearestSampler), px, 0).xy;
	if ((pc.qualityFlags & 2u) == 0u || !(centerValid > 0.0) || !finite2(centerVelocity))
		return centerVelocity;
	ivec2 hi = ivec2(pc.extent) - ivec2(1);
	ivec2 best = px;
	float bestDepth = tileDepth[tileIndex];
	for (int y = -1; y <= 1; ++y) {
		for (int x = -1; x <= 1; ++x) {
			float d = tileDepth[tileIndex + y * tileSide + x];
			if (d > bestDepth) { bestDepth = d; best = clamp(px + ivec2(x, y), ivec2(0), hi); }
		}
	}
	if (best == px) return centerVelocity;
	// The neighbour's velocity is only meaningful where its own motion is valid.
	float v = texelFetch(sampler2D(motionValidity, nearestSampler), best, 0).r;
	if (!(v > 0.0)) return centerVelocity;
	vec2 dv = texelFetch(sampler2D(motionVelocity, nearestSampler), best, 0).xy;
	return finite2(dv) ? dv : centerVelocity;
}

// The colour box the reprojected history is clamped into: min/max of the 3x3 current-colour neighbourhood, tightened by variance
// clipping when enabled. Deliberately a separate, non-precise function. `precise` propagates backwards through every operation
// that feeds a precise result, and each such operation is emitted by SPIRV-Cross as an optnone spvFAdd/spvFMul call that the
// Metal compiler does not inline: measured at ~0.9 ms of this pass at 1280x720. The box needs no bit-exact arithmetic (it only
// bounds a clamp), whereas the reprojection and the final blend keep their precise chains.
// One pass over the 3x3 tile the workgroup already holds yields both the current frame reconstructed at the pixel centre and the
// neighbourhood box the history is clamped into.
//
// Reconstruction: the current frame was rendered with its geometry displaced by the jitter (currentEffectiveJitterUv, in the texture
// space of the tile), so the tile texel at offset o shows the scene at o - jitter from this pixel's centre. Separable quadratic
// Lagrange weights interpolate the scene exactly at the pixel centre (weights 0,1,0 without jitter); the result is clamped into the
// 3x3 range so the interpolation cannot overshoot. The resolved image and its history therefore stay on the fixed pixel grid instead
// of moving with the jitter every frame (which showed as frame-to-frame shimmer on a static scene).
//
// Box: the 3x3 min/max, tightened by variance clipping (mean +/- 1.25 sigma) when qualityFlags bit 0 is set. The box is an
// intersection, so it can only get smaller; the mean lies inside both, hence it is never empty.
// The current frame was rendered with its geometry displaced by the jitter (currentEffectiveJitterUv, in the texture space of the
// tile), so the scene at this pixel's centre lies at pixel + jitter in the current image. One bilinear fetch there reconstructs it on
// the fixed pixel grid (exact without jitter, never outside the range of its four texels); the resolved image and its history
// therefore stay on that grid instead of moving with the jitter every frame (which showed as frame-to-frame shimmer on a static
// scene). A filtered fetch instead of weighting the 3x3 tile keeps the per-pixel cost of the old resolve (the unconditional 3x3 pass
// cost ~0.23 ms at 2560x1440).
vec4 reconstructCurrent(ivec2 pixel, int tileIndex) {
	vec2 extent = vec2(pc.extent);
	vec2 sampleAt = (vec2(pixel) + 0.5) * inversesqrt(extent * extent) + pc.currentEffectiveJitterUv;
	return vec4(textureLod(sampler2D(currentColor, nearestSampler), sampleAt, 0.0).rgb, tileColor[tileIndex].a);
}

bool neighborhoodBox(int tileIndex, out vec3 boxMin, out vec3 boxMax) {
	vec3 neighborhoodMin = vec3(3.402823466e+38);
	vec3 neighborhoodMax = vec3(-3.402823466e+38);
	vec3 momentSum = vec3(0.0);
	vec3 momentSquares = vec3(0.0);
	for (int y = -1; y <= 1; ++y) {
		for (int x = -1; x <= 1; ++x) {
			vec3 c = tileColor[tileIndex + y * tileSide + x].rgb;
			neighborhoodMin = min(neighborhoodMin, c);
			neighborhoodMax = max(neighborhoodMax, c);
			momentSum += c;
			momentSquares += c * c;
		}
	}
	if (!(finite3(neighborhoodMin) && finite3(neighborhoodMax))) return false;
	boxMin = neighborhoodMin;
	boxMax = neighborhoodMax;
	if ((pc.qualityFlags & 1u) != 0u) {
		vec3 momentMean = momentSum * (1.0 / 9.0);
		vec3 momentSigma = sqrt(max(momentSquares * (1.0 / 9.0) - momentMean * momentMean, vec3(0.0)));
		boxMin = max(neighborhoodMin, momentMean - 1.25 * momentSigma);
		boxMax = min(neighborhoodMax, momentMean + 1.25 * momentSigma);
	}
	return true;
}

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 tileOrigin = ivec2(gl_WorkGroupID.xy) * 8 - ivec2(1);
	ivec2 imageHi = ivec2(pc.extent) - ivec2(1);
	// Every invocation joins the cooperative load and the barrier, including those past the image edge.
	for (uint i = gl_LocalInvocationIndex; i < tileCount; i += 64u) {
		ivec2 q = clamp(tileOrigin + ivec2(int(i % 10u), int(i / 10u)), ivec2(0), imageHi);
		tileColor[i] = texelFetch(sampler2D(currentColor, nearestSampler), q, 0);
		tileDepth[i] = texelFetch(sampler2D(currentDeviceDepth, nearestSampler), q, 0).r;
	}
	barrier();
	if (any(greaterThanEqual(pixel, ivec2(pc.extent)))) return;
	int tileIndex = (int(gl_LocalInvocationID.y) + 1) * tileSide + int(gl_LocalInvocationID.x) + 1;
	vec3 clipMin = vec3(0.0);
	vec3 clipMax = vec3(0.0);
	vec4 current = reconstructCurrent(pixel, tileIndex);
	vec4 result = current;
	vec4 displayed = current;
	bool usedHistory = false;
	float historyCount = 1.0;   // the history alpha: samples accumulated in this pixel (1 = this frame only)
	float valid = texelFetch(
		sampler2D(motionValidity, nearestSampler), pixel, 0).r;
	vec2 velocity = dlMotionVelocity(pixel, tileIndex, valid);
	// History lives on the fixed pixel grid (see reconstructCurrent), so it is reprojected by the camera/object motion alone;
	// previousEffectiveJitterUv stays in the push block but is no longer read.
	precise vec2 motionTexel = velocity * vec2(pc.extent);
	precise vec2 previousTexel = vec2(pixel) - motionTexel;
	precise vec2 previousCenter = previousTexel + 0.5;
	bool inside = all(greaterThanEqual(previousCenter, vec2(0.0)))
		&& all(lessThan(previousCenter, vec2(pc.extent)));

	// `valid` is a continuous confidence, not a flag. Zero still means "no usable
	// history here" (INVALIDATE): the velocity carries no meaning, so reprojection
	// is skipped outright. Anything above zero reprojects, and the confidence then
	// scales how much of the reprojected history survives the blend below.
	//
	// It used to be read as `valid > 0.5`, which threw away every intermediate
	// value the R8 channel can carry. Surfaces that are only partly trustworthy —
	// alpha-tested cut-outs being the motivating case, where a pixel's coverage
	// flips between frames — could then only be all-in or all-out. Neither is
	// right: all-in ghosts, all-out loses the anti-aliasing.
	if (finite4(current) && finite1(valid) && valid > 0.0
			&& finite2(velocity) && finite2(previousTexel) && inside) {
		// Disocclusion test against the current 3x3 depth range, not the centre sample alone. The centre is a jittered sample: on a
		// silhouette it flips between the two surfaces with the jitter phase, so a centre-only test rejected the history of edge
		// pixels in some phases and showed the raw frame there (most of the static shimmer left on items). The history depth still
		// has to belong to a surface present around the pixel now; a surface that moved away (true disocclusion) is rejected.
		// linearizeDepth is monotonic, so the range needs only the nearest and farthest device depths of the tile.
		float currentDevice = tileDepth[tileIndex];
		float deviceLo = currentDevice;
		float deviceHi = currentDevice;
		for (int y = -1; y <= 1; ++y) {
			for (int x = -1; x <= 1; ++x) {
				float d = tileDepth[tileIndex + y * tileSide + x];
				deviceLo = min(deviceLo, d);
				deviceHi = max(deviceHi, d);
			}
		}
		float currentLinear = linearizeDepth(currentDevice);
		float rangeA = linearizeDepth(deviceLo);
		float rangeB = linearizeDepth(deviceHi);
		float priorLinear = samplePreviousDepthLinear(previousTexel);
		float depthLimit = max(pc.depthThresholdAbsolute,
			pc.depthThresholdRelative * max(currentLinear, priorLinear));
		if (finite1(currentLinear) && finite1(priorLinear) && finite1(rangeA) && finite1(rangeB)
				&& currentLinear > 0.0 && priorLinear > 0.0
				&& priorLinear >= min(rangeA, rangeB) - depthLimit
				&& priorLinear <= max(rangeA, rangeB) + depthLimit) {
			// The current-frame box first: the history tap range is then live only from the history fetches to the sharpening, not
			// across the 3x3 moment loop (fewer registers held in this latency-bound pass).
			bool boxValid = neighborhoodBox(tileIndex, clipMin, clipMax);
			vec3 tapMin = vec3(3.402823466e+38);
			vec3 tapMax = vec3(-3.402823466e+38);
			float centreCount = 3.402823466e+38;
			vec4 prior = samplePreviousColor(previousTexel, tapMin, tapMax, centreCount);
			if (boxValid && finite4(prior)) {
				vec3 clampedPrior = clamp(prior.rgb, clipMin, clipMax);
				// Scale the history weight by the pixel's confidence. At
				// valid == 1 this is exactly the previous behaviour
				// (weight * 1.0), so fully-trusted surfaces are unchanged
				// and the existing evidence still holds. Below 1 the pixel
				// keeps proportionally more of its current-frame colour,
				// which is what suppresses ghosting on partly-trusted
				// surfaces without disabling temporal accumulation for them.
				float confidence = clamp(valid, 0.0, 1.0);
				float priorCount = accumulatedHistoryCount(centreCount, clamp(pc.historyWeight, 0.0, 1.0), motionTexel);
				priorCount = rectifiedHistoryCount(priorCount, prior.rgb - clampedPrior, clipMax - clipMin);
				float baseWeight = historyWeightForCount(priorCount);
				float weight = scalePrecise(baseWeight, confidence);
				precise vec3 resolvedRgb = mixPrecise(current.rgb, clampedPrior,
					weight);
				result = vec4(resolvedRgb, current.a);
				displayed = result;
				historyCount = min(priorCount * confidence + 1.0, historyCountCap);
				// Sharpened copy for display only, kept inside the range of the result and the history neighbourhood (no halos).
				// qualityFlags bit 3 turns it off (a diagnostic; every backend passes 7).
				if ((pc.qualityFlags & 8u) == 0u) {
					vec3 detail = prior.rgb - samplePreviousBlur(previousTexel, tapMin, tapMax);
					displayed = vec4(clamp(resolvedRgb + outputSharpen * confidence * movingSpeedScale(length(motionTexel)) * detail,
						min(resolvedRgb, tapMin), max(resolvedRgb, tapMax)), current.a);
				}
				usedHistory = true;
			}
		}
	}
	if (!usedHistory && finite4(current) && (pc.qualityFlags & 4u) != 0u) result = spatialEdgeFilter(pixel, current);
	if (!finite4(result)) result = vec4(0.0);
	if (!usedHistory || !finite4(displayed)) displayed = result;
	imageStore(resolvedColor, pixel, displayed);
	imageStore(historyOutColor, pixel, vec4(result.rgb, historyCount));
	imageStore(historyOutLinearDepth, pixel, vec4(storeLinearDepth(tileDepth[tileIndex])));
}

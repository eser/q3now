# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# OS-specific files
.DS_Store
Thumbs.db

# Per-build monotonic counter (bumped by `make`; survives `make clean`)
.build_number
# Content signature of the last stamped build (gates the counter bump)
.build_signature
# Generated per-build stamp header (written by `make` _build-stamp)
code/qcommon/wired/wired_build_stamp_gen.h

# Editor metadata
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
.idea/*
.vs/*
*.user

# sensitive files
*.key
*.pem
*.swp

# build output
build/
# The Wails launcher keeps its project assets (icons, manifests, installer
# scripts) in launcher/build; only its compiled output is ignored.
!launcher/build/
launcher/build/bin/
dist/
cmake-*

# todos
backlog/
TODOS.md

# Python bytecode caches
__pycache__/
*.pyc
tools/visual_regression/__pycache__/
.scratch/
tools/png2raw/png2raw
# Locally built helper-tool binaries (Go) and the layout dump the engine writes
# into its working directory; all are reproducible, none belong in git.
tools/**/*.exe
tools/png-perturb/png-perturb
tests/visual/scripts/anchor_extract
tests/visual/scripts/*.exe
layoutdump.jsonl

# Visual-gate harness vendor tree (built by tests/visual/scripts/vendor_sync.mjs).
# Reproducible local artifact: React UMD + repo-local fonts + design JSX compiled
# to plain JS. The design JSX originates in the PRIVATE wiki repo, so it must not
# be committed to this PUBLIC repo — regenerate it instead.
tests/visual/vendor/

# Agent/tool state and visual-test output: machine-local artifacts that also
# carried absolute personal paths into a public repo (result.json baseline/impl/diff).
.eser/
tests/visual/results/

# Go build artifacts for the visual tooling (produced by `go build`).
tools/visual-compare/vcompare
tools/visual-diff/vdiff

# Agent worktrees (transient, never committed)
.claude/worktrees/
# Per-user agent settings (machine-local; also covered by some global ignores)
.claude/settings.local.json
# clangd index cache
.cache/

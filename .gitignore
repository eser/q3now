# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# OS-specific files
.DS_Store
Thumbs.db

# Per-build monotonic counter (bumped by `make`; survives `make clean`)
.build_number
# Generated per-build stamp header (written by `make` _build-stamp)
code/qcommon/wired/wired_build_stamp_gen.h

# Editor metadata
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
.idea/*
.vs/*
*.user

# sensitive files
*.key
*.pem
*.swp

# build output
build/
dist/
cmake-*

# engine runtime (created if run from project dir)
base/

# todos
docs/
TODOS.md

# Python bytecode caches
__pycache__/
*.pyc
tools/visual_regression/__pycache__/
.scratch/

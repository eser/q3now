# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# OS-specific files
.DS_Store
Thumbs.db

# Per-build monotonic counter (bumped by `make`; survives `make clean`)
.build_number
# Content signature of the last stamped build (gates the counter bump)
.build_signature
# Generated per-build stamp header (written by `make` _build-stamp)
code/qcommon/wired/wired_build_stamp_gen.h

# Editor metadata
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
.idea/*
.vs/*
*.user

# sensitive files
*.key
*.pem
*.swp

# build output
build/
dist/
cmake-*

# todos
backlog/
TODOS.md

# Python bytecode caches
__pycache__/
*.pyc
tools/visual_regression/__pycache__/
.scratch/
tools/png2raw/png2raw

# Visual-gate harness vendor tree (built by tests/visual/scripts/vendor_sync.mjs).
# Reproducible local artifact: React UMD + repo-local fonts + design JSX compiled
# to plain JS. The design JSX originates in the PRIVATE wiki repo, so it must not
# be committed to this PUBLIC repo — regenerate it instead.
tests/visual/vendor/

# Agent/tool state and visual-test output: machine-local artifacts that also
# carried absolute personal paths into a public repo (result.json baseline/impl/diff).
.eser/
tests/visual/results/

# Go build artifacts for the visual tooling (produced by `go build`).
tools/visual-compare/vcompare
tools/visual-diff/vdiff

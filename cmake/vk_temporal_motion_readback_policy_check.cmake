require_text("${READBACK}" "payload->descriptorRange < (uint64_t)activation->iqm.entityCount\n\t\t\t\t* TEMPORAL_IQM_RECORD_SIZE" "IQM descriptor range gate")
require_text("${READBACK_H}" "iqmCurrentPaletteHash" "current palette hash receipt")
require_text("${READBACK_H}" "iqmPreviousPaletteHash" "previous palette hash receipt")

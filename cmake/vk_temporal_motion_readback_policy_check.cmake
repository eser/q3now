if(NOT DEFINED ROOT)
	message(FATAL_ERROR "ROOT is required")
endif()

file(READ "${ROOT}/code/renderervk/vk.c" VKC)
file(READ "${ROOT}/code/renderervk/vk_ral_textures.c" RALTEX)
file(READ "${ROOT}/code/renderervk/vk_temporal_motion_readback.c" READBACK)
file(READ "${ROOT}/code/renderervk/vk_temporal_motion_readback.h" READBACK_H)

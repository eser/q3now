file(READ "${ROOT}/tests/ral-temporal-projection-check.sh" HARNESS)
file(READ "${ROOT}/CMakeLists.txt" BUILD)

function(require_text haystack needle why)
	string(FIND "${haystack}" "${needle}" pos)
	if(pos EQUAL -1)
		message(FATAL_ERROR "A2c4c policy missing ${why}: ${needle}")
	endif()
endfunction()
function(forbid_text haystack needle why)
	string(FIND "${haystack}" "${needle}" pos)
	if(NOT pos EQUAL -1)
		message(FATAL_ERROR "A2c4c policy forbidden ${why}: ${needle}")
	endif()
endfunction()

require_text("${RALTEX}" "temporal-motion-arm" "explicit diagnostic arm command")
require_text("${RALTEX}" "vk_temporal_motion_readback_arm();" "sole arm authority")
require_text("${ACTIVATION}" "VK_TemporalMainActivationPeekPendingReceipt" "authored pre-submit candidate accessor")
require_text("${READBACK}" "RAL_MEMORY_HOST_COHERENT" "coherent fence-delayed mirror")
require_text("${READBACK}" "VK_TEMPORAL_READBACK_MAX_ROI" "bounded ROI")
require_text("${READBACK}" "memset( slot->mapped, 0x7f, (size_t)totalBytes );" "noncanonical R8/NaN-half stale-copy poison")
require_text("${READBACK}" "owner->slots[i].buffer == candidate" "cross-slot buffer alias rejection")
require_text("${READBACK}" "TicketMatchesSlot( slot, frameIndex, &slot->ticket )" "ticket/slot geometry identity")
require_text("${READBACK}" "!fenceProven" "explicit completed-fence proof")
require_text("${READBACK}" "slot->state != VK_TEMPORAL_READBACK_SUBMITTED" "fence-only content read")
require_text("${READBACK}" "VK_TemporalMainActivationReceiptExact(\n\t\t\t\t&slot->ticket.activation, resolvedActivation )" "full candidate/final submit identity")
require_text("${READBACK}" "validity[i] == 255" "canonical validity decoding")
require_text("${READBACK}" "receipt.nonzeroInvalidVelocity == 0" "invalid velocity zero gate")
require_text("${READBACK}" "SnapshotIqmPayload( pendingActivation, &ticket )" "record-bound IQM payload snapshot")
require_text("${READBACK}" "SnapshotIqmPayload( &ticket->activation, &snapshot )" "fence-bound IQM payload resnapshot")
require_text("${READBACK}" "payload->recordBytes != TEMPORAL_IQM_RECORD_SIZE" "exact IQM record size")

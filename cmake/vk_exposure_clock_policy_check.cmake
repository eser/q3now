if(NOT DEFINED ROOT)
  message(FATAL_ERROR "ROOT is required")
endif()
set(RENDERER "${ROOT}/code/render/ral/backends/vulkan/renderer")
file(READ "${RENDERER}/tr_scene.c" SCENE)
file(READ "${RENDERER}/tr_cmds.c" COMMANDS)
file(READ "${RENDERER}/tr_backend.c" BACKEND)
file(READ "${RENDERER}/vk.c" VULKAN)
function(require_text TEXT NEEDLE)
  string(FIND "${TEXT}" "${NEEDLE}" POS)
  if(POS EQUAL -1)
    message(FATAL_ERROR "Exposure clock contract missing: ${NEEDLE}")
  endif()
endfunction()
require_text("${SCENE}" "tr.refdef.sceneTime = fd->time;")
require_text("${SCENE}" "tr.refdef.time = (int)( r_pinShaderTime->value * 1000.0f );")
require_text("${COMMANDS}" "cmd->refdef = tr.refdef;")
require_text("${BACKEND}" "backEnd.refdef = cmd->refdef;")
require_text("${VULKAN}" "vk_exposure_history.timeMs, backEnd.refdef.sceneTime,")
require_text("${VULKAN}" "vk_exposure_history.pendingTimeMs = backEnd.refdef.sceneTime;")
foreach(FORBIDDEN IN ITEMS
    "vk_exposure_history.timeMs, backEnd.refdef.time,"
    "vk_exposure_history.pendingTimeMs = backEnd.refdef.time;")
  string(FIND "${VULKAN}" "${FORBIDDEN}" POS)
  if(NOT POS EQUAL -1)
    message(FATAL_ERROR "Exposure history uses pinned shader clock: ${FORBIDDEN}")
  endif()
endforeach()
message(STATUS "Vulkan exposure scene/shader clock separation: PASS")

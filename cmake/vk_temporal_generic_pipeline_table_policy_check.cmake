string(FIND "${VKC}" "void vk_begin_frame(" frame_start)
string(FIND "${VKC}" "void vk_end_frame(" frame_end)
if(frame_start LESS 0 OR frame_end LESS frame_start)
	message(FATAL_ERROR "A2c2b policy cannot isolate begin-frame")
endif()
math(EXPR frame_len "${frame_end}-${frame_start}")
string(SUBSTRING "${VKC}" ${frame_start} ${frame_len} FRAME)
string(FIND "${FRAME}" "VK_TemporalMotionMaterializationEnsureAfterFence(" a2b)
string(FIND "${FRAME}" "VK_TemporalGenericRecipeTablePrepare(" recipe_prepare)
string(FIND "${FRAME}" "VK_TemporalGenericPipelineTablePrepare(" table_prepare)
string(FIND "${FRAME}" "vk_temporal_reconcile_generic_main_pipelines(" reconcile)
string(FIND "${FRAME}" "Ral_AcquireNextImage" acquire)
if(a2b LESS 0 OR recipe_prepare LESS a2b OR table_prepare LESS recipe_prepare
		OR reconcile LESS table_prepare OR acquire LESS reconcile)
	message(FATAL_ERROR "A2c2b policy post-fence A2b < recipe < exact3 < reconcile < acquire drift")
endif()

string(FIND "${VKC}" "VK_TemporalGenericPipelineTableReleaseRangeAfterIdle(" range_release)
string(FIND "${VKC}" "VK_TemporalGenericRecipeTableEvictRange(" recipe_evict)
if(range_release LESS 0 OR recipe_evict LESS range_release)
	message(FATAL_ERROR "A2c2b policy exact3 children must retire before recipe eviction")
endif()

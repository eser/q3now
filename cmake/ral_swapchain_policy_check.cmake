require_text("${TEST}" "RAL_SWAPCHAIN_MAX_REQUESTED_IMAGES + 1u" "invalid-count mutation")
require_text("${TEST}" "modePreferences[1].unboundedImageCount = RAL_SWAPCHAIN_MAX_REQUESTED_IMAGES + 1u;" "invalid unlimited-count mutation")

require_text("${RENDERER}" "sci.presentPreferences      = presentationPolicy.preferences;" "renderer RAL delegation")
require_text("${RENDERER}" "image_count               = actual.requestedImageCount;" "renderer selected receipt")
require_text("${RENDERER}" "Ral_FinalizePresentationPolicy" "generation-bound pacing receipt")
require_text("${RENDERER}" "result = Ral_SelectSurfaceFormat( backend, &query, &selected );" "renderer RAL format delegation")
require_text("${RENDERER}" "RAL_FORMAT_A2B10G10R10_UNORM, RAL_COLORSPACE_HDR10_ST2084" "portable HDR10 preference")
require_text("${RENDERER}" "query.useExtendedQuery = qtrue;" "colorspace-aware query request")

require_text("${TEST}" "!memcmp( &formatSelection, &untouchedSelection" "format output atomicity")
require_text("${METAL_TEST}" "selected.selectedPreference == 1u" "Metal ordered-selection test")

foreach(retired IN ITEMS
	qvkGetPhysicalDeviceSurfaceCapabilitiesKHR
	qvkGetPhysicalDeviceSurfacePresentModesKHR
	qvkGetPhysicalDeviceSurfaceFormatsKHR
	qvkGetPhysicalDeviceSurfaceFormats2KHR
	presentModePreferences
	presentModePreferenceCount)
	string(REGEX MATCH "(^|[^A-Za-z0-9_])${retired}([^A-Za-z0-9_]|$)" hit "${RENDERER}")
	if(hit)
		message(FATAL_ERROR "RAL swapchain policy accepted retired renderer ownership: ${retired}")
	endif()
endforeach()

message(STATUS "RAL swapchain policy: portable format/colorspace and per-mode count ownership PASS")

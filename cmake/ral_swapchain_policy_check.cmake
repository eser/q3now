if(NOT DEFINED ROOT OR NOT IS_DIRECTORY "${ROOT}")
	message(FATAL_ERROR "ROOT must name the q3now source tree")
endif()

function(require_text body needle label)
	string(FIND "${body}" "${needle}" found)
	if(found EQUAL -1)
		message(FATAL_ERROR "RAL swapchain policy lost ${label}: ${needle}")
	endif()
endfunction()

file(READ "${ROOT}/code/render/ral/core/ral_swapchain.h" PUBLIC)
file(READ "${ROOT}/code/render/ral/core/ral_presentation_policy.c" POLICY)
file(READ "${ROOT}/code/render/ral/backends/vulkan/ral_vulkan_swapchain.c" VULKAN)
file(READ "${ROOT}/code/render/ral/backends/vulkan/ral_vulkan_bridge.c" BRIDGE)
file(READ "${ROOT}/code/render/ral/backends/metal/ral_metal_present.mm" METAL)
file(READ "${ROOT}/code/render/ral/backends/vulkan/renderer/vk.c" RENDERER)
file(READ "${ROOT}/code/sdl/sdl_metal_ral.mm" SDL_METAL)
file(READ "${ROOT}/code/render/ral/backends/metal/ral_metal_module.mm" METAL_MODULE)
file(READ "${ROOT}/code/tools/profile_imgui/wired_profile_host_main.cpp" PROFILE)
file(READ "${ROOT}/tests/ral_swapchain_policy_test.c" TEST)
file(READ "${ROOT}/tests/ral_metal_present_test.mm" METAL_TEST)
if(DEFINED PROBE_TEXT)
	string(APPEND RENDERER "\n${PROBE_TEXT}\n")
endif()


file(GLOB PRODUCT_C "${ROOT}/code/renderervk/*.c")
foreach(path IN LISTS PRODUCT_C)
	get_filename_component(name "${path}" NAME)
	file(READ "${path}" SRC)
	if(name STREQUAL "vk_temporal_motion_materialization.c")
		require_count(SRC "VK_TemporalMotionMaterializationEnsureAfterFence" 1 "aggregate Ensure definition")
	elseif(name STREQUAL "vk.c")
		require_count(SRC "VK_TemporalMotionMaterializationEnsureAfterFence" 1 "sole aggregate product call")
	else()
		forbid_text(SRC "VK_TemporalMotionMaterializationEnsureAfterFence" "aggregate authority in ${name}")
	endif()
endforeach()


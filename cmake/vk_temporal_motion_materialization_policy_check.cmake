string(FIND "${VKC}" "void vk_begin_frame(" frame_start)
string(SUBSTRING "${VKC}" ${frame_start} 30000 FRAME)
string(FIND "${FRAME}" "VK_TemporalEntMatRuntimeEnsureAfterFence(" a2a_ensure)
string(FIND "${VKC}" "R_TemporalMotionTargetsEnsure" forbidden_direct_target)
string(FIND "${FRAME}" "VK_TemporalMotionMaterializationEnsureAfterFence(" a2b_ensure)
string(FIND "${FRAME}" "Ral_AcquireNextImage" acquire)
if(a2a_ensure LESS 0 OR a2b_ensure LESS a2a_ensure OR acquire LESS a2b_ensure
		OR NOT forbidden_direct_target EQUAL -1)
	message(FATAL_ERROR "A2b policy: A2a < aggregate < acquire order or target authority drift")
endif()

string(FIND "${VKC}" "static void vk_temporal_entmat_release_after_idle(" release_start)
string(FIND "${VKC}" "void vk_temporal_motion_release_before_ral_shutdown(" release_end)
if(release_start LESS 0 OR release_end LESS release_start)
	message(FATAL_ERROR "A2b policy: cannot isolate centralized release")
endif()
math(EXPR release_len "${release_end}-${release_start}")
string(SUBSTRING "${VKC}" ${release_start} ${release_len} RELEASE)
string(FIND "${RELEASE}" "VK_TemporalMotionMaterializationReleaseAfterIdle(" release_layout)
string(FIND "${RELEASE}" "VK_TemporalEntMatRuntimeReleaseAfterIdle(" release_entmat)
string(FIND "${RELEASE}" "Ral_WaitIdleAndDrainDeferred" release_drain)
if(release_layout LESS 0 OR release_entmat LESS release_layout OR release_drain LESS release_entmat)
	message(FATAL_ERROR "A2b policy: layout/targets < A2a/payload < deferred drain order drift")
endif()
string(FIND "${INIT}" "vk_temporal_motion_release_before_ral_shutdown();" pre_ral_release)
string(FIND "${INIT}" "vk_ral_textures_shutdown( code != REF_LEVEL_ONLY );" ral_shutdown)
if(pre_ral_release LESS 0 OR ral_shutdown LESS pre_ral_release)

function(require_text var needle why)
	string(FIND "${${var}}" "${needle}" pos)
	if(pos EQUAL -1)
		message(FATAL_ERROR "A2b policy missing ${why}: ${needle}")
	endif()
endfunction()
function(forbid_text var needle why)
	string(FIND "${${var}}" "${needle}" pos)
	if(NOT pos EQUAL -1)
		message(FATAL_ERROR "A2b policy forbidden ${why}: ${needle}")
	endif()
endfunction()
function(require_count var regex expected why)
	string(REGEX MATCHALL "${regex}" hits "${${var}}")
	list(LENGTH hits count)
	if(NOT count EQUAL expected)
		message(FATAL_ERROR "A2b policy ${why}: expected ${expected}, got ${count}")
	endif()
endfunction()


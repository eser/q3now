		rawEntMatCapacity
		rawEntMatAllocationGeneration payloadAllocationGeneration
		payloadLayoutGeneration targetAllocationGeneration
		pipelineLayoutAllocationGeneration materializationGeneration
		pipelineTableGeneration frameIndex)
	require_text(RECORD_H "${field}" "authority field ${field}")
endforeach()

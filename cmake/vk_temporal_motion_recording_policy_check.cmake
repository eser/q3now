function(require_text source needle why)
	string(FIND "${${source}}" "${needle}" pos)
	if(pos EQUAL -1)
		message(FATAL_ERROR "A2c3 policy missing ${why}: ${needle}")
	endif()
endfunction()
function(forbid_text source needle why)
	string(FIND "${${source}}" "${needle}" pos)
	if(NOT pos EQUAL -1)
		message(FATAL_ERROR "A2c3 policy forbidden ${why}: ${needle}")
	endif()
endfunction()

# Full authority and fail-atomic non-consuming generation preflight.
foreach(field IN ITEMS token frameId worldIndex width height topologyEpoch planGeneration

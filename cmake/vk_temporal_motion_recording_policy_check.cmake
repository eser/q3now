# Product order: Begin before acquire; actual pipeline one-shot; Append before
# infallible mapped entMat copies and slot publication.
string(FIND "${VKC}" "void vk_begin_frame(" frame_pos)
string(SUBSTRING "${VKC}" ${frame_pos} 65000 FRAME)
string(FIND "${FRAME}" "VK_TemporalMotionRecordingBegin(" begin_pos)
string(FIND "${FRAME}" "Ral_AcquireNextImage" acquire_pos)
if(begin_pos LESS 0 OR acquire_pos LESS begin_pos)
	message(FATAL_ERROR "A2c3 policy: recording Begin must precede acquire")
endif()
require_text(VKC "vk_temporal_bound_pipeline_slot = pipeline;\n\tralpipe = vk_gen_pipeline( pipeline );" "actual final pipeline one-shot author")
require_text(VKC "const uint32_t temporalPipelineSlot = vk_temporal_bound_pipeline_slot;" "draw consumes one-shot")
require_text(VKC "vk_temporal_bound_pipeline_slot = UINT32_MAX;" "draw clears one-shot")
string(FIND "${VKC}" "void vk_draw_geometry(" draw_function_pos)
string(SUBSTRING "${VKC}" ${draw_function_pos} 12000 DRAW_BODY)
string(FIND "${DRAW_BODY}" "if ( temporalPrepared && !VK_TemporalMotionRecordingConsumeAt(" append_pos)
string(FIND "${DRAW_BODY}" "memcpy( dst, item->mvp, 64 );" copy_pos)
string(FIND "${DRAW_BODY}" "vk_entmat_publish_shadow_range(" publish_pos)
string(FIND "${DRAW_BODY}" "vk.cmd->entMatSlot = slot + 1;" increment_pos)
string(FIND "${DRAW_BODY}" "vk_issue_geometry_draws( indexed, firstInstance );" draw_pos)
if(append_pos LESS 0 OR copy_pos LESS append_pos OR publish_pos LESS copy_pos
		OR increment_pos LESS publish_pos
		OR draw_pos LESS increment_pos)
	message(FATAL_ERROR "A2c3 policy: prevalidated append < entMat copy < CPU-shadow publish < slot++ < ordinary draw order drift")
endif()


string(FIND "${BACKENDT}" "static const void *RB_StretchPic" transition_end)
if(transition_start EQUAL -1 OR transition_end LESS_EQUAL transition_start)
	message(FATAL_ERROR "cannot isolate RB_TransitionToUI")
endif()
math(EXPR transition_length "${transition_end} - ${transition_start}")
string(SUBSTRING "${BACKENDT}" ${transition_start} ${transition_length} transition_body)
string(FIND "${transition_body}" "vk_temporal_motion_seal_primary();" seal_pos)
string(FIND "${transition_body}" "vk_temporal_recursive_record();" recursive_pos)
string(FIND "${transition_body}" "if ( r_bloom->integer )" bloom_pos)
if(seal_pos EQUAL -1 OR recursive_pos LESS_EQUAL seal_pos
		OR bloom_pos LESS_EQUAL recursive_pos)
	message(FATAL_ERROR "UI path must seal then run the shared H4 transaction before bloom")
endif()

string(FIND "${VKT}" "void vk_temporal_recursive_record( void )" recursive_start)
string(FIND "${VKT}" "// SHADER_MODULE_BL macro retired." recursive_end)
if(recursive_start EQUAL -1 OR recursive_end LESS_EQUAL recursive_start)
	message(FATAL_ERROR "cannot isolate shared H4 recursive transaction")
endif()
math(EXPR recursive_length "${recursive_end} - ${recursive_start}")
string(SUBSTRING "${VKT}" ${recursive_start} ${recursive_length} recursive_body)
string(FIND "${recursive_body}" "vk_temporal_resolve_prepare_authority();" prepare_pos)
string(FIND "${recursive_body}" "vk_temporal_history_store_prepare()" history_pos)
string(FIND "${recursive_body}" "vk_temporal_resolve_record_or_copy();" producer_pos)
string(FIND "${recursive_body}" "vk_temporal_history_store_feedback(" feedback_pos)
if(prepare_pos EQUAL -1 OR history_pos LESS_EQUAL prepare_pos
		OR producer_pos LESS_EQUAL history_pos OR feedback_pos LESS_EQUAL producer_pos)
	message(FATAL_ERROR "shared H4 order must be authority -> Prepare -> Producer -> Store")
endif()


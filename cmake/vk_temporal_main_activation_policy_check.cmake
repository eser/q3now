function(require_text haystack needle why)
	string(FIND "${haystack}" "${needle}" pos)
	if(pos EQUAL -1)
		message(FATAL_ERROR "missing ${why}: ${needle}")
	endif()
endfunction()
function(forbid_text haystack needle why)
	string(FIND "${haystack}" "${needle}" pos)
	if(NOT pos EQUAL -1)
		message(FATAL_ERROR "forbidden ${why}: ${needle}")
	endif()
endfunction()
function(require_count haystack needle expected why)
	string(LENGTH "${haystack}" before_len)
	string(REPLACE "${needle}" "" stripped "${haystack}")
	string(LENGTH "${stripped}" after_len)
	string(LENGTH "${needle}" needle_len)
	math(EXPR removed "${before_len} - ${after_len}")
	math(EXPR actual "${removed} / ${needle_len}")
	if(NOT actual EQUAL expected)
		message(FATAL_ERROR "${why}: expected ${expected}, got ${actual}")
	endif()
endfunction()


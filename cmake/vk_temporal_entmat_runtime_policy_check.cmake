function(require_text text needle why)
	string(FIND "${${text}}" "${needle}" pos)
	if(pos EQUAL -1)
		message(FATAL_ERROR "A2a policy missing ${why}: ${needle}")
	endif()
endfunction()
function(forbid_text text needle why)
	string(FIND "${${text}}" "${needle}" pos)
	if(NOT pos EQUAL -1)
		message(FATAL_ERROR "A2a policy forbidden ${why}: ${needle}")
	endif()
endfunction()
function(require_count text needle expected why)
	string(REGEX MATCHALL "${needle}" hits "${${text}}")
	list(LENGTH hits count)
	if(NOT count EQUAL expected)
		message(FATAL_ERROR "A2a policy ${why}: expected ${expected}, got ${count}")
	endif()
endfunction()


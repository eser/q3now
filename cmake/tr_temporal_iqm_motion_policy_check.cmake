if(publish_pos EQUAL -1 OR finish_pos EQUAL -1 OR finish_pos LESS publish_pos)
	message(FATAL_ERROR "cannot isolate R_LoadIQM publication tail")
endif()
math(EXPR tail_len "${finish_pos} - ${publish_pos}")
string(SUBSTRING "${LOADER}" ${publish_pos} ${tail_len} PUBLISHED_TAIL)
forbid_text(PUBLISHED_TAIL "return qfalse" "fallible exit after model publication")


file(GLOB RENDERER_PRODUCT_C "${ROOT}/code/renderervk/*.c")
foreach(product_file IN LISTS RENDERER_PRODUCT_C)
	if(product_file STREQUAL "${ROOT}/code/renderervk/vk_temporal_iqm_geometry.c")
		continue()
	endif()
	file(READ "${product_file}" product_source)
	if(product_file STREQUAL "${ROOT}/code/renderervk/vk.c")
		foreach(api IN ITEMS VK_TemporalIqmGeometryEnsureAfterIdle
			VK_TemporalIqmGeometryGetReceipt VK_TemporalIqmGeometryReleaseAfterIdle)
			string(REGEX MATCHALL "${api}[(]" bridge_calls "${product_source}")
			list(LENGTH bridge_calls bridge_count)
			if(NOT bridge_count EQUAL 1)
				message(FATAL_ERROR "geometry product bridge inventory drifted ${api}: ${bridge_count}")
			endif()
		endforeach()
		foreach(needle IN ITEMS
			"return Ral_AdoptBuffer( backend, native, bytes, debugName );"
			"ops.destroy = Ral_DestroyBuffer;"
			"Ral_GetBufferHandle( candidate ) == native"
			"Ral_GetBufferSize( candidate ) == (uint64_t)bytes"
			"if ( !wasLive && vk_temporal_iqm_geometry_live_count == UINT32_MAX )")
			require_text(VK "${needle}" "direct geometry product bridge")
		endforeach()
		string(FIND "${VK}" "static ralBuffer_t *vk_temporal_iqm_geometry_adopt" bridge_begin)
		string(FIND "${VK}" "#include \"shaders/spirv/shader_data.c\"" bridge_end)
		if(bridge_begin EQUAL -1 OR bridge_end EQUAL -1 OR NOT bridge_begin LESS bridge_end)
			message(FATAL_ERROR "cannot isolate direct geometry product bridge")
		endif()
		math(EXPR bridge_len "${bridge_end}-${bridge_begin}")
		string(SUBSTRING "${VK}" ${bridge_begin} ${bridge_len} GEOMETRY_BRIDGE)
		forbid_text(GEOMETRY_BRIDGE "vk_ral_lookup_buffer" "shadow geometry adoption")
		continue()
	endif()
	foreach(api IN ITEMS VK_TemporalIqmGeometryEnsureAfterIdle
		VK_TemporalIqmGeometryGetReceipt VK_TemporalIqmGeometryReleaseAfterIdle)
		string(FIND "${product_source}" "${api}(" product_call)
		if(NOT product_call EQUAL -1)
			message(FATAL_ERROR "premature geometry product caller ${api} in ${product_file}")
		endif()
	endforeach()
endforeach()

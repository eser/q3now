function(require_text haystack needle label)
	string(FIND "${${haystack}}" "${needle}" pos)
	if(pos EQUAL -1)
		message(FATAL_ERROR "missing ${label}: ${needle}")
	endif()
endfunction()
function(forbid_text haystack needle label)
	string(FIND "${${haystack}}" "${needle}" pos)
	if(NOT pos EQUAL -1)
		message(FATAL_ERROR "forbidden ${label}: ${needle}")
	endif()
endfunction()


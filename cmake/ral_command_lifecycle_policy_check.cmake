string(REGEX MATCHALL "vk_create_binary_semaphore[(]" BINARY_SEMAPHORE_CALLS "${RENDERER}")
list(LENGTH BINARY_SEMAPHORE_CALLS BINARY_SEMAPHORE_CALL_COUNT)
if(NOT BINARY_SEMAPHORE_CALL_COUNT EQUAL 5)
	message(FATAL_ERROR "renderer binary semaphore owner inventory drifted: ${BINARY_SEMAPHORE_CALL_COUNT}/5")
endif()
string(FIND "${RENDERER}" "static ralSemaphore_t *vk_create_binary_semaphore(" BINARY_HELPER_BEGIN)
string(FIND "${RENDERER}" "static void vk_apply_hdr_metadata" BINARY_HELPER_END)
if(BINARY_HELPER_BEGIN EQUAL -1 OR BINARY_HELPER_END EQUAL -1 OR NOT BINARY_HELPER_BEGIN LESS BINARY_HELPER_END)
	message(FATAL_ERROR "renderer binary semaphore helper span is malformed")
endif()
math(EXPR BINARY_HELPER_LENGTH "${BINARY_HELPER_END} - ${BINARY_HELPER_BEGIN}")
string(SUBSTRING "${RENDERER}" ${BINARY_HELPER_BEGIN} ${BINARY_HELPER_LENGTH} BINARY_HELPER)
string(FIND "${BINARY_HELPER}" "owner = Ral_CreateSemaphore" BINARY_CREATE_POS)
string(FIND "${BINARY_HELPER}" "identity = Ral_GetSemaphoreHandle" BINARY_GET_POS)

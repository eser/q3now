if(BINARY_CREATE_POS EQUAL -1 OR BINARY_GET_POS EQUAL -1 OR BINARY_PUBLISH_POS EQUAL -1
		OR NOT BINARY_CREATE_POS LESS BINARY_GET_POS OR NOT BINARY_GET_POS LESS BINARY_PUBLISH_POS)
	message(FATAL_ERROR "renderer binary semaphore create/get/publish order drifted")
endif()

*.dmg
*.tar.gz
*.zip

# Documentation (except README)
docs/
*.md
!README.md
!THIRD_PARTY_LICENSES.md

# CI/CD
.github/

# macOS/Linux packaging support files
misc/

# Launcher (not needed for headless server)
launcher/

